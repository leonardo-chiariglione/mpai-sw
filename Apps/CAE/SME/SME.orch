# =============================================================================
#  SME.orch - Speak Model with Emotion (CAE-USC V2.5)
#  Workflow Description Language, AIF V3.0
#
#  One Controller, one Module, which executes by exchange. Emotionless speech takes
#  the emotion of a MODEL UTTERANCE by its prosody: Speech Feature Analysis 1 extracts
#  the prosodic features of the model utterance (the Mode Selector says the prosodic
#  pathway), and Prosodic Emotion Insertion applies them to the emotionless speech.
#
#  The same workflow for the stand-alone App and for the MAS App: the person gives
#  the emotionless speech and the model utterance (each from the microphone, or a WAV
#  file; the model also one of four ready-made sentences, by their address); the
#  alternatives of one datum share its label, so whichever comes first is offered. The Mode Selector is the App's, written here as an instance of its Data Type
#  (AIF V3.0, Workflow Description, 3).
# =============================================================================

workflow SME over 1CAE-SME-V2.5-I01

on Start:

    ask Controller to start

    prompt "Speak Model with Emotion gives speech that has no emotion the emotion of another sentence, the model. Say a sentence in a flat voice, then give the model, a sentence spoken with a clear emotion, and you will hear your sentence again, with the emotion of the model."

    loop until Stop:

        # --- the emotionless speech: from the microphone, or a WAV file ---
        prompt "Say a sentence in a flat voice, without emotion, or choose a WAV file."
        acquire Speech (OSD-BSO-V1.5) via VAD
             or Speech (OSD-BSO-V1.5) = { "BasicSpeechDataQualifier": { "Formats": { "TransportFormats": { "FileFormat": "WAV" } } } }

        # --- the model utterance: from the microphone, a WAV file, or one of four ready-made sentences (CREMA-D, actor 1074, "It's eleven o'clock",
        #     High; Test/Data/Speech/CREMA-D/README.md says where they come from and under which licence) ---
        prompt "Now the model: say a sentence with a clear emotion, choose a WAV file, or pick one of my examples: enraged, sad, happy or fearful."
        acquire Model (OSD-BSO-V1.5) via VAD
             or Model (OSD-BSO-V1.5) = { "BasicSpeechDataQualifier": { "Formats": { "TransportFormats": { "FileFormat": "WAV" } } } }
             or Model (OSD-BSO-V1.5) = { "BasicSpeechObjectID": "Enraged", "BasicSpeechObjectData": [ { "DataURI": "https://media.githubusercontent.com/media/CheyneyComputerScience/CREMA-D/master/AudioWAV/1074_IEO_ANG_HI.wav" } ] }
             or Model (OSD-BSO-V1.5) = { "BasicSpeechObjectID": "Sad", "BasicSpeechObjectData": [ { "DataURI": "https://media.githubusercontent.com/media/CheyneyComputerScience/CREMA-D/master/AudioWAV/1074_IEO_SAD_HI.wav" } ] }
             or Model (OSD-BSO-V1.5) = { "BasicSpeechObjectID": "Happy", "BasicSpeechObjectData": [ { "DataURI": "https://media.githubusercontent.com/media/CheyneyComputerScience/CREMA-D/master/AudioWAV/1074_IEO_HAP_HI.wav" } ] }
             or Model (OSD-BSO-V1.5) = { "BasicSpeechObjectID": "Fearful", "BasicSpeechObjectData": [ { "DataURI": "https://media.githubusercontent.com/media/CheyneyComputerScience/CREMA-D/master/AudioWAV/1074_IEO_FEA_HI.wav" } ] }

        # --- the Module is given the App's pathway, the model and the speech ---
        offer ModeSelector (OSD-SEL-V1.5:1) = { "Header": "OSD-SEL-V1.5", "SelectorID": "prosodic" }
        offer Model (OSD-BSO-V1.5:1)
        offer Speech (OSD-BSO-V1.5:2)

        # --- and gives the speech with the emotion of the model, which is played ---
        ask     Result (OSD-BSO-V1.5)
        prompt "Here is your sentence, with the emotion of the model."
        present Result

on Stop:
    ask Controller to stop
