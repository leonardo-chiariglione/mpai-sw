# =============================================================================
#  AES.orch - Add Emotion to Speech (CAE-USC V2.5)
#  Workflow Description Language, AIF V3.0
#
#  One Controller, one Module, which executes by exchange. Emotionless speech is
#  given an emotion that is NAMED: Speech Feature Analysis 2 extracts the features of
#  the emotionless speech (the Mode Selector says the neural pathway), Emotion Feature
#  Production makes from them, from the Emotion List and in the Language Selector's
#  language, the neural speech features of the emotion, and Neural Emotion Insertion
#  gives them to the emotionless speech.
#
#  The same workflow for the stand-alone App and for the MAS App: the person gives
#  the speech (the microphone, or a WAV file) and the emotion with its degree (a list
#  and a slider); the Mode Selector and the Language Selector are the App's, written
#  here as instances of their Data Type (AIF V3.0, Workflow Description, 3).
# =============================================================================

workflow AES over 1CAE-AES-V2.5-I01

on Start:

    ask Controller to start

    prompt "Add Emotion to Speech gives an emotion to speech that has none. Say a sentence in a flat voice, then choose an emotion and how strong it should be, and you will hear your sentence again, with that emotion."

    loop until Stop:

        # --- the emotionless speech: from the microphone, or a WAV file ---
        prompt "Say a sentence in a flat voice, without emotion, or choose a WAV file."
        acquire Speech (OSD-BSO-V1.5) via VAD
             or SpeechFile (OSD-BSO-V1.5) = { "BasicSpeechDataQualifier": { "Formats": { "TransportFormats": { "FileFormat": "WAV" } } } }

        # --- the emotion and its degree: a list and a slider ---
        prompt "Now choose the emotion and how strong it should be."
        acquire Emotion (MMC-EEM-V2.5)

        # --- the Module is given the App's pathway and language, the emotion and the speech twice: for its features and to receive them ---
        offer ModeSelector (OSD-SEL-V1.5:1) = { "Header": "OSD-SEL-V1.5", "SelectorID": "neural" }
        offer Language (OSD-SEL-V1.5:2) = { "Header": "OSD-SEL-V1.5", "Language": { "InputLanguage": "en", "OutputLanguage": "en" } }
        offer Emotion (MMC-EEM-V2.5:1)
        branch on SpeechFile {
            offer SpeechFile (OSD-BSO-V1.5:1)
            offer SpeechFile (OSD-BSO-V1.5:2)
        } else {
            offer Speech (OSD-BSO-V1.5:1)
            offer Speech (OSD-BSO-V1.5:2)
        }

        # --- and gives the speech with the emotion, which is played ---
        ask     Result (OSD-BSO-V1.5)
        prompt "Here is your sentence, with the emotion."
        present Result

on Stop:
    ask Controller to stop
