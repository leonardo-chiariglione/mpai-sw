# =============================================================================
#  MMC-MQA.orch - MPAI Multimodal Question Answering (MMC-MQA-V2.5)
#  Workflow Description Language v0.3, AIF V3.0
#
#  One Controller, one Module. The User Agent offers the Controller data
#  identified by Data Type and Port Number, and asks for data identified the
#  same way. It names no AIM.
#
#  The Module is Multimodal Question Answering (MMC-MQA): it takes the picture
#  of an object, a question about it - spoken, or typed - and the ID of the
#  machine that answers. Visual Instance Identification says what the object
#  is, Natural Language Understanding and Question Analysis what is asked, and
#  Answer to Question gives the answer, as the machine's Portable Avatar. The
#  Portable Avatar carries the answer as text (the Module has no Text-To-Speech):
#  the User Agent has it said with its machine voice.
#
#  An App of its own (the author, 2026-11-24): not CPS, not AMQ.
#
#  A step completes before the next begins.
# =============================================================================

workflow MMC-MQA over 1MMC-MQA-V2.5-I01

on Start:

    ask Controller to start

    # --- first she asks whether the person wants to ask about a picture (the answer is spoken or typed) ---

    prompt "Do you want to ask a question about an object in a picture?"
    acquire Wanted (OSD-BTO-V1.5) = { "TextQualifier": { "Attributes": { "TextRole": "YesNo" } } }

    branch on Wanted contains "yes" {

        loop until Stop:

            # --- the picture the person chooses: the image folder opens, and the picture is shown on the stage ---

            prompt "Please select a picture."
            acquire Picture (OSD-BVO-V1.5) = { "VisualQualifier": { "Formats": { "Content": { "2D": { "Static": "JPEG" } } } } }
            present Picture

            # --- the question, spoken or typed, whichever comes first ---

            acquire UserQuestion (OSD-BSO-V1.5) via VAD
                 or TypedQuestion (OSD-BTO-V1.5)

            # --- the Module is given the picture, the question and the machine's ID ---

            offer Picture (OSD-BVO-V1.5)
            branch on TypedQuestion {
                offer TypedQuestion (OSD-BTO-V1.5)
            } else {
                offer UserQuestion (OSD-BSO-V1.5)
            }
            offer MachineID (string:1) = "MPAI as a Service"

            # --- and gives the answer, as the machine's Portable Avatar, with its text; the User Agent renders it and says it ---

            ask   MachinePortableAvatar (PAF-PAV-V1.6)
            present MachinePortableAvatar

            # --- another picture? yes: she asks to select it; else she says so and the App ends ---

            prompt "Do you want to ask a question about another picture?"
            acquire Another (OSD-BTO-V1.5) = { "TextQualifier": { "Attributes": { "TextRole": "YesNo" } } }

            branch on Another contains "yes" {
                wait 1s
            } else {
                prompt "Maybe another time."
                end
            }

    } else {

        prompt "Maybe another time."

    }
on Stop:
    ask Controller to stop