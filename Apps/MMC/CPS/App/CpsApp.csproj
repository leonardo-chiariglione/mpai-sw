<Project Sdk="Microsoft.NET.Sdk">

  <!-- Conversation with Personal Status, the App: it is a User Agent: it runs MMC-CPS.orch and asks the Controller (CpsController, a program of its own) to start the Module. It takes the face of the person
       from the Camera Unit and what the person says from the Microphone Unit of the Physical Layer (or from files, or typed), and writes the Portable Avatar that answers each turn. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CpsApp</AssemblyName>
    <RootNamespace>Mpai.Mmc.Cps.App</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <!-- the Controller API of a Controller that is a program of its own (CpsController) -->
    <ProjectReference Include="..\..\..\..\AIF\UserAgent\Remote\Mpai.Mas.Client.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\UserAgent\Ua\Mpai.Ua.csproj" />
    <!-- the Units of the Physical Layer: the Camera Unit and the Microphone Unit -->
    <ProjectReference Include="..\..\..\..\AIF\UserAgent\PhysicalLayer\Mpai.PhysicalLayer.csproj" />
  </ItemGroup>

</Project>
