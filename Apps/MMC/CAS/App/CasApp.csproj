<Project Sdk="Microsoft.NET.Sdk">

  <!-- Conversation About a Scene, the App: it is a User Agent. It runs MMC-CAS.orch and asks the Controller (CasController, a program of its own) to start the Module. It takes the scene from the
       Camera Unit and what the person says about it from the Microphone Unit of the Physical Layer (or from files), and writes the Portable Avatar that answers each turn. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CasApp</AssemblyName>
    <RootNamespace>Mpai.Mmc.Cas.App</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- the machine's voice, shared with Conversation with Personal Status -->
    <Compile Include="..\..\CPS\App\MachineVoice.cs" Link="MachineVoice.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <!-- the Controller API of a Controller that is a program of its own (CasController) -->
    <ProjectReference Include="..\..\..\..\AIF\UserAgent\Remote\Mpai.Mas.Client.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\UserAgent\Ua\Mpai.Ua.csproj" />
    <!-- the Units of the Physical Layer: the Camera Unit and the Microphone Unit -->
    <ProjectReference Include="..\..\..\..\AIF\UserAgent\PhysicalLayer\Mpai.PhysicalLayer.csproj" />
  </ItemGroup>

</Project>
