<Project Sdk="Microsoft.NET.Sdk">

  <!-- TmaController - THE CONTROLLER of Television Media Analysis, a program of its own. The App is a User Agent: it reads its workflow and the workflow asks this Controller, through the
       Controller API, to start the Module (1OSD-TMA-V1.5-I01); this Controller starts the Module and its AIMs as the L3 says. The Controller API is carried over the routes of Mpai.Mas.Server,
       on the loopback. -->

  <PropertyGroup>
    <AssemblyName>TmaController</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Mpai.Osd.Tma.Controller</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\..\MAS\Service\src\ControllerApiRunner.cs" Link="ControllerApiRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\AIF\Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\..\Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\Communication\GlobalStorage\AIF.GlobalStorage.csproj" />
    <ProjectReference Include="..\..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\ControllerApi\Mpai.Aif.Api.csproj" />
    <ProjectReference Include="..\..\..\..\AIF\PortData\Mpai.Aif.PortData.csproj" />
    <ProjectReference Include="..\..\..\MAS\Server\Mpai.Mas.Server.csproj" />
    <ProjectReference Include="..\Provider\Mpai.Osd.Tma.Provider.csproj" />
  </ItemGroup>

</Project>
