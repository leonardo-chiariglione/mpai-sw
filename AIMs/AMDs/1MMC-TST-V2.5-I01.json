                           {"Name": "RecognisedText",  "DataType": "OSD-TXO-V1.5"},
                           {"Name": "TranslatedText",  "DataType": "OSD-TXO-V1.5"},
                           {"Name": "TranslatedSpeech","DataType": "OSD-SPO-V1.5"}],

