                           {"Name": "InputText",        "Direction": "Input",  "DataType": "OSD-TXO-V1.5",                  "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "LanguageSelector", "Direction": "Input",  "DataType": "OSD-SEL-V1.5", "PortNumber": 1,                     "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "MediaSelector",    "Direction": "Input",  "DataType": "OSD-SEL-V1.5", "PortNumber": 2, "IsOptional": true, "Technology": "Software", "Protocol": "", "IsRemote": false},
