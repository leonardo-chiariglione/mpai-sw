<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Rsr.Host</AssemblyName>
    <RootNamespace>Rsr.Host</RootNamespace>
  </PropertyGroup>
  <!-- Audio DEVICES are Windows-specific (winmm), like CAV-MAC: net10.0-windows on
       Windows with WINDOWS_DEVICES, plain net10.0 elsewhere. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);WINDOWS_DEVICES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Framework -->
    <ProjectReference Include="..\..\..\AIF\V3.0\src\AIF.Controller\AIF.Controller.csproj" />
    <ProjectReference Include="..\..\..\AIF\V3.0\src\AIF.Store\AIF.Store.csproj" />
    <ProjectReference Include="..\..\Core\Mpai.Core.csproj" />
    <!-- Personal Status De-multiplexing -->
    <ProjectReference Include="..\..\PAF\V1.6\PSD\Mpai.Paf.Psd.csproj" />
    <!-- Spoken response: MMC-TTS + SOD (delivery) + audio device -->
    <ProjectReference Include="..\..\MMC\V2.5\TTS\Mpai.Mmc.Tts.csproj" />
    <ProjectReference Include="..\..\MMC\V2.5\SOD\Mpai.Mmc.Sod.csproj" />
    <ProjectReference Include="..\..\CAE3\V1.0\AOD\Mpai.Cae.Aod.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\..\CAE3\V1.0\AOD.Windows\Mpai.Cae.Aod.Windows.csproj" />
  </ItemGroup>
</Project>
