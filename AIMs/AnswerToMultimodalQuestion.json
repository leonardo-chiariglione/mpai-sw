{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$comment":             "https://schemas.mpai.community/AIF/V3.0/AIMMetadata.json",
  "$id":                  "https://schemas.mpai.community/MMC/V2.5/AIMs/AnswerToMultimodalQuestion.json",
  "title":                "Answer to Multimodal Question V2.5",

  "Identifier":           {"ImplementerID": "/* String assigned by IIDRA */", "AIM": {"const": "MMC-AMQ-V2.5"}},

  "APIProfile":           "Basic",
  "Description":          "This AIM receives a question as Text or Speech and an Image and produces Text and/or Speech in response.",

  "Types":                [{"Name": "TextObject_t",  "Type": "uint8[]"},
                           {"Name": "VisualObject_t","Type": "uint8[]"},
                           {"Name": "SpeechObject_t","Type": "uint8[]"}],

  "Ports":                [{"Name": "TextObject",   "Direction": "InputOutput", "RecordType": "TextObject_t",  "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "VisualObject",  "Direction": "InputOutput", "RecordType": "VisualObject_t","Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "SpeechObject",  "Direction": "InputOutput", "RecordType": "SpeechObject_t","Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "MachineText",   "Direction": "OutputInput", "RecordType": "TextObject_t",  "Technology": "Software", "Protocol": "", "IsRemote": false},
                           {"Name": "MachineSpeech", "Direction": "OutputInput", "RecordType": "SpeechObject_t","Technology": "Software", "Protocol": "", "IsRemote": false}],

  "SubAIMs":              [{"Name": "/* SubAIM name */",
                             "Identifier": {"ImplementerID": "/* String assigned by IIDRA */",
                                            "AIM": {"const": "/* ACR-V#.# */"}}},
                           {"Name": "AutomaticSpeechRecognition",
                             "Identifier": {"ImplementerID": "/* String assigned by IIDRA */",
                                            "AIM": {"const": "MMC-ASR-V2.5"}}},
                           {"Name": "TextAndImageQuery",
                             "Identifier": {"ImplementerID": "/* String assigned by IIDRA */",
                                            "AIM": {"const": "MMC-TIQ-V2.5"}}},
                           {"Name": "TextToSpeech",
                             "Identifier": {"ImplementerID": "/* String assigned by IIDRA */",
                                            "AIM": {"const": "MMC-TTS-V2.5"}}}],

  "Topology":             [{"Output": {"AIMName": "/* AIMName or empty string for this AIM */", "PortName": "/* PortName */"},
                             "Input":  {"AIMName": "/* AIMName or empty string for this AIM */", "PortName": "/* PortName */"}},
                           {"Output": {"AIMName": "",                           "PortName": "SpeechObject"},     "Input": {"AIMName": "AutomaticSpeechRecognition", "PortName": "SpeechObject"}},
                           {"Output": {"AIMName": "AutomaticSpeechRecognition", "PortName": "RecognisedText"},   "Input": {"AIMName": "TextAndImageQuery",          "PortName": "TextObject"}},
                           {"Output": {"AIMName": "",                           "PortName": "TextObject"},       "Input": {"AIMName": "TextAndImageQuery",          "PortName": "TextObject"}},
                           {"Output": {"AIMName": "",                           "PortName": "VisualObject"},     "Input": {"AIMName": "TextAndImageQuery",          "PortName": "VisualObject"}},
                           {"Output": {"AIMName": "TextAndImageQuery",          "PortName": "MachineText"},      "Input": {"AIMName": "TextToSpeech",               "PortName": "MachineText"}},
                           {"Output": {"AIMName": "TextAndImageQuery",          "PortName": "MachineText"},      "Input": {"AIMName": "",                           "PortName": "MachineText"}},
                           {"Output": {"AIMName": "TextToSpeech",               "PortName": "MachineSpeech"},    "Input": {"AIMName": "",                           "PortName": "MachineSpeech"}}],

  "Implementations":      [{"BinaryName":      "/* BinaryName */",
                             "Architecture":    "/* x86 | x86-64 | ARM | ARM64 | MIPS | RISC-V */",
                             "OperatingSystem": "/* Windows | Linux | MacOS | Debian | Ubuntu | RedHat | Android | Zephyr | RTOS | Oniro | iOS */",
                             "Version":         "/* Version */",
                             "Source":          "/* AIMStorage | MPAIStore | AIMURL */",
                             "Destination":     "/* Destination URI */"}],

  "ResourcePolicies":     [{"Name": "Memory",              "Minimum": "/* bytes */",                                                                                                                                        "Maximum": "/* bytes */",                                                                                                                                        "Request": "/* bytes */"},
                           {"Name": "CPU:Number",          "Minimum": "/* integer, 0=all */",                                                                                                                               "Maximum": "/* integer, 0=all */",                                                                                                                               "Request": "/* integer, 0=all */"},
                           {"Name": "CPU:Class",           "Minimum": "/* Low | Medium | High */",                                                                                                                          "Maximum": "/* Low | Medium | High */",                                                                                                                          "Request": "/* Low | Medium | High */"},
                           {"Name": "GPU:Number",          "Minimum": "/* integer, 0=all */",                                                                                                                               "Maximum": "/* integer, 0=all */",                                                                                                                               "Request": "/* integer, 0=all */"},
                           {"Name": "GPU:CUDA:Class",      "Minimum": "/* SM10|SM11|SM12|SM13|SM20|SM21|SM30|SM32|SM35|SM37|SM50|SM52|SM53|SM60|SM61|SM62|SM70|SM72|SM75|SM80|SM86|SM87|SM90 */",                         "Maximum": "/* SM10|SM11|SM12|SM13|SM20|SM21|SM30|SM32|SM35|SM37|SM50|SM52|SM53|SM60|SM61|SM62|SM70|SM72|SM75|SM80|SM86|SM87|SM90 */",                         "Request": "/* SM10|SM11|SM12|SM13|SM20|SM21|SM30|SM32|SM35|SM37|SM50|SM52|SM53|SM60|SM61|SM62|SM70|SM72|SM75|SM80|SM86|SM87|SM90 */"},
                           {"Name": "GPU:CUDA:FrameBuffer","Minimum": "/* float_GB_GDDR|GDDR2|GDDR3|GDDR4|GDDR5|GDDR5X|GDDR6|GDDR6X */",                                                                                  "Maximum": "/* float_GB_GDDR|GDDR2|GDDR3|GDDR4|GDDR5|GDDR5X|GDDR6|GDDR6X */",                                                                                  "Request": "/* float_GB_GDDR|GDDR2|GDDR3|GDDR4|GDDR5|GDDR5X|GDDR6|GDDR6X */"},
                           {"Name": "GPU:CUDA:MemorySpeed","Minimum": "/* float_GHz */",                                                                                                                                    "Maximum": "/* float_GHz */",                                                                                                                                    "Request": "/* float_GHz */"}],

  "Documentation":        [{"Type": "Tutorial", "URI": "https://mpai.community/standards/mpai-mmc/"}]}
