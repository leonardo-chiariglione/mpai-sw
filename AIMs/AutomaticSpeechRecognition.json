                    { "Name": "SpeechObject_t",        "Type": "uint8[]" },
                    { "Name": "InstanceID_t",          "Type": "{string InstanceLabel; float32 LabelConfidenceLevel; string Taxonomy; float32 TaxonomyConfidenceLevel}" },
                    { "Name": "SpeechOverlap_t",       "Type": "uint8[]" },
