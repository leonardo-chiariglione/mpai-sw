                    { "Name": "RecognisedText",      "Direction": "OutputInput", "RecordType": "TextSegment_t",     "Technology": "Software", "Protocol": "", "IsRemote": false },
                    { "Name": "SpeechDescriptors",   "Direction": "OutputInput", "RecordType": "SpeechDescriptors_t","Technology": "Software", "Protocol": "", "IsRemote": false } ],

