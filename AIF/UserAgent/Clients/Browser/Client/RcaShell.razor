@* THE SHELL. The avatar, what she asks, the App list, the text box with its
   Enter, and Stop - the same things the desktop RCA shows. *@

<div class="rca">
  <header>
    <span class="title">MPAI as a Service</span>
    <span class="service">@AppTitle</span>
  </header>

  <main>
    <iframe id="avatar" src="avatar/cav-webview.html" allow="autoplay"></iframe>

    @if (showApps && !classicList)
    {
      <Desk Apps="apps" OnOpen="ChooseApp" />
    }
    else if (showApps)
    {
      <aside class="apps">
        <h2>Apps</h2>
        @if (appPage is null)
        {
          @* FINDING AN APP: words, a category, or both. Enter searches. *@
          <div class="find">
            <input placeholder="Search Apps" @bind="searchWords" @bind:event="oninput" @onkeydown="OnSearchKey" />
            <select @onchange="OnCategory">
              <option value="">All categories</option>
              @foreach (var c in categories) { <option value="@c">@c</option> }
            </select>
          </div>
          @foreach (var app in apps)
          {
            <button class="app" @onclick="() => ChooseApp(app.Id)">
              @if (app.IconPath is not null) { <img src="@app.IconPath" alt="" /> }
              <span class="name">@app.Name</span>
              <span class="desc">@app.Description</span>
            </button>
          }
        }
        else
        {
          @* AN APP'S PAGE: what it does, what it will ask for, what it keeps. *@
          <div class="page">
            <div class="name">@appPage.Name</div>
            <div class="desc">@appPage.Description</div>
            <div class="facts">@(PageFacts(appPage))</div>
            @if (appPage.Asks.Count > 0) { <div>It will ask for: @(string.Join(", ", appPage.Asks)).</div> }
            @if (appPage.Keeps.Length > 0) { <div>What it keeps: @(appPage.Keeps)</div> }
            <div class="actions"><button @onclick="OpenPage">Open</button> <button @onclick="ClosePage">Back</button></div>
          </div>
        }
      </aside>
    }

    @if (stageVideo is not null)
    {
      <aside class="stage video"><iframe id="stagevideo" src="@stageVideo" allowfullscreen allow="autoplay; encrypted-media; fullscreen" title="@stageTitle"></iframe><div>@stageTitle <button @onclick="FullScreenVideo">Full screen</button> <button @onclick="CloseVideo">Close the video</button></div></aside>
    }
    else if (stageImage is not null)
    {
      <aside class="stage"><img id="stageimg" src="@stageImage" alt="@stageTitle" @onclick="StageClicked" style="@(pointing is null ? "" : "cursor:crosshair")" /><div>@stageTitle</div></aside>
    }
  </main>

  @if (!string.IsNullOrEmpty(Shown))
  {
    <p class="shown">@Shown</p>
  }
  <p class="instruction">@Instruction</p>

  @if (choosingLanguages)
  {
    <div class="languages">
      <label>Input language
        <select @bind="langFrom">@foreach (var l in Languages) { <option value="@l.Code">@l.Name</option> }</select>
      </label>
      <label>Output language
        <select @bind="langTo">@foreach (var l in Languages) { <option value="@l.Code">@l.Name</option> }</select>
      </label>
      <button @onclick="LanguagesChosen">OK</button>
    </div>
  }

  @if (choosingPicture)
  {
    <div class="picture"><InputFile OnChange="PictureChosen" accept="image/*" /></div>
  }

  @if (choosingSpeechFile)
  {
    <div class="picture"><label>Or choose a WAV file: <InputFile OnChange="SpeechFileChosen" accept=".wav,audio/wav,audio/x-wav" /></label></div>
  }

  @if (speechExamples.Count > 0)
  {
    <div class="languages">Or one of these:
      @foreach (var e in speechExamples.ToList())
      {
        <button @onclick="() => PickExample(e.Pick)">@e.Label</button>
      }
    </div>
  }

  @if (choosingCompany)
  {
    <div class="company">
      <div class="languages">
        <span>A company:</span>
        @foreach (var c in companies) { <button @onclick="() => PickCompany(c.Name, c.File)">@c.Name</button> }
      </div>
      <div class="languages">
        <label>Or a file of your own: <InputFile OnChange="CompanyFileChosen" accept=".json,application/json" /></label>
        <label>Within <select @onchange="HorizonChosen"><option value="12" selected>12</option><option value="24">24</option><option value="36">36</option></select> months</label>
      </div>
      @if (companyProblem is not null) { <span class="problem">@companyProblem</span> }
      @if (company?.Company is not null)
      {
        <div class="whatif">
          <span>What if, for @company.Name:</span>
          @foreach (var (code, name) in Mpai.Ua.CompanyDevice.KeyFigures)
          {
            <label>@name <input type="range" min="-50" max="100" step="5" @bind="whatIf[code]" @bind:event="oninput" /> @(whatIf[code] > 0 ? "+" : "")@whatIf[code] %</label>
          }
          <button @onclick="ApplyWhatIf">Apply</button>
        </div>
      }
    </div>
  }

  @if (report is not null || previousReport is not null)
  {
    <div class="reports">
      @foreach (var (r, name) in new[] { (previousReport, previousName), (report, reportName) })
      {
        @if (r is not null)
        {
          <div class="report">
            <h3>@name</h3>
            <div class="gauge"><span>Default within the horizon</span><meter min="0" max="1" low="0.1" high="0.3" optimum="0" value="@(r.Default ?? 0)"></meter><b>@Pct(r.Default)</b></div>
            <ul>@foreach (var (what, weight) in r.DefaultWeights.Take(5)) { <li><span class="bar" style="width:@(Math.Max(2, weight * 2))px"></span>@what @weight.ToString("0") %</li> }</ul>
            <div class="gauge"><span>Organisation adds</span><b>@Pct(r.Organisation)</b></div>
            <ul>@foreach (var (what, weight) in r.OrganisationWeights.Take(3)) { <li><span class="bar" style="width:@(Math.Max(2, weight * 2))px"></span>@what @weight.ToString("0") %</li> }</ul>
            @foreach (var (risk, p, weights) in r.Discontinuity.Take(1))
            {
              <div class="gauge"><span>Discontinuity</span><meter min="0" max="1" low="0.1" high="0.3" optimum="0" value="@(p ?? 0)"></meter><b>@Pct(p)</b></div>
              <ul>@foreach (var (what, weight) in weights.Take(4)) { <li><span class="bar" style="width:@(Math.Max(2, weight * 2))px"></span>@what @weight.ToString("0") %</li> }</ul>
            }
            @if (r.Secondary is not null)
            {
              <div class="gauge"><span>With secondary risks</span><meter min="0" max="1" low="0.1" high="0.3" optimum="0" value="@r.Secondary"></meter><b>@Pct(r.Secondary)</b></div>
            }
          </div>
        }
      }
    </div>
    <p class="note">Demonstration model trained on Polish companies (CC BY 4.0), not for real companies.</p>
  }

  @if (choosingSections)
  {
    <div class="languages sections">
      <table>
        <tr><th>From (s)</th><th>To (s)</th><th>Words said there</th><th></th></tr>
        @foreach (var r in sectionRows.ToList())
        {
          <tr>
            <td><input type="number" step="0.01" min="0" style="width:6em" @bind="r.From" /></td>
            <td><input type="number" step="0.01" min="0" style="width:6em" @bind="r.To" /></td>
            <td><input type="text" style="width:16em" @bind="r.Words" /></td>
            <td><button @onclick="() => RemoveSection(r)">Remove</button></td>
          </tr>
        }
      </table>
      <button @onclick="AddSection">Add a section</button>
      <button @onclick="SectionsChosen">OK</button>
      @if (sectionProblem is not null) { <span class="problem">@sectionProblem</span> }
    </div>
  }

  @if (choosingEmotion)
  {
    <div class="languages">
      <label>Emotion
        <select @bind="emotionPick">@foreach (var e in Emotions) { <option value="@e.Category">@e.Name</option> }</select>
      </label>
      <label>How strong
        <input type="range" min="0" max="100" step="5" @bind="emotionDegree" @bind:event="oninput" /> @emotionDegree %
      </label>
      <button @onclick="EmotionChosen">OK</button>
    </div>
  }

  @if (lastSpeechWav is not null)
  {
    <div class="languages"><button @onclick="PlayAgain">Play again</button></div>
  }

  <div class="row">
    @if (!started)
    {
      <button class="start" @onclick="StartAsync">Start</button>
    }
    else
    {
      <button class="stop" disabled="@(!stopEnabled)" @onclick="StopClicked">Stop</button>
    }
    <textarea id="typed" rows="3" disabled="@(!typing)" @bind="typedText" @bind:event="oninput" @bind:after="OnTypedInput"
              @onkeydown="OnTypedKey"></textarea>
    <button class="enter" disabled="@(!typing)" @onclick="SendTyped">Enter</button>
  </div>

  <footer>@StatusLine</footer>
</div>
