<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TstUi.MainWindow"
        Width="980" Height="700"
        MinWidth="720" MinHeight="560"
        Title="MPAI Text and Speech Translation"
        FontFamily="Segoe UI">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="14">

    <!-- Languages -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,140,Auto,140,*" Margin="0,0,0,10">
      <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox  Grid.Column="1" x:Name="SourceLanguage" HorizontalAlignment="Stretch"/>
      <TextBlock Grid.Column="2" Text="Into" VerticalAlignment="Center" Margin="16,0,8,0"/>
      <ComboBox  Grid.Column="3" x:Name="TargetLanguage" HorizontalAlignment="Stretch"/>
      <TextBlock Grid.Column="4" x:Name="VoiceNote" VerticalAlignment="Center"
                 Margin="16,0,0,0" Foreground="#808080"/>
    </Grid>

    <!-- What to translate -->
    <TextBox Grid.Row="1" x:Name="InputBox" Height="72" AcceptsReturn="True"
             TextWrapping="Wrap" FontSize="15"
             Watermark="Type a sentence, or use Speak"/>

    <!-- Actions -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,10">
      <Button x:Name="TranslateButton" Content="Translate" Width="130" Height="34"/>
      <Button x:Name="SpeakButton"     Content="Speak"     Width="130" Height="34"/>
    </StackPanel>

    <!-- What was heard -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
      <TextBlock Grid.Row="0" Text="Heard" FontWeight="SemiBold" Foreground="#808080"/>
      <TextBox   Grid.Row="1" x:Name="HeardBox" IsReadOnly="True" FontSize="15"
                 Background="#F4F4F4" TextWrapping="Wrap"/>
    </Grid>

    <!-- The translation, large enough to read in any script -->
    <Grid Grid.Row="4" RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Text="Translation" FontWeight="SemiBold" Foreground="#808080"/>
      <Border Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
        <TextBox x:Name="OutputBox" IsReadOnly="True" FontSize="24"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 BorderThickness="0" Background="White"/>
      </Border>
    </Grid>

    <!-- What the AIMs are saying -->
    <Border Grid.Row="5" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4"
            Height="150" Margin="0,10,0,0">
      <ScrollViewer x:Name="LogScroller">
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 BorderThickness="0" Background="#F4F4F4"/>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="6" x:Name="StatusText" Margin="0,8,0,0" Foreground="#606060"/>
  </Grid>
</Window>