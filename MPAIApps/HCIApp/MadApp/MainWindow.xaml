<Window x:Class="MadApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MAD - Multimodal Anonymous Dialogue" Height="1120" Width="1120"
        Background="#141A24">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1E2632" Padding="12,10">
      <StackPanel>
        <TextBlock Text="Multimodal Anonymous Dialogue" Foreground="#EAF1FB" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Speak or type - the CAV listens, answers, and remembers the conversation." Foreground="#9FB0C6" FontSize="12" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#1E2632" Padding="10">
      <DockPanel>
        <Button x:Name="ListenButton" DockPanel.Dock="Left" Content="Listen" Width="90" Margin="0,0,8,0"
                Click="ListenButton_Click" FontSize="14"/>
        <Button x:Name="SayButton" DockPanel.Dock="Right" Content="Say" Width="90" Margin="8,0,0,0" IsDefault="True"
                Click="SayButton_Click" FontSize="14"/>
        <TextBox x:Name="InputBox" FontSize="14" VerticalContentAlignment="Center" Padding="8"
                />
      </DockPanel>
    </Border>
    <wv2:WebView2 x:Name="Web"/>
  </DockPanel>
</Window>
