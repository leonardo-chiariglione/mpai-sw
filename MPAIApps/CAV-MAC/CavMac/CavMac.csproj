    <ProjectReference Include="..\..\..\AIF\V3.0\src\AIF.GlobalStorage\AIF.GlobalStorage.csproj" />
    <ProjectReference Include="..\..\..\AIMs\Core\Mpai.Core.csproj" />
    <ProjectReference Include="..\..\..\AIMs\Gallery\Mpai.Gallery.csproj" />
    <!-- The Human-CAV Interaction avatar surface (WebView renderer + present) -->
    <ProjectReference Include="..\..\..\Lib\UaKit\Mpai.UaKit.csproj" />
    <!-- The HCI API - Announce (say a prompt as a Speaking Avatar via RSR) -->
