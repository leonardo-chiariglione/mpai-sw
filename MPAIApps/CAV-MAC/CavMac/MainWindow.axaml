<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CavMac.MainWindow"
        Width="900" Height="720"
        MinWidth="700" MinHeight="600"
        Title="CAV-MAC V2.0 - Multimodal Access Control"
        FontFamily="Segoe UI">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="18">

    <!-- Title -->
    <TextBlock Grid.Row="0" Text="Multimodal Access Control"
               FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <TextBlock Grid.Row="1" x:Name="InstructionText"
               Text="Press Authenticate to begin."
               FontSize="16" Foreground="#404040" Margin="0,0,0,14"/>

    <!-- Authenticate (the entry action) sits ABOVE the two capture steps -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
      <Button x:Name="AuthenticateButton" Content="Authenticate" Width="180" Height="44" FontSize="16" IsEnabled="False"/>
      <Border x:Name="ResultBorder" CornerRadius="6" Padding="16,10" VerticalAlignment="Center"
              Background="#F0F0F0" IsVisible="False">
        <TextBlock x:Name="ResultText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      </Border>
    </StackPanel>

    <!-- The two capture steps -->
    <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="0,0,0,12">
      <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Margin="0,0,7,0" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="1. Face" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock x:Name="FaceStatus" Text="waiting" Foreground="#808080"/>
          <Button x:Name="CaptureFaceButton" Content="Look at the camera - Capture"
                  Height="36" HorizontalAlignment="Stretch" IsEnabled="False"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Margin="7,0,0,0" Padding="12">
        <StackPanel Spacing="8">
          <TextBlock Text="2. Voice" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock x:Name="VoiceStatus" Text="waiting" Foreground="#808080"/>
          <Button x:Name="RecordButton" Content="Speak your passphrase"
                  Height="36" HorizontalAlignment="Stretch" IsEnabled="False"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Log -->
    <Border Grid.Row="4" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
      <ScrollViewer x:Name="LogScroller">
        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0" Background="#F7F7F7"/>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,8,0,0" Foreground="#606060"/>
  </Grid>
</Window>
