        <https://mpai.community/kg/aim/PAF-VCT-V1.6/flow/9> ;
    mkg:ofStandard standard:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-VCT-V1.6/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-VCT-V1.6/port/Input/OSD-BAO-V1.5/0>,
