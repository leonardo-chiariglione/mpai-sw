aim:PGM-VEM-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-VEM-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The Visual Enhancement Multiplexing (PGM-VEM) AIM is a Sub-AIM of Visual Scene Enhancement (PGM-VSE). It collects the outputs of all Sub-AIMs and assembles the Enhanced Visual Scene Descriptors and the multiplexed Visual CXT Response, Visual Domain Request, and Visual Interaction History Request. Each Sub-AIM of Visual Scene Enhancement independently generates a Visual CXT Response, a Visual Domain Request and a Visual Interaction History Request. Visual Enhancement Multiplexing multiplexes them into the corresponding external output signals of Visual Scene Enhancement. [High-level specificati" ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-VEM-V1.0/port/Input/OSD-AFT-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-VEM-V1.0/port/Input/OSD-BVS-V1.5/0>,
