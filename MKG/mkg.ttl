        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-cav/tec/v2-0/data-types/wheel-response/> .

datatype:CUI-PDD-V2.1 a mkg:DataType ;
    mkg:acronym "CUI-PDD-V2.1" ;
    mkg:description "" ;
