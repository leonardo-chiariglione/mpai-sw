        <https://mpai.community/kg/aim/OSD-MSE-V1.5/port/Input/OSD-AUO-V1.5/2>,
        <https://mpai.community/kg/aim/OSD-MSE-V1.5/port/Input/OSD-LSD-V1.5/1>,
        <https://mpai.community/kg/aim/OSD-MSE-V1.5/port/Input/OSD-LSD-V1.5/2>,
        <https://mpai.community/kg/aim/OSD-MSE-V1.5/port/Input/OSD-OMO-V1.5/1>,
