aim:AIH-NNM-V1.1 a mkg:AIM ;
    mkg:acronym "AIH-NNM-V1.1" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/AIH/V1.1/Nnm/NnmAimProcessor.cs> ;
    mkg:codePath "AIMs/AIH/V1.1/Nnm/NnmAimProcessor.cs" ;
    mkg:description "This AIM wraps a Neural Network Model and processes AIH Data with it: it takes AIH Data and gives the AIH Data resulting from the processing. The Neural Network Model learns as the AIM processes AIH Data. The AIM is what is exchanged: the Health Back End uploads it to the MPAI Store, the Health Front Ends download it, and a Health Front End returns it with the Neural Network Model trained; the AIM gives the Neural Network Model it holds for that. It may take a Neural Network Model to wrap or to update." ;
    mkg:ofStandard standard:AIH ;
    mkg:port <https://mpai.community/kg/aim/AIH-NNM-V1.1/port/Input/AIH-AHD-V1.1/0>,
        <https://mpai.community/kg/aim/AIH-NNM-V1.1/port/Input/AIP-MLO-V1.0/0>,
        <https://mpai.community/kg/aim/AIH-NNM-V1.1/port/Output/AIH-AHD-V1.1/0>,
        <https://mpai.community/kg/aim/AIH-NNM-V1.1/port/Output/AIP-MLO-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/AIH1/V1.1/AIMs/NeuralNetworkModel.json> ;
    mkg:sourceAI true ;
    mkg:title "Neural Network Model V1.1" ;
    mkg:webPage <https://mpai.community/standards/mpai-aih/hsp/v1-1/ai-modules/neural-network-model/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-aih/hsp/v1-1/> .

