aim:OSD-ACR-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-ACR-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Access Control Registration: Enrols a User: from the captured Face Object and Speech Object it produces the Face Descriptors (Entity Face Description) and Speech Descriptors (Entity Speech Description), which the descriptor AIMs write to the Shared Storage gallery under the User Name - the same gallery OSD-MAC reads to recognise. Response and Scene Rendering speaks the confirmation. The User Name is the User Agent's own datum (typed). Acquisition and delivery are the User Agent, not sub-AIMs. Where a data type occurs more than once at the boundary it carries a Port Number (OSD-STM: FaceTime 1 / SpeechTime 2; OSD-BTO: Response 1 / UserName 2)." ;
    mkg:flow <https://mpai.community/kg/aim/OSD-ACR-V1.5/flow/1>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/flow/2>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/flow/3>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/flow/4>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/flow/5>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/flow/6>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/flow/7>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/flow/8> ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-ACR-V1.5/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/port/Input/OSD-BTO-V1.5/2>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/OSD-ACR-V1.5/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/AccessControlRegistration.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-ESD-V2.5,
        aim:PAF-EFD-V1.6,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/access-control-registration/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-BSS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BSS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic Speech Scene Description: see https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-speech-scene-description/. The Basic Speech Scene Description (OSD-BSD) receives Speech Objects with their Space-Time information and produces the Descriptors of a Scene composed of Speech Objects and optionally an Alert:" ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BSS-V1.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BSS-V1.5/port/Input/OSD-SPT-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BSS-V1.5/port/Output/CAV-ALT-V1.1/0>,
        <https://mpai.community/kg/aim/OSD-BSS-V1.5/port/Output/OSD-BSS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicSpeechSceneDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-speech-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-speech-scene-description/> .

aim:OSD-MAC-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-MAC-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Access Control: recognises a User from face and speech and issues a spoken/rendered verdict. Face Recognition and Speaker Recognition read the enrolled gallery (the User IDs) and the Scene Descriptors from Shared Storage - these are NOT ports. Time (OSD-STM) accompanies each captured object and is supplied by the User Agent's clock. ID Reconciliation reconciles the two candidate Instance Identifiers and issues the Response (the verdict words) and its Personal Status; Response and Scene Rendering speaks the Response and produces the lip-synced Machine Face Descriptors. The reconciled UserID stays internal; the User consumes the Response and the avatar. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:flow <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/1>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/10>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/11>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/12>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/2>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/3>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/4>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/5>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/6>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/7>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/8>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/flow/9> ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-MAC-V1.5/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/port/Output/PAF-PAV-V1.6/0>,
        <https://mpai.community/kg/aim/OSD-MAC-V1.5/port/Output/boolean/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/MultimodalAccessControl.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-SIR-V2.5,
        aim:OSD-IDR-V1.5,
        aim:PAF-FIR-V1.6,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/multimodal-access-control/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:PAF-AVS-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-AVS-V1.6" ;
    mkg:apiProfile "Secure" ;
    mkg:description "Avatar Videoconference Server (slide 3 of the PAF Reference Models): it has two Portable Avatar inputs, both the Portable Avatars of the Virtual Meeting Secretary and of the participants - the first (Port 1) is the set of all the Portable Avatars received and goes straight to Portable Avatar Multiplexing, unchanged and not acted upon, the second (Port 2) is the subset that goes to Portable Avatar Demultiplexing and through translation - all of them unless no participant speaks the same language as another. The Portable Avatars of the participants have no room and no seat: the Multimodal Scene Descriptors and the Spatial Attitudes the server adds are those of its own room. At the start, it receives the Portable Avatars and the Speech and Face Objects of the participants, authenticates them, and distributes the Portable Avatars with the Audio-Visual Scene, the Spatial Attitudes and the Avatar IDs; during the meeting it translates the text and speech of the participants and of the Virtual Meeting Secretary according to their language preferences, and distributes the Portable Avatars. The Summary of the Virtual Meeting Secretary passes through. It is the Trust Authority of the participants and of the Virtual Meeting Secretary; its External Ports (IsRemote) take from and give to their Controllers through Communication, a Portable Avatar going to every one but the one it came from; the Audio-Visual Scene and the Spatial Attitudes are its own. It runs continuously." ;
    mkg:flow <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/1>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/10>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/11>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/12>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/13>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/14>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/15>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/2>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/3>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/4>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/5>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/6>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/7>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/8>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/flow/9> ;
    mkg:ofStandard standard:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/OSD-BMS-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/PAF-PAV-V1.6/1>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Input/PAF-PAV-V1.6/2>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Output/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-AVS-V1.6/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/AvatarVideoconferenceServer.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-TST-V2.5,
        aim:PAF-PDX-V1.6,
        aim:PAF-PMX-V1.6,
        aim:PAF-SPA-V1.6 ;
    mkg:title "Avatar Videoconference Server V1.6" ;
    mkg:webPage <https://mpai.community/standards/mpai-paf/v1-6/ai-modules/avatar-videoconference-server/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

aim:PAF-VCT-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-VCT-V1.6" ;
    mkg:apiProfile "Secure" ;
    mkg:description "Videoconference Client Transmitter: on the participant side, the Multimodal Frontend Description gives what the microphone and the camera deliver as Speech, Face and Body Objects; Automatic Speech Recognition and Personal Status Extraction give the Recognised Text and the Personal Status; Entity Face Description and Entity Body Description give the Face and the Body Descriptors; Portable Avatar Multiplexing composes the Participant Portable Avatar for the Avatar Videoconference Server. The Speech Object and the Face Object are also given to the server." ;
