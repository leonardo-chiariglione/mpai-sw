datatype:PGM-CFN-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-CFN-V1.0" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/PGM/V1.0/Communicative.cs> ;
    mkg:codePath "AIMs/PGM/V1.0/Communicative.cs" ;
    mkg:description "What the A-User means to do with its body while it utters the Text of a Final Response: for each function, towards whom or what, with which words, how markedly and, at Level 2, with which behaviour. Basic Knowledge gives the functions in the Final Response (Level 1 or 2); Final Response Demultiplexing gives them to Behaviour Planning, which gives them to Animation Object Generation with a behaviour and its times for every function. The Function and the Behaviour are taken from closed lists, and a Behaviour shall be one of those allowed for its Function." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/CommunicativeFunctions.json> ;
    mkg:sourceAI true ;
    mkg:title "Communicative Functions V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/communicative-functions/> .

