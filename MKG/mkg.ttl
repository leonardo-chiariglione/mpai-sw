aim:PAF-VMS-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-VMS-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Virtual Meeting Secretary: from the Portable Avatar of each participant who speaks, it recognises and understands what was said, and creates the Summary of the meeting from it, from the participant's ID and from the Personal Status the Portable Avatar carries; Entity Dialogue Processing edits the Summary, gives it out, and - when the secretary has something to say - produces the text, the Personal Status and the Avatar Model of the VMS Portable Avatar, which Personal Status Display forms. The Summary goes round from Summary Creation to Entity Dialogue Processing and back: the Module runs continuously. Its External Ports (IsRemote) take the Portable Avatars from, and give its own and the Summary to, the Avatar Videoconference Server through Communication." ;
    mkg:flow <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/1>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/10>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/11>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/12>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/13>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/14>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/15>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/16>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/17>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/18>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/19>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/2>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/20>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/3>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/4>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/5>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/6>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/7>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/8>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/flow/9> ;
    mkg:ofStandard standard:PAF ;
    mkg:port <https://mpai.community/kg/aim/PAF-VMS-V1.6/port/Input/PAF-PAV-V1.6/0>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/port/Input/string/0>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/port/Output/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/PAF-VMS-V1.6/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/PAF/V1.6/AIMs/VirtualMeetingSecretary.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-NLU-V2.5,
        aim:MMC-SCM-V2.5,
        aim:PAF-PDX-V1.6,
        aim:PAF-PSD-V1.6 ;
    mkg:title "Virtual Meeting Secretary V1.6" ;
    mkg:webPage <https://mpai.community/standards/mpai-paf/v1-6/ai-modules/virtual-meeting-secretary/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-paf/v1-6/> .

