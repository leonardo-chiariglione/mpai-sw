    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-OCR-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-OCR-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/MMC/V2.5/OCR/OcrAimProcessor.cs> ;
    mkg:codePath "AIMs/MMC/V2.5/OCR/OcrAimProcessor.cs" ;
    mkg:description "This AIM receives the image of a page as a Basic Visual Object and, optionally, a Point on it (OSD-PNT-V1.5), and produces a Text Object: the lines of text found on a band of the page about the Point (at the top of the page with no Point), in the full width of the page, in reading order, each a Basic Text Object with its box on the page and its confidence. The box of a line is the Space-Time of the line in the Text Object: SpatialAttitude1 is its top-left corner, SpatialAttitude2 its bottom-right corner, in the pixels of the image (X to the right, Y down). The confidence of a line is in its Data Exchange Metadata." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-OCR-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-OCR-V2.5/port/Input/OSD-PNT-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-OCR-V2.5/port/Output/OSD-TXO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/OpticalCharacterRecognition.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/optical-character-recognition/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/optical-character-recognition/> .

