        aim:XRV-REG-V1.0,
        aim:XRV-VEG-V1.0 ;
    mkg:title "Live Theatrical Performance V1.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-xrv/ltp/v1-0/ai-modules/live-theatrical-performance/> ;
