aim:CVE-VOI-V1.0 a mkg:AIM ;
    mkg:acronym "CVE-VOI-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Visual Object Identification: produces the Identifier, based on a Taxonomy, of the Visual Object of a Visual Scene, described by its Basic Visual Scene Descriptors, that a Point of View crosses. The Point of View comes from the Body Descriptors of the Entity that indicates the object (Visual Direction Identification); Visual Object Extraction takes from the Visual Objects the one the Point of View crosses; Visual Instance Identification gives its Identifier." ;
    mkg:flow <https://mpai.community/kg/aim/CVE-VOI-V1.0/flow/1>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/flow/2>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/flow/3>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/flow/4>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/flow/5>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/flow/6>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/flow/7> ;
    mkg:ofStandard standard:CVE ;
    mkg:port <https://mpai.community/kg/aim/CVE-VOI-V1.0/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/port/Input/OSD-BVS-V1.5/0>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/port/Input/PAF-BDO-V1.6/0>,
        <https://mpai.community/kg/aim/CVE-VOI-V1.0/port/Output/OSD-IID-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CVE/V1.0/AIMs/VisualObjectIdentification.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CVE-VDI-V1.0,
        aim:CVE-VII-V1.0,
        aim:OSD-VOE-V1.5 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-cve/v1-0/ai-modules/visual-object-identification/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cve/v1-0/ai-modules/visual-object-identification/> .

aim:OSD-BVS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BVS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/OSD/V1.5/BVS/BvsAimProcessor.cs> ;
    mkg:codePath "AIMs/OSD/V1.5/BVS/BvsAimProcessor.cs" ;
    mkg:description "Basic Visual Scene Description: describes the acquired BasicVisualObject as BasicVisualSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in CAV-HCI." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Input/CAV-BED-V1.1/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Input/CAV-BED-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Output/CAV-ALT-V1.1/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Output/OSD-BVS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicVisualSceneDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-visual-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:PGM-USR-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-USR-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The User State Refinement (PGM-USR) AIM improves the A-User's understanding of the evolving User State. It refines the baseline User State produced by Context Description into an authoritative, up-to-date User State (represented by an Entity State) that it passes to Personality Alignment. It refines the Engagement (level and mode) and the Entity State. User State Refinement operates through one operative interface and one semantic interface:" ;
    mkg:flow <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/1>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/10>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/11>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/12>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/13>,
