        <https://mpai.community/kg/aim/PGM-AII-V1.0/port/Output/PGM-DOM-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-AII-V1.0/port/Output/PGM-IHI-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-AII-V1.0/port/Output/PGM-UCC-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/AudioInstanceIdentification.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/audio-instance-identification/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/audio-instance-identification/> .

