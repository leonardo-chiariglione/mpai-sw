        <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Output/CAV-ALT-V1.1/0>,
        <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Output/OSD-BUS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicUltrasoundSceneDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-ultrasound-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-FBO-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-FBO-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Full to Basic Object: gives access to the Basic Objects that compose a Full Object of any medium (Speech, Audio, Visual, 3D Model, LiDAR, RADAR, Offline Map, Ultrasound, Multimodal, Text or generic Object). It outputs the Basic Objects of the Full Object sequentially, in order, as the AIMs that follow work on Basic Objects." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-FBO-V1.5/port/Input/OSD-3DO-V1.5/0>,
