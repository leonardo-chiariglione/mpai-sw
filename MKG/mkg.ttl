aim:CAE-SPD-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-SPD-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Sparse Plane Wave Decomposition (CAE-SPD) of CAE-6DF V1.0: Models a complex, multi-channel sound field as a small number of discrete, highly directional plane waves per time-frequency bin, effectively isolating the primary direct sound paths from the non-directional background room reverberation." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-SPD-V1.0/port/Input/CAE-SOU-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-SPD-V1.0/port/Output/CAE-DPW-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-SPD-V1.0/port/Output/CAE-DWR-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/SparsePlaneWaveDecomposition.json> ;
    mkg:sourceAI true ;
    mkg:title "Sparse Plane Wave Decomposition V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

