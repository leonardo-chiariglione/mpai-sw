        <https://mpai.community/kg/aim/MMC-CAS-V2.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/MMC-CAS-V2.5/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/ConversationAboutAScene.json> ;
    mkg:sourceAI true ;
