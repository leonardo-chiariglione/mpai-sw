aim:HMC-CEC-V2.2 a mkg:AIM ;
    mkg:acronym "HMC-CEC-V2.2" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Communicating Entities in Context: Multimodal Scene Integration and Description gives the Objects and the Scene Descriptors of the Scene of the Input Portable Avatar and Multimodal Frontend Description those of the real world; Entity and Context Understanding understands them with the Input Text; Text and Speech Translation translates the Speech and the Text; Entity Dialogue Processing gives the Machine Text and the Machine Personal Status; Text-to-Text Translation translates the Machine Text; Portable Avatar Multiplexing gives the Portable Avatar." ;
    mkg:flow <https://mpai.community/kg/aim/HMC-CEC-V2.2/flow/1>,
