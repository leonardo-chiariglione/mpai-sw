aim:XRV-LTP-V1.0 a mkg:AIM ;
    mkg:acronym "XRV-LTP-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The Live Theatrical Performance (XRV-LTP) AIM receives Venue-specific Specifications and data from the Real and Virtual live-performance Environment, the live performance Script, historical and current Participant data, and Venue-specific commands, data, and associations between Script and Venue. As the Live Theatrical Performance proceeds, it controls the audience experience according to the Script based on the Actions of the Performance (Performers and related objects), Operators, and Participants." ;
    mkg:notAligned true ;
    mkg:ofStandard standard:XRV ;
    mkg:port <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Input/XRV-ATB-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Input/XRV-PTD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Input/XRV-RDI-V1.0/0>,
