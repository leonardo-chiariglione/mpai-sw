aim:OSD-BRS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BRS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic RADAR Scene Description: describes the acquired BasicRADARObject as BasicRADARSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in CAV-HCI." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Input/CAV-BED-V1.1/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Input/CAV-BED-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Input/OSD-BRO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Output/CAV-ALT-V1.1/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Output/CAV-ALT-V2.0/0>,
        <https://mpai.community/kg/aim/OSD-BRS-V1.5/port/Output/OSD-BRS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicRADARSceneDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

aim:OSD-BUS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BUS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic Ultrasound Scene Description: describes the acquired BasicUltrasoundObject as BasicUltrasoundSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in CAV-HCI." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BUS-V1.5/port/Input/CAV-BED-V1.1/0>,
