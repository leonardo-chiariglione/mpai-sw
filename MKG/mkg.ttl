aim:CAE-LIP-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-LIP-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Linear Interpolation (CAE-LIP) of CAE-6DF V1.0: Linearly interpolates the time-domain diffuse field according to the Interpolation Parameters." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-LIP-V1.0/port/Input/CAE-IPR-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-LIP-V1.0/port/Input/CAE-STF-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-LIP-V1.0/port/Output/CAE-TIS-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/LinearInterpolation.json> ;
    mkg:sourceAI true ;
    mkg:title "Linear Interpolation V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CAE-PWI-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-PWI-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Plane Wave Parameter Interpolation (CAE-PWI) of CAE-6DF V1.0: The PWI module performs spatial interpolation on parametric representations of a sound field, such as estimated Directions of Arrival (DoAs), source distances, and amplitudes, estimated at discrete, static physical microphone array positions by operating directly on these spatial metadata parameters rather than raw audio waveforms. This module enables the calculation of a spatially coherent, localized sound field representation at any arbitrary virtual listening coordinate within a 6DF environment." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-PWI-V1.0/port/Input/CAE-IPR-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-PWI-V1.0/port/Input/CAE-SPP-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-PWI-V1.0/port/Output/CAE-ISW-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/PlaneWaveParameterInterpolation.json> ;
    mkg:sourceAI true ;
    mkg:title "Plane Wave Parameter Interpolation V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CAE-SFR-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-SFR-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Sound Field Rotation (CAE-SFR) of CAE-6DF V1.0: Rotates the sound field based on the listener’s head orientation." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-SFR-V1.0/port/Input/CAE-TOT-V1.0/0>,
