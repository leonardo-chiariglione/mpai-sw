aim:PGM-FRD-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-FRD-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The Final Response Demultiplexing (PGM-FRD) AIM is a Sub-AIM of A-User Formation (PGM-AUF). It takes apart the Final Response produced by Basic Knowledge: the Text, which goes to Text-To-Speech and to Portable Avatar Multiplexing; the Communicative Functions, which go to Behaviour Planning; the Actions, which go with the text and go to Animation Object Generation; and the Process Actions, more remote from the text, which A-User Formation gives to A-User Control unchanged. It is driven by the AUC-AUF Request and reports with an AUC-AUF Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-FRD-V1.0/port/Input/PGM-FRS-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-FRD-V1.0/port/Input/PGM-UCF-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-FRD-V1.0/port/Output/MMM-ACT-V2.2/0>,
        <https://mpai.community/kg/aim/PGM-FRD-V1.0/port/Output/MMM-PAT-V2.2/0>,
        <https://mpai.community/kg/aim/PGM-FRD-V1.0/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-FRD-V1.0/port/Output/PGM-CFN-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-FRD-V1.0/port/Output/PGM-UCF-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/FinalResponseDemultiplexing.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/final-response-demultiplexing/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/final-response-demultiplexing/> .

