action:MMM-LCS-V3.0 a mkg:Action ;
    mkg:acronym "MMM-LCS-V3.0" ;
    mkg:description "License Process Action (MMM-LCS): the User offering an Asset gives the User interested in the offer a Licence for it, with the Transact Service. MMM-TEC V2.2 listed the License Process Action and its modifiers (Nil, To, With) without the elements of its request and response; MMM-TEC V3.0 specifies them, modelled on those of Post (MMM-PTP) and on the Licence Data Type (MMM-LIC)." ;
    mkg:ofStandard standard:MMM ;
    mkg:schema <https://schemas.mpai.community/MMM4/V3.0/actions/LicensePA.json> ;
