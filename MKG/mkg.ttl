aim:MMC-MEF-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MEF-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM fuses the Emotion of the Text, the Emotion of the Speech and the Emotion of the Face of an Entity into the Emotion of the Entity. Each Emotion is carried by a Personal Status (Text, Speech, Face) that has only the Emotion Factor; the output is a Personal Status that has only the fused Emotion." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MEF-V2.5/port/Input/MMC-FPS-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MEF-V2.5/port/Input/MMC-SPS-V2.5/0>,
