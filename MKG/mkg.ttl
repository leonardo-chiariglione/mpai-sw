        <https://mpai.community/kg/aim/HMC-SID-V2.2/port/Output/OSD-BVO-V1.5/1>,
        <https://mpai.community/kg/aim/HMC-SID-V2.2/port/Output/OSD-BVO-V1.5/2>,
        <https://mpai.community/kg/aim/HMC-SID-V2.2/port/Output/OSD-BVO-V1.5/3>,
        <https://mpai.community/kg/aim/HMC-SID-V2.2/port/Output/OSD-BVS-V1.5/0> ;
