        <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/6>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/7>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/8>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/flow/9> ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-USR-V1.0/port/Input/MMC-EST-V2.5/0>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/port/Input/PGM-IHI-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/port/Input/PGM-KUS-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/port/Input/PGM-UCU-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-USR-V1.0/port/Output/MMC-EST-V2.5/0>,
