datatype:OSD-AFT-V1.5 a mkg:DataType ;
    mkg:acronym "OSD-AFT-V1.5" ;
    mkg:description "Actionable properties of a visual object, inferred from its geometry, orientation and spatial context: the types of physical or semantic action that the object invites." ;
    mkg:ofStandard standard:OSD ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/AffordanceTags.json> ;
    mkg:sourceAI true ;
    mkg:title "Affordance Tags V1.5" ;
    mkg:uses datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/data-types/affordance-tags/> .

datatype:PGM-LPE-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-LPE-V1.0" ;
    mkg:description "The evidence borne by the content of the utterances of an Entity and by the manner of their delivery, with the agreement between the two, produced by Linguistic-Paralinguistic Analysis. Evidence that cannot be attributed to an Entity is reported but not asserted of any Entity." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/LinguisticParalinguisticEvidence.json> ;
    mkg:sourceAI true ;
    mkg:title "Linguistic-Paralinguistic Evidence V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/linguistic-paralinguistic-evidence/> .

datatype:PGM-PRP-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-PRP-V1.0" ;
    mkg:description "Propositions produced by Prompt Creation. A Proposition links a subject to an object through a predicate, with spatial and temporal context where applicable. Intent and Referent Analysis uses Propositions to express the resolution of the referring expressions (pronouns, definite descriptions, demonstratives, deictic gestures); Prompt Contextualisation adds Propositions that represent contextual facts, timing guidance and phrasing constraints." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/Proposition.json> ;
    mkg:sourceAI true ;
    mkg:title "Proposition V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/proposition/> .

datatype:TFA-SAQ-V1.5 a mkg:DataType ;
    mkg:acronym "TFA-SAQ-V1.5" ;
    mkg:description "Qualifier stating the conventions by which the numbers of a Spatial Attitude, of Spatial Data and of Pointing Data are to be read: the representation, the reference frame, the axes and their handedness, the units and the order of the rotations. It states what the data cannot state, and it does not change them. When the Qualifier is absent, the default conventions of the Data Type apply. For Position, Orientation and Spatial Attitude (OSD) they are those of ISO 8855: a right-handed East-North-Up frame; body axes X forward, Y left, Z up; Euler angles (α, β, γ) = (yaw, pitch, roll), intrinsic rotations about Z, Y′, X″, positive by the right-hand rule; degrees and metres; a quaternion (w, x, y, z). A Data Type with no stated default does not state its conventions. A Qualifier carried by a Data Type that contains another (a Path of Points of View, a Spatial Attitude with its Position and Orientation) applies to what it contains, unless the contained Data Type carries its own." ;
    mkg:ofStandard standard:TFA ;
    mkg:schema <https://schemas.mpai.community/TFA/V1.5/data/SpatialQualifier.json> ;
    mkg:sourceAI true ;
    mkg:title "Spatial Qualifier V1.5" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 .

datatype:XRV-CTO-V1.0 a mkg:DataType ;
    mkg:acronym "XRV-CTO-V1.0" ;
    mkg:description "" ;
    mkg:ofStandard standard:XRV ;
    mkg:schema <https://schemas.mpai.community/XRV1/V1.0/data/ControlObject.json> ;
