useragent:User_Agent a mkg:UserAgent ;
    mkg:acronym "User Agent" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/tree/main/AIF/UserAgent> ;
    mkg:codePath "AIF/UserAgent" ;
    mkg:description "A User Agent uses Units to interact with the real world. Acquisition from and delivery to the physical layer are done by Units of the User Agent, not by AIMs." ;
    mkg:usesUnit unit:UNT-3OD,
        unit:UNT-AOA,
        unit:UNT-AOD,
        unit:UNT-HDA,
        unit:UNT-LOA,
        unit:UNT-MOD,
        unit:UNT-NSA,
        unit:UNT-PDA,
        unit:UNT-ROA,
        unit:UNT-SDA,
        unit:UNT-SOA,
        unit:UNT-SOD,
        unit:UNT-TOA,
        unit:UNT-TOD,
        unit:UNT-UOA,
        unit:UNT-VOA,
        unit:UNT-VOD,
        unit:UNT-WDA .

aim:PGM-AMP-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-AMP-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The Audio Motion and Proximity (PGM-AMP) AI Module analyses the temporal and spatial dynamics of Audio Objects in an audio scene by" ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-AMP-V1.0/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-AMP-V1.0/port/Input/PGM-DOM-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-AMP-V1.0/port/Input/PGM-IHI-V1.0/0>,
