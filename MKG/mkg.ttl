aim:MMC-TTS-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-TTS-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/MMC/V2.5/TTS/TtsAimProcessor.cs> ;
    mkg:codePath "AIMs/MMC/V2.5/TTS/TtsAimProcessor.cs" ;
    mkg:description "Text to Speech: converts a Text Object (Basic Text Object or Text Object) into a Speech Object (Basic Speech Object or Speech Object). The input port accepts both OSD-BTO and OSD-TXO; the output port carries both OSD-BSO and OSD-SPO. The optional Personal Status port accepts a Speech Personal Status (MMC-SPS) or a Personal Status (MMC-EPS), e.g. an Emotion, whose Emotion the synthetic speech conveys." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-TTS-V2.5/port/Input/AIP-MLO-V1.0/0>,
