aim:MMC-PSE-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-PSE-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Personal Status Extraction: extracts the Personal Status of an Entity from the four media - Text, Speech, Face, Body - or from their descriptors. Each medium is described by Entity Text / Speech / Face / Body Description and the descriptors are interpreted by PS-Text / PS-Speech / PS-Face / PS-Body Interpretation; descriptors that arrive as such go straight to the interpretation; Personal Status Multiplexing combines the Personal Statuses of the modalities that arrived. A Text Personal Status that arrives ready-made (TextPersonalStatus) goes straight to the multiplexing." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/12>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/13>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/14>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/15>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/16>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/17>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/18>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/MMC-SDO-V2.5/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/MMC-TDO-V2.5/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/MMC-TPS-V2.5/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/OSD-BVO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/OSD-BVO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/OSD-SPO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/OSD-TXO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/PAF-BDO-V1.6/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Input/PAF-FDO-V1.6/1>,
        <https://mpai.community/kg/aim/MMC-PSE-V2.5/port/Output/MMC-EPS-V2.5/1> ;
