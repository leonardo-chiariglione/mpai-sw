datatype:PGM-FRS-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-FRS-V1.0" ;
    mkg:description "The deliberated content produced by Basic Knowledge: the text to be uttered, the Communicative Functions that go with the text (what the A-User means to do with its body, towards whom or what and with which words), the Actions that go with the text (for instance moving the Persona in the M-Instance) and the Process Actions that carry out the response, which may be more remote from the text. It is the only output of Basic Knowledge, apart from the AUC-BKN Response and the exchanges with its partners, and it is sent to A-User Formation." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/FinalResponse.json> ;
    mkg:sourceAI true ;
    mkg:title "Final Response V1.0" ;
    mkg:uses datatype:OSD-BTO-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PGM-CFN-V1.0,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/final-response/> .

datatype:PGM-MIH-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-MIH-V1.0" ;
    mkg:description "The audio, visual, textual and paralinguistic evidence of the scene placed on a common time base and attributed to harmonised Entities by Multimodal Input Harmonisation, with a record of the evidence that could not be harmonised. It states what was observed, when and by whom, without interpreting it." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/HarmonisedMultimodalContext.json> ;
    mkg:sourceAI true ;
    mkg:title "Harmonised Multimodal Context V1.0" ;
    mkg:uses datatype:MMC-SDO-V2.5,
