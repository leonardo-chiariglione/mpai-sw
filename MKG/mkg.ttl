        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/data-types/social-attitude/> .

datatype:OSD-CSP-V1.5 a mkg:DataType ;
    mkg:acronym "OSD-CSP-V1.5" ;
    mkg:description "A space enclosed by walls: its shape a Simple Location - a combination of Right Parallelepipeds. The walls are the faces of the Right Parallelepipeds, named Floor, Ceiling, Front, Back, Left and Right as Right Parallelepiped names them; a face where two Right Parallelepipeds meet is an opening, not a wall. What the walls are made of - their Materials - is not part of the Closed Space: it belongs to the acoustics of the Scene, the Walls and the DefaultMaterial of its Acoustic Profile (CAE-ACP)." ;
    mkg:ofStandard standard:OSD ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/ClosedSpace.json> ;
    mkg:sourceAI true ;
    mkg:title "Closed Space V1.5" ;
    mkg:uses datatype:OSD-SLC-V1.5,
        datatype:OSD-SPT-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/data-types/closed-space/> .

