    mkg:acronym "NNW-NWE-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "NTI Watermark Embedder: embeds the payload in the parameters of a Module without training it (No Training Imperceptibility) and gives the watermarked parameters." ;
