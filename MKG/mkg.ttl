datatype:PGM-UCF-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-UCF-V1.0" ;
    mkg:description "The Data Type exchanged between A-User Control (AUC) and A-User Formation (AUF). It has two modes, told apart by Mode: Request (RQ), sent by AUC to AUF, and Response (RS), sent by AUF to AUC. A-User Formation receives the Final Response of Basic Knowledge, which holds all the outputs of Basic Knowledge: the Text, the Actions and the Process Actions. It gives the Process Actions to AUC unchanged and generates, from the Actions, the Animation Objects for the rendering of the Portable Avatar. A-User Formation also forms the Portable Avatar and gives it to AUC. The Request controls the formation and each animation; the Response reports the outcome of each step and the progress of the animations. A-User Formation sends nothing to the M-Instance and the Portable Avatar leaves the A-User only if AUC authorises it. Every Request is answered by a Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/AUCAUF.json> ;
    mkg:sourceAI true ;
    mkg:title "AUC-AUF V1.0" ;
    mkg:uses datatype:OSD-OSA-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PGM-CFN-V1.0,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-auf/> .

datatype:OSD-TIM-V1.5 a mkg:DataType ;
    mkg:acronym "OSD-TIM-V1.5" ;
    mkg:description "The digital representation of a time value." ;
    mkg:ofStandard standard:OSD ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/Time.json> ;
    mkg:sourceAI true ;
    mkg:title "Time V1.5" ;
    mkg:uses datatype:PTF-DEM-V1.0,
        datatype:TFA-TIQ-V1.5 ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/data-types/time/> .

