    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/BasicVisualObject.json> ;
    mkg:sourceAI true ;
    mkg:title "Basic Visual Object V1.5" ;
    mkg:uses <https://mpai.community/kg/datatype/CAE3/AcousticProfile>,
        datatype:OSD-IID-V1.5,
        datatype:OSD-SPT-V1.5,
        datatype:PAF-TEM-V1.6,
        datatype:PTF-DEM-V1.0,
        datatype:TFA-VIQ-V1.5 ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/data-types/basic-visual-object/> .

datatype:PGM-IHI-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-IHI-V1.0" ;
    mkg:description "The Data Type exchanged between any AIM of the A-User and Private Storage, through the Controller, for the content of earlier captures and turns of the session. It has two modes, told apart by Mode: Request (RQ), that states what is to be read and what is to be written, and Response (RS), that returns the content read and the outcome of the writes. SourceAIM states which AIM or Sub-AIM sends the Request or receives the Response, and Subject which medium or User it relates to. All access is under the rules set by A-User Control." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/InteractionHistory.json> ;
    mkg:sourceAI true ;
    mkg:title "Interaction History V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/interaction-history/> .

