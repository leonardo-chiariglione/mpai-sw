datatype:PGM-PCP-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-PCP-V1.0" ;
    mkg:description "The structured prompt that Prompt Creation submits to Basic Knowledge to open the Model Context Protocol session. It carries the representation of the scene context, of the Intent of the User, of the resolved referents, of the constraints of the Goal and of the expressive configuration of the A-User and, when A-User Control so requires, the Action context that Basic Knowledge needs to produce Actions and Process Actions." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/PCPrompt.json> ;
    mkg:sourceAI true ;
    mkg:title "PC Prompt V1.0" ;
    mkg:uses datatype:MMC-EIT-V2.5,
        datatype:OSD-STM-V1.5,
        datatype:PGM-CFN-V1.0,
        datatype:PGM-CXD-V1.0,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/pc-prompt/> .

