aim:CAE-ARP-V2.5 a mkg:AIM ;
    mkg:acronym "CAE-ARP-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/CAE1/V2.5/ARP/AapAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE1/V2.5/ARP/AapAimProcessor.cs" ;
    mkg:description "Creates a digital copy of the digitised audio of an open reel magnetic tape for long-term preservation (Preservation Master Files) and an access copy, restored if necessary, for correct playback (Access Copy Files). The Audio Analysis for Preservation and the Video Analysis for Preservation exchange the Irregularity Files they produce, so the Module has a loop." ;
    mkg:flow <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/1>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/10>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/11>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/12>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/13>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/14>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/15>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/16>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/17>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/18>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/19>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/2>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/3>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/4>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/5>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/6>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/7>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/8>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/flow/9> ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-ARP-V2.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/port/Input/OSD-BMO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/port/Output/OSD-BAO-V1.5/1>,
        <https://mpai.community/kg/aim/CAE-ARP-V2.5/port/Output/OSD-BAO-V1.5/2> ;
    mkg:schema <https://schemas.mpai.community/CAE1/V2.5/AIMs/AudioRecordingPreservation.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CAE-AAP-V2.5,
        aim:CAE-PAP-V2.5,
        aim:CAE-TAR-V2.5,
        aim:CAE-TIC-V2.5,
        aim:CAE-VAP-V2.5 ;
    mkg:title "Audio Recording Preservation V2.5" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/audio-recording-preservation/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/audio-recording-preservation/> .

aim:CAE-ASE-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-ASE-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/CAE3/V1.0/ASE/AseAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/ASE/AseAimProcessor.cs" ;
    mkg:description "Audio Scene Editing. One Audio Scene is open at a time, so a User Command need not name it: a Audio Scene arriving is opened, and the first Object added to no open Scene creates one. The User Command places Audio Objects - named as the User names them - (AddedObjects), moves them (MovedObjects), changes where they are (ChangedObjects), takes them out (RemovedObjects) and sets where the Scene is heard from (UserPoV). Every edit is a new version in Shared Storage. Outputs: the open Audio Scene, and the User Command, with its response (UserCommandRS) saying how each action was executed." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-ASE-V1.0/port/Input/CAE-UCM-V1.0/0>,
