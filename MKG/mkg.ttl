        <https://mpai.community/kg/aim/NNW-NIR-V2.0/flow/4>,
        <https://mpai.community/kg/aim/NNW-NIR-V2.0/flow/5>,
        <https://mpai.community/kg/aim/NNW-NIR-V2.0/flow/6> ;
    mkg:ofStandard standard:NNW ;
    mkg:port <https://mpai.community/kg/aim/NNW-NIR-V2.0/port/Input/NNW-PLD-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-NIR-V2.0/port/Input/NNW-PRM-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-NIR-V2.0/port/Output/NNW-CER-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-NIR-V2.0/port/Output/NNW-PLD-V2.0/0> ;
    mkg:schema <https://schemas.mpai.community/NNW1/V2.0/AIMs/NoInferenceRobustness.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:NNW-CMP-V2.0,
        aim:NNW-MFM-V2.0,
        aim:NNW-NWD-V2.0 ;
    mkg:title "No Inference Robustness V2.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-nnw/nnt/v2-0/> .

