aim:CAE-AES-V2.5 a mkg:AIM ;
    mkg:acronym "CAE-AES-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Add Emotion to Speech (CAE-AES) of CAE-USC V2.5: gives emotionless speech an emotion that is named. Speech Feature Analysis 2 (CAE-SFB) extracts the features of the emotionless speech, selected by the Mode Selector; Emotion Feature Production (CAE-EFP) produces from them, from the Emotion List and in the language selected, the neural speech features of the emotion; Neural Emotion Insertion (CAE-NEI) gives them to the emotionless speech, and gives the Speech with Emotion." ;
    mkg:flow <https://mpai.community/kg/aim/CAE-AES-V2.5/flow/1>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/flow/2>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/flow/3>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/flow/4>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/flow/5>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/flow/6>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/flow/7>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/flow/8> ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-AES-V2.5/port/Input/MMC-EEM-V2.5/1>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/port/Input/OSD-BSO-V1.5/2>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/port/Input/OSD-SEL-V1.5/1>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/port/Input/OSD-SEL-V1.5/2>,
        <https://mpai.community/kg/aim/CAE-AES-V2.5/port/Output/OSD-BSO-V1.5/1> ;
    mkg:schema <https://schemas.mpai.community/CAE1/V2.5/AIMs/AddEmotionToSpeech.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CAE-EFP-V2.5,
        aim:CAE-NEI-V2.5,
        aim:CAE-SFB-V2.5 ;
    mkg:title "Add Emotion to Speech V2.5" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/add-emotion-to-speech/> .

