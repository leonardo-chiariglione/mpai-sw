aim:NNW-NTI-V2.0 a mkg:AIM ;
    mkg:acronym "NNW-NTI-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "No Training Imperceptibility: the Module that evaluates the imperceptibility of a watermark inserted without training: a Module Trainer trains the Module (1) and the Unwatermarked Module infers; a second training (2) gives the parameters into which the NTI Watermark Embedder embeds the payload, and the Watermarked Module infers. The two inferences are the outputs." ;
    mkg:flow <https://mpai.community/kg/aim/NNW-NTI-V2.0/flow/1>,
        <https://mpai.community/kg/aim/NNW-NTI-V2.0/flow/10>,
