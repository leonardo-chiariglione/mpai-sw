aim:PAF-RSR-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-RSR-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Response and Scene Rendering: renders the machine's response - a Text, and the Personal Status that goes with it - as the Portable Avatar of the input Avatar Model, ready to play; whoever requested it places it in a scene and renders it (with Scene and Avatar Rendering). Personal Status De-multiplexing splits a Personal Status into the Speech, Face and Body Personal Statuses; Text-To-Speech makes the Machine Speech; Portable Avatar Formation makes the Portable Avatar. The Point of View goes through." ;
    mkg:flow <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/1>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/10>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/11>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/12>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/13>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/14>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/15>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/16>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/17>,
        <https://mpai.community/kg/aim/PAF-RSR-V1.6/flow/2>,
