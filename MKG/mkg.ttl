    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/visual-salience-mapping/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/visual-salience-mapping/> .

