datatype:PGM-ASC-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-ASC-V1.0" ;
    mkg:description "The admissible pairings of Audio Entities with Visual Entities proposed by Cross-Modal Candidate Association, each with its association score and the contribution of each kind of evidence. The association is many-to-many: no pairing is committed." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/AssociationCandidates.json> ;
    mkg:sourceAI true ;
    mkg:title "Association Candidates V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/association-candidates/> .

datatype:PGM-CMI-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-CMI-V1.0" ;
    mkg:description "The readings supported by the evidence of all modalities, in order of confidence, with the established reference bindings and the identified disagreements, produced by Cross-Modal Interpretation. Discounted readings are not discarded." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/CrossModalInterpretativeEvidence.json> ;
    mkg:sourceAI true ;
    mkg:title "Cross-Modal Interpretative Evidence V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/cross-modal-interpretative-evidence/> .

datatype:PGM-ECO-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-ECO-V1.0" ;
    mkg:description "The correspondences established by Correspondence Resolution between Audio Entities and Visual Entities, each with its cardinality, confidence, aligned identifier and close alternatives." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/EntityCorrespondences.json> ;
    mkg:sourceAI true ;
    mkg:title "Entity Correspondences V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/entity-correspondences/> .

datatype:PGM-JSL-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-JSL-V1.0" ;
    mkg:description "The ranking of the AV Entities by joint salience produced by Audio-Visual Salience Reconciliation, each rank with its ground and confidence. A divergence between the modalities is recorded, not removed." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/JointSalience.json> ;
    mkg:sourceAI true ;
    mkg:title "Joint Salience V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/joint-salience/> .

datatype:PGM-PRS-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-PRS-V1.0" ;
    mkg:description "The expressive configuration of the A-User determined by Prompt Contextualisation from the User States and the interaction context: tone, style, pacing and narrative goal. It is used by Prompt Planning and Formatting to assemble the PC Prompt." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/Personality.json> ;
    mkg:sourceAI true ;
    mkg:title "Personality V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/personality/> .

datatype:PGM-RCX-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-RCX-V1.0" ;
    mkg:description "The interaction context obtained by Context Resolution (Personality Alignment) and reconciled with the User State, so that the selection of the stance is context-aware." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/ResolvedContext.json> ;
    mkg:sourceAI true ;
    mkg:title "Resolved Context V1.0" ;
    mkg:uses datatype:MMC-EST-V2.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/resolved-context/> .

datatype:PGM-UME-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-UME-V1.0" ;
    mkg:description "The Audio Entities and the Visual Entities left without counterpart in the other modality by Correspondence Resolution, each with the reason. An Unmatched Entity is an ordinary state of a Space, not a failure." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/UnmatchedEntities.json> ;
    mkg:sourceAI true ;
    mkg:title "Unmatched Entities V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/unmatched-entities/> .

datatype:TFA-TXQ-V1.5 a mkg:DataType ;
    mkg:acronym "TFA-TXQ-V1.5" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/Core/Qualifiers.cs> ;
    mkg:codePath "AIMs/Core/Qualifiers.cs" ;
