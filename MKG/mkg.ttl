aim:PGM-AOG-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-AOG-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The Animation Object Generation (PGM-AOG) AIM is a Sub-AIM of A-User Formation (PGM-AUF). It generates the animation of the Persona of the A-User: from the Communicative Functions, each with the Behaviour and the times given by Behaviour Planning, and from an Action of MMM-TEC V2.2 that goes with the text (for instance MM-Animate) it produces a Face Animation Object (Port Number 1) or a Body Animation Object (Port Number 2), Animation Objects (PAF-AMO) whose Animation Qualifier names the content format of the animation, which it gives to Entity Face Description and Entity Body Description. It is driven by the AUC-AUF Request and reports with an AUC-AUF Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-AOG-V1.0/port/Input/MMM-ACT-V2.2/0>,
        <https://mpai.community/kg/aim/PGM-AOG-V1.0/port/Input/PGM-CFN-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-AOG-V1.0/port/Input/PGM-UCF-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-AOG-V1.0/port/Output/PAF-AMO-V1.6/1>,
        <https://mpai.community/kg/aim/PGM-AOG-V1.0/port/Output/PAF-AMO-V1.6/2>,
        <https://mpai.community/kg/aim/PGM-AOG-V1.0/port/Output/PGM-UCF-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/AnimationObjectGeneration.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/animation-object-generation/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/animation-object-generation/> .

