datatype:AIH-TPU-V1.1 a mkg:DataType ;
    mkg:acronym "AIH-TPU-V1.1" ;
    mkg:description "Profile of a Third-Party User (AIH-TPU): an entity, not an End User, that registers with the Health Back End to process AIH Data under the terms of the Smart Contracts. Besides who it is, it states what it asks to be allowed to do, in the terms of the AIH Taxonomies and of the Model Licence, so that the Back End can compare it with a licence." ;
    mkg:ofStandard standard:AIH ;
    mkg:schema <https://schemas.mpai.community/AIH1/V1.1/data/ThirdPartyUserProfile.json> ;
    mkg:sourceAI true ;
    mkg:title "Third-Party User Profile V1.1" ;
    mkg:uses <https://mpai.community/kg/datatype/AIH1/AIHDataProcessingType>,
        <https://mpai.community/kg/datatype/AIH1/AIHTaxonomies>,
        datatype:OSD-TIM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-aih/hsp/v1-1/data-types/third-party-user-profile/> .

