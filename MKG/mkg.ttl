aim:CVE-VOB-V1.0 a mkg:AIM ;
    mkg:acronym "CVE-VOB-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Visual Object Identification by Body: identifies the Visual Object that the index finger of a Body Object indicates. It receives the Body Object, a generic Visual Object to be identified and the Basic Visual Scene Descriptors of the scene that includes them. Entity Body Description gives the Body Descriptors of the Body Object, Visual Direction Identification finds the Point of View of the index finger, Visual Object Extraction takes the Visual Object the Point of View crosses, and Visual Instance Identification gives its Identifier." ;
    mkg:flow <https://mpai.community/kg/aim/CVE-VOB-V1.0/flow/1>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/flow/2>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/flow/3>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/flow/4>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/flow/5>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/flow/6>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/flow/7>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/flow/8> ;
    mkg:ofStandard standard:CVE ;
    mkg:port <https://mpai.community/kg/aim/CVE-VOB-V1.0/port/Input/OSD-BVO-V1.5/1>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/port/Input/OSD-BVO-V1.5/2>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/port/Input/OSD-BVS-V1.5/0>,
        <https://mpai.community/kg/aim/CVE-VOB-V1.0/port/Output/OSD-IID-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CVE/V1.0/AIMs/VisualObjectIdentificationByBody.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CVE-VDI-V1.0,
        aim:CVE-VII-V1.0,
        aim:OSD-VOE-V1.5,
        aim:PAF-EBD-V1.6 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-cve/v1-0/ai-modules/visual-object-identification-by-body/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cve/v1-0/ai-modules/visual-object-identification-by-body/> .

aim:MMC-AQM-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-AQM-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Answer to Question Module (slide 4 of the MMC Reference Models, as the composite MMC-MQA, slide 16, uses it): answers a question from its Refined Text, the Text Descriptors Object (the former Meaning), the Instance Identifier of the visual object the question is about, where there is one, and the Intention the Question Analysis Module found, and gives the answer as a Text Object." ;
