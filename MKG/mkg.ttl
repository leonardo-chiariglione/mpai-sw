        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-cav/tec/v2-0/data-types/motor-response/> .

datatype:CAV-WHR-V2.0 a mkg:DataType ;
    mkg:acronym "CAV-WHR-V2.0" ;
    mkg:description "A Data Type representing the measured state and condition of a specific wheel of the Connected Autonomous Vehicle in response to a steering command." ;
    mkg:ofStandard standard:CAV ;
    mkg:schema <https://schemas.mpai.community/CAV2/V2.0/data/WheelResponse.json> ;
