datatype:PGM-DOM-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-DOM-V1.0" ;
    mkg:description "The Data Type exchanged between any AIM of the A-User and Domain Access. It has two modes, told apart by Mode: Request (RQ), that supplies the evidence and the candidate interpretations to be checked together with the operations requested, and Response (RS), that returns the outcome, the validated interpretations with updated confidences and an explanation. SourceAIM states which AIM or Sub-AIM sends the Request or receives the Response, and Subject which medium or User it relates to. A Response carries the QueryID of its Request." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/Domain.json> ;
    mkg:sourceAI true ;
    mkg:title "Domain V1.0" ;
    mkg:uses datatype:MMC-EST-V2.5,
        datatype:OSD-BAS-V1.5,
        datatype:OSD-BMS-V1.5,
        datatype:OSD-BVS-V1.5,
        datatype:OSD-EAD-V1.5,
        datatype:OSD-EVD-V1.5,
        datatype:OSD-OSA-V1.5,
        datatype:OSD-SLC-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/domain/> .

datatype:OSD-BAO-V1.5 a mkg:DataType ;
    mkg:acronym "OSD-BAO-V1.5" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/Core/Objects.cs> ;
    mkg:codePath "AIMs/Core/Objects.cs" ;
    mkg:description "" ;
    mkg:ofStandard standard:OSD ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/BasicAudioObject.json> ;
    mkg:sourceAI true ;
    mkg:title "Basic Audio Object V1.5" ;
    mkg:uses <https://mpai.community/kg/datatype/CAE3/AcousticProfile>,
        datatype:OSD-IID-V1.5,
        datatype:OSD-OPV-V1.5,
        datatype:OSD-SPT-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0,
        datatype:TFA-AUQ-V1.5 ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/data-types/basic-audio-object/> .

datatype:PGM-UCC-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-UCC-V1.0" ;
    mkg:description "The Data Type exchanged between A-User Control (AUC) and Context Description (CXT). It has two modes, told apart by Mode: Request (RQ), sent by AUC to CXT (previously CXT Directive), and Response (RS), sent by CXT to AUC (previously CXT Status). Context Description is an executor AIM: A-User Control drives the capture and the processing of each medium (Audio, Visual, Text, Speech) and of the User, at property level, whether Context Description is Basic or Composite, and the Response reports the outcome per medium and per property and, where a goal could not be met, the world condition that prevented it. Every Request is answered by a Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/AUCCXT.json> ;
    mkg:sourceAI true ;
    mkg:title "AUC-CXT V1.0" ;
    mkg:uses datatype:OSD-OSA-V1.5,
        datatype:OSD-SLC-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-cxt/> .

datatype:OSD-BVO-V1.5 a mkg:DataType ;
    mkg:acronym "OSD-BVO-V1.5" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/Core/Objects.cs> ;
