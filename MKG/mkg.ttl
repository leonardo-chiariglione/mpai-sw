aim:MMC-MCA-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MCA-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Conversation Avatar: the HCI Module for anonymous dialogue with a Portable Avatar (no identity, no Identity Reconciliation, no Personal Status). Automatic Speech Recognition recognises the human's speech into text, or the human types it; Entity Dialogue Processing produces the machine's response Text (the Summary of the conversation is internal to it); Text-to-Speech gives the response its Machine Speech, Generative Face Description the lip-synced Machine Face Descriptors, and Portable Avatar Multiplexing combines Speech, Text, Face Descriptors, Avatar Model and Machine ID into the Portable Avatar." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/12>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/13>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/14>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MCA-V2.5/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/port/Output/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-MCA-V2.5/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalConversationAvatar.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-TTS-V2.5,
        aim:PAF-GFD-V1.6,
        aim:PAF-PMX-V1.6 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/multimodal-conversation-avatar/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-MTS-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MTS-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Translation Service: the HCI Module for spoken translation with a Portable Avatar. Automatic Speech Recognition recognises the human's speech into text; Text-to-Text Translation translates it into the language named by the Language Selector; Text-To-Speech makes the Speech Object of the translation; Portable Avatar Multiplexing puts the translation, text and speech, in the Portable Avatar, which the User Agent renders. The translated text is also exposed. Non-affective; no Personal Status is supplied. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MTS-V2.5/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/port/Input/OSD-SEL-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MTS-V2.5/port/Input/string/0>,
