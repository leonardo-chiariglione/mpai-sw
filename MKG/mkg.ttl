aim:MMC-SOE-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-SOE-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/MMC/V2.5/SOE/SoeAimProcessor.cs> ;
    mkg:codePath "AIMs/MMC/V2.5/SOE/SoeAimProcessor.cs" ;
    mkg:description "Speech Object Editing. One Speech Object is open at a time: the Speech Object that the User Command gives (AcquiredObject), in full or by its name, is opened - from Shared Storage - or kept. The User Command changes where it is heard from (UserPoV) and its Speech Qualifier or Spatial Attitude (ChangedObjects), and has it translated (TranslatedObjects): the Speech and a Language Selector go to Text and Speech Translation, and the Translation, when it comes back, replaces the original under its identifier - so every Speech Scene holding it holds the translation, at its place. Outputs: the open Speech Object, to the Module and to Speech Scene Editing, and the User Command, with its response (UserCommandRS) saying how each action was executed (for a translation, when it is done)." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-SOE-V2.5/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/MMC-SOE-V2.5/port/Input/OSD-BSO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-SOE-V2.5/port/Output/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/MMC-SOE-V2.5/port/Output/OSD-BSO-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-SOE-V2.5/port/Output/OSD-SEL-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SOE-V2.5/port/Output/OSD-SPO-V1.5/1> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/SpeechObjectEditing.json> ;
    mkg:sourceAI true ;
    mkg:title "Speech Object Editing V2.5" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/speech-object-editing/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/speech-object-editing/> .

