aim:MMC-AMC-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-AMC-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Affective Multimodal Conversation: speech-only affective dialogue. Automatic Speech Recognition recognises the speech; Natural Language Understanding produces the Text Descriptors, the (refined) NLU Text and the Text Personal Status; Personal Status Extraction reads the Speech Personal Status from the Speech Object and multiplexes it with the Text Personal Status into the entity's Personal Status; Entity Dialogue Processing produces the machine's response Text and Personal Status, aware of both the meaning and the feeling; Response and Scene Rendering renders the Portable Avatar. The Summary of the conversation is internal to Entity Dialogue Processing. Acquisition and delivery are the User Agent, not sub-AIMs." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/12>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/13>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/14>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/15>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-AMC-V2.5/port/Input/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/port/Output/MMC-SUM-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-AMC-V2.5/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/AffectiveMultimodalConversation.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-NLU-V2.5,
        aim:MMC-PSE-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/affective-multimodal-conversation/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

