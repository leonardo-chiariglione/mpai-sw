        <https://mpai.community/kg/aim/MMC-NPR-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-NPR-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/port/Input/OSD-PNT-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/NewspaperReading.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-CTS-V2.5,
        aim:MMC-OCR-V2.5,
        aim:MMC-TTS-V2.5,
        aim:PAF-PMX-V1.6 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/newspaper-reading/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/> .

aim:MMC-TSD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-TSD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Text-to-Speech with Descriptors: speaks a Text Object with the voice that the Speech Descriptors Object describes, and gives the Speech Object. The Selector tells whether the output Speech retains the input Speech Descriptors. The Speech Descriptors Object is what Entity Speech Description gives from the speech of an Entity; its Qualifier says which descriptors it holds." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-TSD-V2.5/port/Input/MMC-SDO-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-TSD-V2.5/port/Input/OSD-BTO-V1.5/0>,
