        <https://mpai.community/kg/aim/PGM-AMP-V1.0/port/Output/PGM-DOM-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-AMP-V1.0/port/Output/PGM-UCC-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/AudioMotionandProximity.json> ;
