<https://mpai.community/kg/aim/MAS/MASApp> a mkg:AIM ;
    mkg:acronym "MAS/MASApp" ;
    mkg:apiProfile "Basic" ;
    mkg:description "MPAI as a Service App: the Module over which the MPAI-MAS workflow runs, letting a User Agent that has not yet chosen an App speak to the person through a Portable Avatar. Response and Scene Rendering renders the Text the User Agent supplies into Machine Speech and Machine Face Descriptors; Automatic Speech Recognition gives as Text the person's spoken reply to a question the Module asked." ;
    mkg:flow <https://mpai.community/kg/aim/MAS/MASApp/flow/1>,
        <https://mpai.community/kg/aim/MAS/MASApp/flow/2>,
        <https://mpai.community/kg/aim/MAS/MASApp/flow/3>,
        <https://mpai.community/kg/aim/MAS/MASApp/flow/4>,
        <https://mpai.community/kg/aim/MAS/MASApp/flow/5>,
        <https://mpai.community/kg/aim/MAS/MASApp/flow/6>,
        <https://mpai.community/kg/aim/MAS/MASApp/flow/7> ;
    mkg:noAcronym true ;
    mkg:ofStandard standard:MAS ;
    mkg:port <https://mpai.community/kg/aim/MAS/MASApp/port/Input/MMC-EPS-V2.5/0>,
        <https://mpai.community/kg/aim/MAS/MASApp/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/MAS/MASApp/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MAS/MASApp/port/Input/OSD-BTO-V1.5/0>,
