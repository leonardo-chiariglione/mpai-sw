aim:CAE-EAE-V2.5 a mkg:AIM ;
    mkg:acronym "CAE-EAE-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/CAE1/V2.5/EAE/AmxAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE1/V2.5/EAE/AmxAimProcessor.cs" ;
    mkg:description "Improves the audio quality of a teleconference by describing the sound field, detecting and separating the speech sources, cancelling the noise and describing the resulting Audio Scene." ;
    mkg:flow <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/1>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/10>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/2>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/3>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/4>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/5>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/6>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/7>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/8>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/flow/9> ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-EAE-V2.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-EAE-V2.5/port/Output/OSD-BAS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE1/V2.5/AIMs/EnhancedAudioconferenceExperience.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CAE-AMX-V2.5,
        aim:CAE-AST-V2.5,
        aim:CAE-NCM-V2.5,
        aim:CAE-SDS-V2.5,
        aim:CAE-SFD-V2.5,
        aim:CAE-SFT-V2.5 ;
    mkg:title "Enhanced Audioconference Experience V2.5" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/enhanced-audioconference-experience/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/enhanced-audioconference-experience/> .

