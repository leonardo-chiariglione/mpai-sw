    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-CAS-V2.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-CAS-V2.5/port/Input/OSD-BVO-V1.5/0>,
