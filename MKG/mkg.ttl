aim:OSD-BOS-V1.5 a mkg:AIM ;
    mkg:acronym "OSD-BOS-V1.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Basic Offline Map Scene Description: describes the acquired BasicOfflineMapObject as BasicOfflineMapSceneDescriptors. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in CAV-HCI. It neither raises an Alert nor takes a prior: EnvironmentSensingSubsystem.json wires neither to the offline map, a stored map having nothing to react to and nothing to gain from the previous cycle." ;
    mkg:ofStandard standard:OSD ;
    mkg:port <https://mpai.community/kg/aim/OSD-BOS-V1.5/port/Input/OSD-BOO-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BOS-V1.5/port/Input/OSD-OSA-V1.5/0>,
        <https://mpai.community/kg/aim/OSD-BOS-V1.5/port/Output/OSD-BOS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/AIMs/BasicOfflineMapSceneDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-osd/v1-5/ai-modules/basic-offline-map-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-osd/v1-5/> .

