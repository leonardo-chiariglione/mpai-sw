    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/UserStateRefinement.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:PGM-ENG-V1.0,
        aim:PGM-ESR-V1.0,
        aim:PGM-USY-V1.0 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/user-state-refinement> ;
    mkg:webSpec <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/user-state-refinement/> .

datatype:PGM-UCP-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-UCP-V1.0" ;
    mkg:description "The Data Type exchanged between A-User Control (AUC) and Personality Alignment (PAL). It has two modes, told apart by Mode: Request (RQ), sent by AUC to PAL (previously PAL Directive), and Response (RS), sent by PAL to AUC (previously PAL Status). Personality Alignment is a reasoning AIM: it decides the stance of the A-User and says whether, and how far, it adopted the correction proposed by AUC according to its Weight. A-User Control directs the constraints and the evidence it may use, whether it is Basic or Composite. Every Request is answered by a Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/AUCPAL.json> ;
    mkg:sourceAI true ;
    mkg:title "AUC-PAL V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-pal/> .

