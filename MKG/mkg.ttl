        <https://mpai.community/kg/aim/MMC-STD-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-STD-V2.5/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/port/Input/OSD-SEL-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/port/Input/OSD-SEL-V1.5/2>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/port/Input/OSD-SEL-V1.5/3>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/port/Input/OSD-SPO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/port/Input/OSD-TXO-V1.5/1>,
