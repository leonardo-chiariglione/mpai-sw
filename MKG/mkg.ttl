aim:CAE-ASD-V2.5 a mkg:AIM ;
    mkg:acronym "CAE-ASD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Describes an Audio Scene in terms of its composing Audio Objects. The Audio Scene Descriptors input, if present, comes from AIMs of other standards and is not used by the SubAIMs of this Module." ;
    mkg:flow <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/1>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/2>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/3>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/4>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/5>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/6>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/7>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/8>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/flow/9> ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-ASD-V2.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/port/Input/OSD-SPT-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-ASD-V2.5/port/Output/OSD-BAS-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE1/V2.5/AIMs/AudioSceneDescription.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CAE-AMX-V2.5,
        aim:CAE-ASE-V2.5,
        aim:CAE-ASL-V2.5,
        aim:CAE-AST-V2.5,
        aim:CAE-SFT-V2.5 ;
    mkg:title "Audio Scene Description V2.5" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/audio-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/audio-scene-description/> .

