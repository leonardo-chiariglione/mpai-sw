aim:NNW-DWI-V2.0 a mkg:AIM ;
    mkg:acronym "NNW-DWI-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "During-Training Watermark Insertion: inserts the payload in a neural network model while it trains it with a training dataset, and gives the watermarked model. Where a Locator is given, it tells the AIM where the watermark is to be placed and by which method; the AIM does not give it back. Where the watermark cannot be placed there, it gives no model and reports why." ;
    mkg:ofStandard standard:NNW ;
    mkg:port <https://mpai.community/kg/aim/NNW-DWI-V2.0/port/Input/AIP-MLO-V1.0/0>,
        <https://mpai.community/kg/aim/NNW-DWI-V2.0/port/Input/NNW-DST-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-DWI-V2.0/port/Input/NNW-KEY-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-DWI-V2.0/port/Input/NNW-PLD-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-DWI-V2.0/port/Input/NNW-WLC-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-DWI-V2.0/port/Output/AIP-MLO-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/NNW1/V2.0/AIMs/DuringTrainingWatermarkInsertion.json> ;
    mkg:sourceAI true ;
    mkg:title "During-Training Watermark Insertion V2.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-nnw/nnt/v1-2/> .

aim:NNW-PWI-V2.0 a mkg:AIM ;
    mkg:acronym "NNW-PWI-V2.0" ;
    mkg:apiProfile "/* Basic | Secure: Secure where the method uses a secret key (Security API) */" ;
    mkg:description "Post-Training Watermark Insertion: inserts the payload in an already trained neural network model, without training it again. It gives the watermarked model, a new ML Model Object of the same format and Qualifier as the model it was given. Where a Locator is given, the payload is inserted where it says and by the method it names; the AIM does not give the Locator back. Where the payload does not fit there, or the format of the model is not one it supports, it gives no model and reports why." ;
    mkg:ofStandard standard:NNW ;
    mkg:port <https://mpai.community/kg/aim/NNW-PWI-V2.0/port/Input/AIP-MLO-V1.0/0>,
        <https://mpai.community/kg/aim/NNW-PWI-V2.0/port/Input/NNW-KEY-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-PWI-V2.0/port/Input/NNW-PLD-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-PWI-V2.0/port/Input/NNW-WLC-V2.0/0>,
        <https://mpai.community/kg/aim/NNW-PWI-V2.0/port/Output/AIP-MLO-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/NNW1/V2.0/AIMs/PostTrainingWatermarkInsertion.json> ;
    mkg:sourceAI true ;
    mkg:title "Post-Training Watermark Insertion V2.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-nnw/nnt/v1-2/> .

aim:NNW-WEX-V2.0 a mkg:AIM ;
    mkg:acronym "NNW-WEX-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Watermark Extraction: retrieves the payload inserted in a neural network model, which may have been modified after the insertion, and gives the retrieved payload." ;
    mkg:ofStandard standard:NNW ;
    mkg:port <https://mpai.community/kg/aim/NNW-WEX-V2.0/port/Input/AIP-MLO-V1.0/0>,
