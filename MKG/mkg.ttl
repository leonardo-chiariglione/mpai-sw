aim:PGM-VSD-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-VSD-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The Visual Scene Description (PGM-VSD) AIM receives a Visual Object and produces the Visual Scene Descriptors describing it. In the PGM-AUA context, the AIM operates under the control of a Visual CXT Request issued by A-User Control (through the CXT-AUS Interface) and reports a Visual CXT Response on completion. The AIM references the Input and Output Data Types by name; their structure is specified by the respective Data Type definitions." ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-VSD-V1.0/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-VSD-V1.0/port/Input/PGM-UCC-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-VSD-V1.0/port/Output/OSD-BVS-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-VSD-V1.0/port/Output/PGM-UCC-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/VisualSceneDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/visual-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/visual-scene-description/> .

