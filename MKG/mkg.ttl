    mkg:apiProfile "Basic" ;
    mkg:description "The Automatic Speech Recognition (PGM-ASR) AIM extracts the text conveyed by an utterance and derives the paralinguistic features of the speech signal. The input speech may be accompanied by an auxiliary text, the identifier of the speaker, the Speech Overlap data type, and the time indicating the portion of the input speech that should be recognised. Operation is governed by the User CXT Request, which specifies scope, depth, and policy constraints. Processing outcome is reported via the User CXT Response. Domain knowledge and interaction history may be queried by issuing User Domain and User" ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/MMC-SOL-V2.5/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/OSD-IID-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/OSD-SEL-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/OSD-STM-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/PGM-DOM-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/PGM-IHI-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Input/PGM-UCC-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Output/MMC-SDO-V2.5/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Output/PGM-DOM-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Output/PGM-IHI-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-ASR-V1.0/port/Output/PGM-UCC-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/AutomaticSpeechRecognition.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/automatic-speech-recognition/> ;
