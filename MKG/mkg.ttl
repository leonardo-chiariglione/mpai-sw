datatype:PGM-HCM-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-HCM-V1.0" ;
    mkg:description "The Data Type with which the human responsible for the A-User influences its behaviour, state or decision-making, and with which A-User Control reports the outcome. It has two modes, told apart by Mode: Request (RQ), the Human Command, an authenticated instruction, structured or expressed with audio, text or visual media, that may trigger the execution of an action, override logic, escalation or the reconfiguration of an AIM; and Response (RS), the Human Command Status, produced by A-User Control after processing a Human Command, that reports the outcome (accepted, rejected, escalated or ignored), the lifecycle transition, the AIMs affected and the override report. A Response carries the identifier of the Request it answers." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/HumanCommand.json> ;
    mkg:sourceAI true ;
    mkg:title "Human Command V1.0" ;
    mkg:uses datatype:OSD-BAO-V1.5,
        datatype:OSD-BSO-V1.5,
        datatype:OSD-BTO-V1.5,
        datatype:OSD-BVO-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/human-command/> .

datatype:PGM-UCK-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-UCK-V1.0" ;
    mkg:description "The Data Type exchanged between A-User Control (AUC) and Basic Knowledge (BKN). It has two modes, told apart by Mode: Request (RQ), sent by AUC to BKN (previously BKN Directive), and Response (RS), sent by BKN to AUC (previously BKN Status). Basic Knowledge is a reasoning AIM and is not Composite: it decides its own conclusion, and says whether it adopted the correction proposed by AUC. AUC may ask it to propose Process Actions in addition to the Final Response; the Final Response and the Process Actions are sent on its output Ports and the Response only reports them. Every Request is answered by a Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/AUCBKN.json> ;
    mkg:sourceAI true ;
    mkg:title "AUC-BKN V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PGM-CFN-V1.0,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-bkn/> .

datatype:PGM-UCS-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-UCS-V1.0" ;
    mkg:description "The Data Type exchanged between A-User Control (AUC) and the Private Storage of the Module, through the Controller. It has two modes, told apart by Mode: Request (RQ), sent by AUC, which establishes for an A-User session the storage scopes, the retention and life cycle policy and the access rights that Private Storage enforces; and Response (RS), sent by Private Storage, which reports the outcome of the life cycle command, the operations served, the enforcement of the access rights and retention, and the integrity and capacity of the storage. Every Request is answered by a Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/AUCAUS.json> ;
    mkg:sourceAI true ;
    mkg:title "AUC-AUS V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-aus/> .

