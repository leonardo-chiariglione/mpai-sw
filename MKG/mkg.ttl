        <https://mpai.community/kg/aim/CAE-SFR-V1.0/port/Output/CAE-TRI-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/SoundFieldRotation.json> ;
    mkg:sourceAI true ;
    mkg:title "Sound Field Rotation V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

