datatype:MMC-BPS-V2.5 a mkg:DataType ;
    mkg:acronym "MMC-BPS-V2.5" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/Core/OSD/PersonalStatus.cs> ;
    mkg:codePath "AIMs/Core/OSD/PersonalStatus.cs" ;
    mkg:description "Personal Status of the Body modality: the Cognitive State, Emotion, and Social Attitude Factors carried by the body. None is required; at least one shall be present. Note: gesture, in all its forms, is a subset of the body, so the Personal Status of a gesture is carried here, as a Body Personal Status." ;
    mkg:ofStandard standard:MMC ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/data/BodyPersonalStatus.json> ;
    mkg:sourceAI true ;
    mkg:title "Body Personal Status V2.5" ;
    mkg:uses datatype:MMC-ECS-V2.5,
        datatype:MMC-EEM-V2.5,
        datatype:MMC-ESA-V2.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/data-types/body-personal-status/> .

datatype:MMC-EEM-V2.5 a mkg:DataType ;
    mkg:acronym "MMC-EEM-V2.5" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/Core/OSD/PersonalStatus.cs> ;
    mkg:codePath "AIMs/Core/OSD/PersonalStatus.cs" ;
    mkg:description "Emotion labels per MPAI-MMC: categories with general and specific adjectival labels, plus an optional Degree in [0,1]." ;
    mkg:ofStandard standard:MMC ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/data/Emotion.json> ;
    mkg:sourceAI true ;
    mkg:title "Emotion V2.5" ;
    mkg:uses datatype:OSD-SPT-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/data-types/emotion/> .

