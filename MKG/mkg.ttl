aim:CAV-HCI-V2.0 a mkg:AIM ;
    mkg:acronym "CAV-HCI-V2.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/CAV/V2.0/Hci/HciProvider.cs> ;
    mkg:codePath "AIMs/CAV/V2.0/Hci/HciProvider.cs" ;
    mkg:description "Human-CAV Interaction. The Audio, Visual and LiDAR Objects are described as Basic Audio, Visual and LiDAR Scenes and aligned (Audio-Visual Alignment). The objects of the aligned scenes are identified per modality: Audio and Visual Scene Object Identification separate speech and faces from other objects, which go to Speaker and Face Identity Recognition and to Audio and Visual Instance Identification respectively. The identities are reconciled (ID Reconciliation). The speech is recognised and understood (Automatic Speech Recognition, Natural Language Understanding), and the entity's Personal Status is extracted (Personal Status Extraction). Entity Dialogue Processing produces the machine's response aware of meaning, Personal Status, scene geometry and identity, and Response and Scene Rendering renders it as a Portable Avatar. The reconciled User ID and the recognised text are provided at the boundary." ;
    mkg:flow <https://mpai.community/kg/aim/CAV-HCI-V2.0/flow/1>,
        <https://mpai.community/kg/aim/CAV-HCI-V2.0/flow/10>,
