library:Steam_Audio a mkg:Library ;
    mkg:acronym "Steam Audio" ;
    mkg:alsoCode "AIF/UserAgent/UaKit/SpatialAudio/SteamAudio.cs",
        "Models/SteamAudio" ;
    mkg:codePath "Models/SteamAudio" ;
    mkg:description "Steam Audio (Valve), the library that renders spatial audio: binaural, with HRTF. The native library (phonon.dll on Windows, libphonon.so on Linux) is in Models/SteamAudio; AIF/UserAgent/UaKit/SpatialAudio/SteamAudio.cs declares its functions, SpatialRenderer.cs and AudioRendering.cs use them." ;
    mkg:notOnGitHub true ;
    mkg:webSpec <https://valvesoftware.github.io/steam-audio/> .

