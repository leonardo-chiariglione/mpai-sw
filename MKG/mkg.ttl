    mkg:description "Speak Model with Emotion (CAE-SME) of CAE-USC V2.5: gives emotionless speech the emotion of a model utterance by its prosody. Speech Feature Analysis 1 (CAE-SFA) extracts the prosodic features of the model utterance, selected by the Mode Selector, and Prosodic Emotion Insertion (CAE-PEI) applies them to the emotionless speech, with the Emotion List, and gives the Speech with Emotion." ;
    mkg:flow <https://mpai.community/kg/aim/CAE-SME-V2.5/flow/1>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/flow/2>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/flow/3>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/flow/4>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/flow/5>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/flow/6> ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-SME-V2.5/port/Input/MMC-EEM-V2.5/1>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/port/Input/OSD-BSO-V1.5/2>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/port/Input/OSD-SEL-V1.5/1>,
        <https://mpai.community/kg/aim/CAE-SME-V2.5/port/Output/OSD-BSO-V1.5/1> ;
    mkg:schema <https://schemas.mpai.community/CAE1/V2.5/AIMs/SpeakModelWithEmotion.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CAE-PEI-V2.5,
        aim:CAE-SFA-V2.5 ;
    mkg:title "Speak Model with Emotion V2.5" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/speak-model-with-emotion/> .

