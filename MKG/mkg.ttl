datatype:UNT-ASD-V1.0 a mkg:DataType ;
    mkg:acronym "UNT-ASD-V1.0" ;
    mkg:description "What the Implementer of an Actuation Unit declares for its vehicle: the safe state it takes the vehicle to, when it does so, and the limits it keeps. The Unit shall have a declaration, and none of the required properties may be omitted: the safety rules of the Unit are fixed by its Specification, the values are the Implementer's." ;
    mkg:ofStandard standard:UNT ;
    mkg:schema <https://schemas.mpai.community/UNT/V1.0/data/ActuationSafety.json> ;
    mkg:sourceAI true ;
    mkg:title "Actuation Safety Declaration V1.0" .

