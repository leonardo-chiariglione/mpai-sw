datatype:PGM-UCD-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-UCD-V1.0" ;
    mkg:description "The Data Type exchanged between A-User Control (AUC) and Domain Access (DAC). It has two modes, told apart by Mode: Request (RQ), sent by AUC to DAC (previously DAC Directive), and Response (RS), sent by DAC to AUC (previously DAC Status). Domain Access provides domain semantics for capture-level grounding and for reasoning, without perception or reasoning of its own. A-User Control drives it at operation level and may ask it to validate the feasibility of an intended behaviour. A failure of an external source is reported so that AUC can decide. Every Request is answered by a Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/AUCDAC.json> ;
    mkg:sourceAI true ;
    mkg:title "AUC-DAC V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-dac/> .

datatype:PGM-UCU-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-UCU-V1.0" ;
    mkg:description "The Data Type exchanged between A-User Control (AUC) and User State Refinement (USR). It has two modes, told apart by Mode: Request (RQ), sent by AUC to USR (previously USR Directive), and Response (RS), sent by USR to AUC (previously USR Status). User State Refinement is a reasoning AIM: it decides its own conclusion, and says whether it adopted the correction proposed by AUC. A-User Control directs the evidence it may use and the properties it produces, whether it is Basic or Composite. Every Request is answered by a Response." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/AUCUSR.json> ;
    mkg:sourceAI true ;
    mkg:title "AUC-USR V1.0" ;
    mkg:uses datatype:MMC-EST-V2.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-usr/> .

aim:PGM-AUC-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-AUC-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/PGM/V1.0/AucAim.cs> ;
    mkg:codePath "AIMs/PGM/V1.0/AucAim.cs" ;
    mkg:description "The A-User Control (PGM-AUC) AIM serves as the central coordinator for Action execution, AIM orchestration, and system traceability. It governs the lifecycle of the A-User and orchestrates its interactions with the responsible human, the M-Instance, and the Processes and Items with which the A-User interacts. A-User Control holds goal authority but not necessarily epistemic capability: it carries the objectives given to it by the responsible human or by specification, and it asserts those objectives authoritatively. It it does not itself understand the environment or the User because that unde" ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-AUC-V1.0/port/Input/MMM-PAC-V2.2/0>,
        <https://mpai.community/kg/aim/PGM-AUC-V1.0/port/Input/MMM-PAT-V2.2/0>,
