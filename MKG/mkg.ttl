aim:PGM-VSM-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-VSM-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The Visual Salience Mapping (PGM-VSM) AIM is a Sub-AIM of Visual Scene Enhancement (PGM-VSE). It determines the relative perceptual importance of Visual Objects with respect to user interaction and context, and produces the Salient Object Matrix. Each Sub-AIM of Visual Scene Enhancement independently generates a Visual CXT Response, a Visual Domain Request and a Visual Interaction History Request. Visual Enhancement Multiplexing multiplexes them into the corresponding external output signals of Visual Scene Enhancement. [High-level specification derived from the Visual Scene Enhancement page. " ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Input/OSD-AFT-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Input/OSD-BVS-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Input/OSD-IAP-V1.5/0>,
