datatype:NNW-KEY-V2.0 a mkg:DataType ;
    mkg:acronym "NNW-KEY-V2.0" ;
    mkg:description "The key with which a watermark is inserted in a neural network and extracted from it: a sequence of real numbers, in single or double precision." ;
    mkg:ofStandard standard:NNW ;
    mkg:schema <https://schemas.mpai.community/NNW1/V2.0/data/Key.json> ;
    mkg:sourceAI true ;
    mkg:title "Key V2.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 .

datatype:NNW-WLC-V2.0 a mkg:DataType ;
    mkg:acronym "NNW-WLC-V2.0" ;
    mkg:description "Where a watermark sits in a neural network model, and by which method it was inserted. It is neither part of the model (AIP-MLO) nor of the Payload (NNW-PLD): an insertion AIM and an extraction AIM may take it, and neither gives it: it stays with the party that decides where the watermark is placed. An insertion AIM that is not given a Locator places the watermark where its own method puts it, and an extraction AIM that is not given one looks for it there. It never carries a secret key, only a reference to one." ;
    mkg:ofStandard standard:NNW ;
    mkg:schema <https://schemas.mpai.community/NNW1/V2.0/data/Locator.json> ;
    mkg:sourceAI true ;
    mkg:title "Locator V2.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 .

