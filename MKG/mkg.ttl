aim:HMC-ECU-V2.2 a mkg:AIM ;
    mkg:acronym "HMC-ECU-V2.2" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Entity and Context Understanding: Automatic Speech Recognition recognises the Speech Object; Natural Language Understanding produces the Text Descriptors and the Refined Text; Personal Status Extraction gives the Personal Status of the Entity from the Face, Body, Speech and Text Objects; Entity Body Description gives the Body Descriptors of the Body Object; Visual Object Identification gives the Visual Instance ID and the Entity ID from the Body Descriptors, the Visual Objects and the Visual Scene Descriptors; Audio Instance Identification gives the Audio Instance ID from the Audio Objects and the Audio Scene Descriptors; Multimodal Scene Multiplexing combines the Visual and the Audio Scene Descriptors into the Multimodal Scene Descriptors." ;
    mkg:flow <https://mpai.community/kg/aim/HMC-ECU-V2.2/flow/1>,
        <https://mpai.community/kg/aim/HMC-ECU-V2.2/flow/10>,
        <https://mpai.community/kg/aim/HMC-ECU-V2.2/flow/11>,
