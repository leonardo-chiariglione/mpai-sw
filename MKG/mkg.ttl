aim:PGM-PAL-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-PAL-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/PGM/V1.0/ContextAims.cs> ;
    mkg:codePath "AIMs/PGM/V1.0/ContextAims.cs" ;
    mkg:description "The Personality Alignment (PGM-PAL) AIM decides the stance the A-User should adopt and produces the A-User State that the A-User Formation AIM renders. It is a reasoning AIM: knowing how the User feels and the context of the interaction, it judges what stance is appropriate for the A-User, which is not the same as mirroring the User. If the User laughs, the A-User laughing may be appropriate in a pub but improper in a church; the Personality Alignment AIM makes that judgement. To make it, the Personality Alignment AIM needs two things only: the User's internal state and the context. It receive" ;
    mkg:flow <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/1>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/10>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/11>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/12>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/13>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/2>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/3>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/4>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/5>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/6>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/7>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/8>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/flow/9> ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-PAL-V1.0/port/Input/MMC-EST-V2.5/0>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/port/Input/PGM-IHI-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/port/Input/PGM-KPA-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/port/Input/PGM-UCP-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/port/Output/MMC-EST-V2.5/0>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/port/Output/PGM-IHI-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/port/Output/PGM-KPA-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-PAL-V1.0/port/Output/PGM-UCP-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/PersonalityAlignment.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:PGM-ASC-V1.0,
        aim:PGM-CXR-V1.0,
        aim:PGM-DEX-V1.0,
        aim:PGM-STS-V1.0 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/personality-alignment> ;
