aim:CAE-ISF-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-ISF-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Inverse Short-Time Fourier Transform (CAE-ISF) of CAE-6DF V1.0: Reconstructs the spatial audio channels from the time-frequency domain back into discrete time-domain waveforms utilizing an overlap-add (OLA) synthesis method with parameters matching the STFT." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-ISF-V1.0/port/Input/CAE-DWR-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-ISF-V1.0/port/Input/CAE-FDI-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-ISF-V1.0/port/Input/CAE-IFD-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-ISF-V1.0/port/Output/CAE-TDI-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-ISF-V1.0/port/Output/CAE-TDS-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/InverseShortTimeFourierTransform.json> ;
    mkg:sourceAI true ;
    mkg:title "Inverse Short-Time Fourier Transform V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CAE-PWS-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-PWS-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Plane Wave Synthesis (CAE-PWS) of CAE-6DF V1.0: The PWS AIM reconstructs a continuous physical sound field at the user's virtual coordinates by synthesizing discrete directional plane waves from the interpolated parameters provided by the PWI. These synthesized plane waves are mathematically projected onto target rendering formats." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-PWS-V1.0/port/Input/CAE-ISW-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-PWS-V1.0/port/Output/CAE-IFD-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/PlaneWaveSynthesis.json> ;
    mkg:sourceAI true ;
    mkg:title "Plane Wave Synthesis V1.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CAE-SFD-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-SFD-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Sound Field Description (CAE-SFD) of CAE-6DF V1.0: HOA to SHD transformation" ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-SFD-V1.0/port/Input/OSD-AUO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-SFD-V1.0/port/Output/CAE-STC-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/SoundFieldDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "Sound Field Description V1.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/sound-field-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CAE-SFT-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-SFT-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Short-Time Fourier Transform (CAE-SFT) of CAE-6DF V1.0: The SFT AIM takes Audio Objects represented in the time domain as input and outputs Audio Objects in the frequency domain. The SFT uses a Hann window of length N = 2048 with and overlap size of 7/8 N between blocks of data and performs an FFT." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-SFT-V1.0/port/Input/OSD-AUO-V1.5/0>,
        <https://mpai.community/kg/aim/CAE-SFT-V1.0/port/Output/OSD-AUO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/ShortTimeFourierTransform.json> ;
    mkg:sourceAI true ;
    mkg:title "Short-Time Fourier Transform V1.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/usc/v2-5/ai-modules/short-time-fourier-transform/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

aim:CVE-DVI-V1.0 a mkg:AIM ;
    mkg:acronym "CVE-DVI-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Direct Visual Identification: identifies the Visual Object that a person indicates by pointing. It receives a Basic Visual Object and describes its scene (Basic Multimodal Scene Description); Multimodal Scene Demultiplexing gives the Visual Objects of the scene; Entity Body Description gives the Body Descriptors of the person; Visual Direction Identification finds the Point of View that the pointing body indicates; Visual Object Extraction extracts the Visual Object that the Point of View crosses; and Visual Instance Identification gives the Instance Identifier of that object." ;
    mkg:flow <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/1>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/10>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/2>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/3>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/4>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/5>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/6>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/7>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/8>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/flow/9> ;
    mkg:ofStandard standard:CVE ;
    mkg:port <https://mpai.community/kg/aim/CVE-DVI-V1.0/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/CVE-DVI-V1.0/port/Output/OSD-IID-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CVE/V1.0/AIMs/DirectVisualIdentification.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CVE-VDI-V1.0,
        aim:CVE-VII-V1.0,
        aim:OSD-BMS-V1.5,
        aim:OSD-MDX-V1.5,
        aim:OSD-VOE-V1.5,
        aim:PAF-EBD-V1.6 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-cve/v1-0/ai-modules/direct-visual-identification/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cve/v1-0/ai-modules/direct-visual-identification/> .

aim:MMC-QAM-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-QAM-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Question Analysis Module: analyses the Text Descriptors Object of a question (the former Meaning) and gives its Intention - what is being asked: the topic, the focus, the lexical and the semantic answer type and the domain of the question. Ports as the composite MMC-MQA (slide 16 of the MMC Reference Models) uses it; the AIM has no slide of its own." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-QAM-V2.5/port/Input/MMC-TDO-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-QAM-V2.5/port/Output/MMC-INT-V2.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/QuestionAnalysisModule.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/question-analysis-module/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:XRV-ACG-V1.0 a mkg:AIM ;
    mkg:acronym "XRV-ACG-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/XRV1/V1.0/ACG/Acg.cs> ;
    mkg:codePath "AIMs/XRV1/V1.0/ACG/Acg.cs" ;
    mkg:description "The Action Generation (XRV-ACG) AIM uses Performance Status, Participant Status, and Operator Status to produce the RE Action IDs and VE Action IDs that instantiate Actions from the Action Table in the RE Experience Generation and VE Experience Generation AIMs per the Script, and the next Cue Point ID that informs the Performance, Participant, and Operator Status Interpretation AIMs to look for the next Cue Conditions." ;
    mkg:ofStandard standard:XRV ;
    mkg:port <https://mpai.community/kg/aim/XRV-ACG-V1.0/port/Input/XRV-ATB-V1.0/0>,
