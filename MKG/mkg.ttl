<https://mpai.community/kg/datatype/CAE3/AcousticProfile> a mkg:DataType ;
    mkg:acronym "CAE3/AcousticProfile" ;
    mkg:description "The acoustics of an Object or of a Scene. An Object's: its frequency range, spectrogram, loudness and directional patterns (#/$defs/Object). A Scene's: its reflectivity, reverberation, diffusion, absorption and Doppler effect (#/$defs/Scene). A Data Type refers to the one it has." ;
    mkg:noAcronym true ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/data/AcousticProfile.json> ;
    mkg:sourceAI true ;
    mkg:title "Acoustic Profile V1.0" ;
    mkg:uses datatype:OSD-MTR-V1.5,
        datatype:OSD-PLT-V1.5,
        datatype:OSD-RPP-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 .

datatype:MMC-EIT-V2.5 a mkg:DataType ;
    mkg:acronym "MMC-EIT-V2.5" ;
    mkg:description "An Entity’s goal-directed purpose, e.g., an attempt to do something, or an utterance representing a request or an assessment. It can be accompanied by modifiers like urgency and can be either inferred from observation of an Entity or assigned to a virtual Entity." ;
    mkg:ofStandard standard:MMC ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/data/Intent.json> ;
    mkg:sourceAI true ;
    mkg:title "Intent V2.5" ;
