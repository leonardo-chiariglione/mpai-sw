        <https://mpai.community/kg/aim/MMC-AQM-V2.5/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AQM-V2.5/port/Input/OSD-IID-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AQM-V2.5/port/Output/OSD-BTO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/AnswerToQuestionModule.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/answer-to-question-module/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/> .

aim:MMC-MQA-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-MQA-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Multimodal Question Answering (slide 16 of the MMC Reference Models): answers a question about a visual object, put as a Text Object or as speech, with a Portable Avatar. Visual Instance Identification (CVE-VII) gives the Instance Identifier of the object, Automatic Speech Recognition the text of a spoken question, Natural Language Understanding the Refined Text and the Text Descriptors Object (the former Meaning), Question Analysis the Intention, Answer to Question the Machine Text, and Portable Avatar Multiplexing the Portable Avatar, which needs the ID of the machine." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/12>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/13>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/14>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-MQA-V2.5/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/port/Input/OSD-SEL-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/MMC-MQA-V2.5/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/MultimodalQuestionAnswering.json> ;
