aim:MMC-CTS-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-CTS-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/MMC/V2.5/CTS/CtsAimProcessor.cs> ;
    mkg:codePath "AIMs/MMC/V2.5/CTS/CtsAimProcessor.cs" ;
    mkg:description "Column Text Selection. Receives the lines of a page as a Text Object (each line a Basic Text Object with its box, in the pixels of the page) and, when the person has pointed, the Point at the top of a column; produces the text of that column as a Basic Text Object: the lines under the point that overlap it horizontally, down to the column's end (a wide gap, a much taller line, or no line left), a word hyphenated across lines joined. With no Point, the first column under the headline." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-CTS-V2.5/port/Input/OSD-PNT-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-CTS-V2.5/port/Input/OSD-TXO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-CTS-V2.5/port/Output/OSD-BTO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/ColumnTextSelection.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/column-text-selection/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/column-text-selection/> .

aim:MMC-NPR-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-NPR-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Newspaper Reader: receives the image of a newspaper page and, when the person has pointed at the top of a column, the Point; returns the text of that column as a Portable Avatar, which reads it. Optical Character Recognition finds the lines of a band of the page about the Point; Column Text Selection takes the text of the column; Text-To-Speech makes the Speech Object of the text; Portable Avatar Multiplexing puts the text and the speech in the Portable Avatar, which the User Agent renders." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-NPR-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-NPR-V2.5/flow/5>,
