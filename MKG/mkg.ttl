aim:MMC-STD-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-STD-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Speech Translation with Descriptors: translates a Speech Object into the language that the Language Selector names and gives the translated Speech Object in the voice of the input speech, and the translated Text Object. Automatic Speech Recognition recognises the speech; Entity Speech Description describes the voice; Text-to-Text Translation translates the text; Text-to-Speech with Descriptors speaks the translation with the voice described. There is no direct speech-to-speech translation." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-STD-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-STD-V2.5/flow/11>,
