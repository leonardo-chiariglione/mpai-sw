aim:PGM-ASD-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-ASD-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/PGM/V1.0/AudioEvents.cs> ;
    mkg:codePath "AIMs/PGM/V1.0/AudioEvents.cs" ;
    mkg:description "The Audio Scene Description (PGM-ASD) AIM receives an Audio Object and produces the Audio Scene Descriptors describing it. In the PGM-AUA context, the AIM operates under the control of an Audio CXT Request issued by A-User Control (through the CXT-AUS Interface) and reports an Audio CXT Response on completion. The AIM references the Input and Output Data Types by name; their structure is specified by the respective Data Type definitions." ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-ASD-V1.0/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-ASD-V1.0/port/Input/PGM-UCC-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-ASD-V1.0/port/Output/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-ASD-V1.0/port/Output/PGM-UCC-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/AudioSceneDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/audio-scene-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/audio-scene-description/> .

aim:PGM-BPL-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-BPL-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/PGM/V1.0/Communicative.cs> ;
    mkg:codePath "AIMs/PGM/V1.0/Communicative.cs" ;
    mkg:description "The Behaviour Planning (PGM-BPL) AIM is a Sub-AIM of A-User Formation (PGM-AUF). It receives the Communicative Functions of the Final Response and, for each function that carries no Behaviour, chooses the Behaviour that realises it on the Persona of the A-User, from the closed list of its Function and among the Behaviours of the Avatar Model; for a function that carries a Behaviour it checks that the Persona can perform it. It times every Behaviour on the words of its Anchor, aligning the Text with the Machine Speech, and gives the Communicative Functions, each with its Behaviour and its times, to Animation Object Generation. It is driven by the AUC-AUF Request and reports, in its AUC-AUF Response, for each function, Realised, Modified or Not Realised with the reason." ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-BPL-V1.0/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-BPL-V1.0/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-BPL-V1.0/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-BPL-V1.0/port/Input/PGM-CFN-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-BPL-V1.0/port/Input/PGM-UCF-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-BPL-V1.0/port/Output/PGM-CFN-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-BPL-V1.0/port/Output/PGM-UCF-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/AIMs/BehaviourPlanning.json> ;
    mkg:sourceAI true ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/behaviour-planning/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-pgm/aua/v1-0/ai-modules/behaviour-planning/> .

