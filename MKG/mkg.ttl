datatype:PGM-KDA-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-KDA-V1.0" ;
    mkg:description "The Data Type exchanged between Basic Knowledge and Domain Access (Deliberative Domain Access) through the Dialogic Semantic Query Interface, implemented with the Model Context Protocol. It has two modes, told apart by Mode: Request (RQ), sent by Basic Knowledge, that asks for domain knowledge (grounding of terms, affordances, constraints, behavioural expectations), for the validation of the feasibility of Process Actions that Basic Knowledge is considering, or for the retention of semantic commitments; and Response (RS), sent by Domain Access. The exchanges of one dialogue are told apart by TurnIndex within the DialogID; Domain Access retains the commitments for the duration of the dialogue." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/BKNDAC.json> ;
    mkg:sourceAI true ;
    mkg:title "BKN-DAC V1.0" ;
    mkg:uses datatype:OSD-SLC-V1.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/bkn-dac/> .

datatype:PGM-KPA-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-KPA-V1.0" ;
    mkg:description "The Data Type exchanged between Basic Knowledge and Personality Alignment (Deliberation Exchange) through the Model Context Protocol. It has two modes, told apart by Mode: Request (RQ), sent by Basic Knowledge, that asks for the personality-aligned stance, and Response (RS), sent by Personality Alignment, that supplies the selected stance. The exchanges of one dialogue are told apart by TurnIndex within the DialogID." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/BKNPAL.json> ;
    mkg:sourceAI true ;
    mkg:title "BKN-PAL V1.0" ;
    mkg:uses datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/bkn-pal/> .

datatype:PGM-KUS-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-KUS-V1.0" ;
    mkg:description "The Data Type exchanged between Basic Knowledge and User State Refinement through the Model Context Protocol. It has two modes, told apart by Mode: Request (RQ), sent by Basic Knowledge, that carries the deliberation feedback, and Response (RS), sent by User State Refinement, that returns the refined User State for the next deliberation cycle. The exchanges of one dialogue are told apart by TurnIndex within the DialogID." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/BKNUSR.json> ;
    mkg:sourceAI true ;
    mkg:title "BKN-USR V1.0" ;
    mkg:uses datatype:MMC-EST-V2.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/bkn-usr/> .

