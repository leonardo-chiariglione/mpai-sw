        <https://mpai.community/kg/aim/NNW-WEX-V2.0/port/Output/NNW-PLD-V2.0/0> ;
    mkg:schema <https://schemas.mpai.community/NNW1/V2.0/AIMs/WatermarkExtraction.json> ;
    mkg:sourceAI true ;
    mkg:title "Watermark Extraction V2.0" ;
    mkg:webSpec <https://mpai.community/standards/mpai-nnw/nnt/v1-2/> .

