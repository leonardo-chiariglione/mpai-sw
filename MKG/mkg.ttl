datatype:PGM-KPR-V1.0 a mkg:DataType ;
    mkg:acronym "PGM-KPR-V1.0" ;
    mkg:description "The Data Type exchanged between Basic Knowledge and Prompt Creation through the Model Context Protocol, during the dialogue that the PC Prompt opens. It has two modes, told apart by Mode: Request (RQ), sent by Basic Knowledge, that asks for additional context or a clarification, and Response (RS), sent by Prompt Creation, that returns a more complete or different representation of the understanding of the context. The exchanges of one dialogue are told apart by TurnIndex within the DialogID." ;
    mkg:ofStandard standard:PGM ;
    mkg:schema <https://schemas.mpai.community/PGM1/V1.0/data/BKNPRC.json> ;
    mkg:sourceAI true ;
    mkg:title "BKN-PRC V1.0" ;
    mkg:uses datatype:MMC-EIT-V2.5,
        datatype:OSD-STM-V1.5,
        datatype:PTF-DEM-V1.0 ;
    mkg:webPage <https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/bkn-prc/> .

aim:AIH-HFE-V1.1 a mkg:AIM ;
    mkg:acronym "AIH-HFE-V1.1" ;
    mkg:apiProfile "Basic" ;
    mkg:description "This AIM implements the AIH-HSP Health Front End. What it does depends on the User Profile it ingests. For an End User - an individual - it makes the End User's AIH Data, keeps it in the Secure Data Vault, trains on it, and has the Health Back End keep, process, de-identify, anonymise and audit it: that AIH Data only, and it needs no control of licence. For a Third-Party User - a Third-Party User Profile, or a User Profile of an individual who is a member of an organisation - it makes and keeps no AIH Data and trains nothing: it asks the Health Back End to process AIH Data, as the licence of each AIH Data prescribes, and does nothing else." ;
    mkg:flow <https://mpai.community/kg/aim/AIH-HFE-V1.1/flow/1>,
        <https://mpai.community/kg/aim/AIH-HFE-V1.1/flow/10>,
        <https://mpai.community/kg/aim/AIH-HFE-V1.1/flow/11>,
