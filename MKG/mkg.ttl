aim:CAE-AOE-V1.0 a mkg:AIM ;
    mkg:acronym "CAE-AOE-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/CAE3/V1.0/AOE/AoeAimProcessor.cs> ;
    mkg:codePath "AIMs/CAE3/V1.0/AOE/AoeAimProcessor.cs" ;
    mkg:description "Audio Object Editing. One Audio Object is open at a time, so a User Command need not name it: the Audio Object that the User Command gives (AcquiredObject), in full or by its name, is opened - from Shared Storage - or, new (a sound the User Agent captured), created. The User Command modifies what it is like (ModifiedObjects: the Object part of the Acoustic Profile; LUFS) and where it is heard from (UserPoV). It changes the features of the Objects it keeps, each by a value (ChangedObjects): of an Audio Object its Name, Time, SpaceTime, UserPoV, ParentAudioObjectIDs, DescrMetadata and the SpaceTime of each child, named; of a Basic Audio Object its Name, Time, UserPoV, DeviceID, Level, PerceptStatus, AcousticProfile, AudioQualifier and DescrMetadata. The sound is not edited. A new Name is the Object's new name, which stays unique. The list it gives (ListedObjects) says of each Object its Kind, Duration, number of children and Version. Every edit is a new version in Shared Storage. Outputs: the open Audio Object, to the Module and to Audio Scene Editing, and the User Command, with its response (UserCommandRS) saying how each action was executed." ;
    mkg:ofStandard standard:CAE ;
    mkg:port <https://mpai.community/kg/aim/CAE-AOE-V1.0/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-AOE-V1.0/port/Output/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/CAE-AOE-V1.0/port/Output/OSD-AUO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/CAE3/V1.0/AIMs/AudioObjectEditing.json> ;
    mkg:sourceAI true ;
    mkg:title "Audio Object Editing V1.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-cae/asm/v1-0/ai-modules/audio-object-editing/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-cae/> .

