        <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Input/XRV-SVA-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Input/XRV-VDI-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Input/XRV-VVS-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Output/XRV-PTD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Output/XRV-RDO-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-LTP-V1.0/port/Output/XRV-VDO-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/XRV1/V1.0/AIMs/LiveTheatricalPerformance.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:XRV-ACG-V1.0,
