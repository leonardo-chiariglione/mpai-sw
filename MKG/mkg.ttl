datatype:MMC-APC-V2.5 a mkg:DataType ;
    mkg:acronym "MMC-APC-V2.5" ;
    mkg:description "The Application Context (MMC-APC) of an application served by JSON Interface (MMC-JSI): the standing description of the application. JSON Interface obtains it from the Access of its implementation (Settings CommandSchema, ResponseSchema and ApplicationContext), or receives it on its Application Context Port; this Data Type is the whole of it. CommandSchema and ResponseSchema are the addresses of the schemas of the commands and of the responses of the application; the other members are the structure that says what those two schemas do not. A path is a dotted path from the name of a command or response, through its properties, to the property or object it designates (for example UserCommandRQ.MovedObjects.Objects.ObjectID). Only Header is required: every other member is a help that an implementation of JSON Interface may use." ;
    mkg:ofStandard standard:MMC ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/data/ApplicationContext.json> ;
    mkg:sourceAI true ;
    mkg:title "Application Context V2.5" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/data-types/application-context/> .

