aim:MMC-VCI-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-VCI-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Voice Command Interface: a person talks to an application and the application answers aloud. The same for every application: the application is given to it as the schemas of its commands and of its responses and the rest of the Application Context (MMC-APC), which JSON Interface (MMC-JSI) takes from the AccessSources of its L3 or receives on the Application Context Port. Automatic Speech Recognition recognises the speech; JSON Interface turns what the person asked into the command that conforms to the application's schema - for Audio Scene Management, a User Command (CAE-UCM) request - and turns the application's response, a User Command response, into the Response Hint; Entity Dialogue Processing, which holds the dialogue, says what is to be said - an answer, a question when the request is not clear, what was done or why not - from the recognised text and the Response Hint; Text to Speech speaks it. The command goes out on a Port and the response comes in on a Port, whatever the application. The speech that carries commands is not the speech an application edits: they arrive on different Ports. A response is said when it arrives: the application may take time." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/12>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/13>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/14>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Input/CAE-UCM-V1.0/1>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Input/MMC-APC-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Input/OSD-SEL-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Output/CAE-UCM-V1.0/1>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Output/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Output/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-VCI-V2.5/port/Output/OSD-BTO-V1.5/2> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/VoiceCommandInterface.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-JSI-V2.5,
        aim:MMC-TTS-V2.5 ;
    mkg:title "Voice Command Interface V2.5" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/voice-command-interface/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/voice-command-interface/> .

aim:PAF-SAF-V1.6 a mkg:AIM ;
    mkg:acronym "PAF-SAF-V1.6" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Portable Avatar Formation: forms the Portable Avatar of the machine from the Speech, the Text, the Face and the Body Personal Status and the Avatar Model. Generative Face Description and Generative Body Description make the Face and Body Descriptors from the Speech and the Text and the Personal Statuses; Portable Avatar Multiplexing puts the Model, the Speech and the Descriptors - and, where Response and Scene Rendering has them, the Avatar's Spatial Attitude and the Descriptors of the Audio-Visual Scene - into the Portable Avatar." ;
    mkg:flow <https://mpai.community/kg/aim/PAF-SAF-V1.6/flow/1>,
        <https://mpai.community/kg/aim/PAF-SAF-V1.6/flow/10>,
