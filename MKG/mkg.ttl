datatype:OSD-EVD-V1.5 a mkg:DataType ;
    mkg:acronym "OSD-EVD-V1.5" ;
    mkg:description "Enriched representation of a scene described by Visual Scene Descriptors, with the information produced by Visual Scene Enhancement and the AIMs it uses (object identification, relative depth, occlusion, affordances, interaction potential, salience, domain information). It extends a base Visual Scene Descriptors instance without duplicating its structure." ;
    mkg:ofStandard standard:OSD ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/EnhancedVisualSceneDescriptors.json> ;
    mkg:sourceAI true ;
    mkg:title "Enhanced Visual Scene Descriptors V1.5" ;
