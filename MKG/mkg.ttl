aim:MMC-JSI-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-JSI-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/MMC/V2.5/JSI/JsiAimProcessor.cs> ;
    mkg:codePath "AIMs/MMC/V2.5/JSI/JsiAimProcessor.cs" ;
    mkg:description "JSON Interface: between what a person says, as text, and an application that is driven by JSON instances. It is the same for every application: the application is given to it as the schema of its commands, the schema of its responses and the rest of what describes the application (CommandSchema, ResponseSchema and ApplicationContext, the AccessSources of its L3): the Application Context (MMC-APC), the standing description of the application, which the AIM may also receive on its Application Context Port: when it does, that replaces what it read from Access. Request to command: a request in words, with what the AIM remembers of the state of the application and of the commands it sent, becomes a command that conforms to the command schema, checked against it before it leaves; a request that is not for the application, or that does not become a valid command, gives no command. Response to Response Hint: a response of the application, which conforms to the response schema and names the command it answers, becomes, from the descriptions in the schema, the Response Hint: a Text Object that tells what the application did and with which values, or what it did not do and why, or why no command was formed. A Response Hint is given for every request. The AIM does not decide what is said to the person: the Response Hint goes to the dialogue AIM." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-JSI-V2.5/port/Input/CAE-UCM-V1.0/1>,
        <https://mpai.community/kg/aim/MMC-JSI-V2.5/port/Input/MMC-APC-V2.5/0>,
        <https://mpai.community/kg/aim/MMC-JSI-V2.5/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-JSI-V2.5/port/Output/CAE-UCM-V1.0/1>,
        <https://mpai.community/kg/aim/MMC-JSI-V2.5/port/Output/OSD-BTO-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/JSONInterface.json> ;
    mkg:sourceAI true ;
    mkg:title "JSON Interface V2.5" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/json-interface/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/json-interface/> .

aim:MMC-SSE-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-SSE-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/MMC/V2.5/SSE/SseAimProcessor.cs> ;
    mkg:codePath "AIMs/MMC/V2.5/SSE/SseAimProcessor.cs" ;
    mkg:description "Speech Scene Editing. One Speech Scene is open at a time: a Speech Scene arriving is opened, and the first Object added to no open Scene creates one. The User Command places Speech Objects - named as the User names them - (AddedObjects), moves them, changes where they are, takes them out and sets where the Scene is heard from (UserPoV). Every edit is a new version in Shared Storage; a member is held by its identifier and read from Shared Storage when the Scene is output. Outputs: the open Speech Scene, and the User Command, with its response (UserCommandRS) saying how each action was executed." ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-SSE-V2.5/port/Input/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/MMC-SSE-V2.5/port/Input/OSD-SPO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SSE-V2.5/port/Input/OSD-SSD-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-SSE-V2.5/port/Output/CAE-UCM-V1.0/0>,
        <https://mpai.community/kg/aim/MMC-SSE-V2.5/port/Output/OSD-SSD-V1.5/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/SpeechSceneEditing.json> ;
    mkg:sourceAI true ;
    mkg:title "Speech Scene Editing V2.5" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/speech-scene-editing/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/speech-scene-editing/> .

aim:PGM-AII-V1.0 a mkg:AIM ;
    mkg:acronym "PGM-AII-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:description "The Audio Instance Identification (PGM-AII) AIM is a Sub-AIM of Audio Scene Enhancement (PGM-ASE). It identifies the Audio Objects of the scene and assigns them Audio Object Types, using classification models, domain knowledge, and Interaction History. It is the PGM-AUA counterpart of Audio Object Identification (CAE-AOI) of CAE-USC V2.5, which receives Audio Objects and their Audio Scene Geometry and produces the Audio Instance Identifiers. Each Sub-AIM of Audio Scene Enhancement independently generates a Audio CXT Response, a Audio Domain Request and a Audio Interaction History Request. Enha" ;
    mkg:ofStandard standard:PGM ;
    mkg:port <https://mpai.community/kg/aim/PGM-AII-V1.0/port/Input/OSD-BAS-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-AII-V1.0/port/Input/PGM-DOM-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-AII-V1.0/port/Input/PGM-IHI-V1.0/0>,
