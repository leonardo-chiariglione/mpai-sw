    mkg:acronym "OSD-DSG-V1.5" ;
    mkg:description "Describes a device ensemble and its scene geometry at a capture time. " ;
    mkg:ofStandard standard:OSD ;
    mkg:schema <https://schemas.mpai.community/OSD/V1.5/data/DeviceSceneGeometry.json> ;
