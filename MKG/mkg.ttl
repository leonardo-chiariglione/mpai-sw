aim:MAS-APP-V1.1 a mkg:AIM ;
    mkg:acronym "MAS-APP-V1.1" ;
    mkg:apiProfile "Basic" ;
    mkg:description "MPAI as a Service App: the Module over which the MPAI-MAS workflow runs, letting a User Agent that has not yet chosen an App speak to the person through a Portable Avatar. Response and Scene Rendering renders the Text the User Agent supplies into Machine Speech and Machine Face Descriptors; Automatic Speech Recognition gives as Text the person's spoken reply to a question the Module asked." ;
    mkg:flow <https://mpai.community/kg/aim/MAS-APP-V1.1/flow/1>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/flow/2>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/flow/3>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/flow/4>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/flow/5>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/flow/6>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/flow/7> ;
    mkg:ofStandard standard:MAS ;
    mkg:port <https://mpai.community/kg/aim/MAS-APP-V1.1/port/Input/MMC-EPS-V2.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/port/Input/OSD-B3O-V1.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/port/Input/OSD-BSO-V1.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/port/Input/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/port/Input/string/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/port/Output/OSD-BTO-V1.5/0>,
        <https://mpai.community/kg/aim/MAS-APP-V1.1/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/MAS/V1.1/AIMs/MASApp.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:PAF-RSR-V1.6 ;
    mkg:title "" ;
    mkg:webSpec <https://mpai.community/standards/mpai-mas/v1-1/> .

aim:MMC-CPS-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-CPS-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Conversation with Personal Status: a conversation with a machine that takes the personal status of the person into account. The Multimodal Frontend Description gives what the microphone and the camera deliver as Speech, Face, Body and other Visual Objects and the Visual Scene Descriptors; Entity Body Description gives the Body Descriptors of the Body Object; Visual Object Identification gives the Instance ID of the Visual Object the person indicates from the Body Descriptors, the Visual Objects and the Visual Scene Descriptors; Automatic Speech Recognition gives the Recognised Text; Natural Language Understanding understands the Input Text and the Recognised Text with the Instance ID and gives the Text Descriptors and the Refined Text; Personal Status Extraction gives the Personal Status of the person from the Face, Body and Speech Objects and the Text Descriptors; Entity Dialogue Processing gives the Machine Text and the Machine Personal Status; Portable Avatar Multiplexing gives the Portable Avatar." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/12>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/13>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/14>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/15>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/16>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/17>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/18>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/19>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/2>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/20>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/21>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/22>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/23>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/24>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-CPS-V2.5/port/Input/OSD-BAO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/port/Input/OSD-SEL-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/MMC-CPS-V2.5/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/ConversationWithPersonalStatus.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:CVE-VOI-V1.0,
        aim:MMC-ASR-V2.5,
        aim:MMC-EDP-V2.5,
        aim:MMC-NLU-V2.5,
        aim:MMC-PSE-V2.5,
        aim:OSD-MFD-V1.5,
        aim:PAF-EBD-V1.6,
        aim:PAF-PMX-V1.6 ;
    mkg:title "" ;
    mkg:webPage <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/conversation-with-personal-status/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-mmc/v2-5/ai-modules/conversation-with-personal-status/> .

aim:MMC-CWE-V2.5 a mkg:AIM ;
    mkg:acronym "MMC-CWE-V2.5" ;
    mkg:apiProfile "Basic" ;
    mkg:description "Conversation with Emotion: a machine responds to the text and/or speech of a human consistently with the human's utterance and Emotion, detected from the text, the speech and the face, with text, synthetic speech and a face whose lips move in sync with the speech and display the machine Emotion. Automatic Speech Recognition gives the Recognised Text; Natural Language Understanding gives the Text Descriptors and the Refined Text; Entity Speech Description and Entity Face Description give the Speech and Face Descriptors Objects; PS-Text, PS-Speech and PS-Face Interpretation give the Emotion of the Text, Speech and Face as a Personal Status with only the Emotion Factor; Multimodal Emotion Fusion fuses them; Entity Dialogue Processing gives the Machine Text and the Machine Emotion; Text-to-Speech gives the Machine Speech; Video Lip Animation gives the Face of the machine, from a KB of Videos of Faces." ;
    mkg:flow <https://mpai.community/kg/aim/MMC-CWE-V2.5/flow/1>,
        <https://mpai.community/kg/aim/MMC-CWE-V2.5/flow/10>,
        <https://mpai.community/kg/aim/MMC-CWE-V2.5/flow/11>,
        <https://mpai.community/kg/aim/MMC-CWE-V2.5/flow/12>,
        <https://mpai.community/kg/aim/MMC-CWE-V2.5/flow/13>,
