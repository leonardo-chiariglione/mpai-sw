        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Input/PGM-UCC-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Input/PGM-VOT-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Output/OSD-AFT-V1.5/0>,
        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Output/PGM-DOM-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Output/PGM-IHI-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Output/PGM-SOM-V1.0/0>,
        <https://mpai.community/kg/aim/PGM-VSM-V1.0/port/Output/PGM-UCC-V1.0/0> ;
