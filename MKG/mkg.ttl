aim:XRV-END-V1.0 a mkg:AIM ;
    mkg:acronym "XRV-END-V1.0" ;
    mkg:apiProfile "Basic" ;
    mkg:code <https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/XRV1/V1.0/END/End.cs> ;
    mkg:codePath "AIMs/XRV1/V1.0/END/End.cs" ;
    mkg:description "The Environment Description (XRV-END) AIM captures raw Data from the Real and Virtual Environments including audio, visual, and other data in a variety of formats defined by the Qualifier standard; using Script-Venue Associations, identifies and separates the Performance elements, Participant elements and Operator elements that are relevant to subsequent processing; packages them into Performance, Participant, and Operator Descriptors for both the Real and Virtual Environments, and a combination of all Descriptors called Show Descriptors; and passes the Descriptors to downstream AIMs." ;
    mkg:ofStandard standard:XRV ;
    mkg:port <https://mpai.community/kg/aim/XRV-END-V1.0/port/Input/XRV-ATB-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Input/XRV-PTD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Input/XRV-RDI-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Input/XRV-RVS-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Input/XRV-SCR-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Input/XRV-SVA-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Input/XRV-VDI-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Input/XRV-VVS-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Output/XRV-RFD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Output/XRV-ROD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Output/XRV-RTD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Output/XRV-SHD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Output/XRV-VFD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Output/XRV-VOD-V1.0/0>,
        <https://mpai.community/kg/aim/XRV-END-V1.0/port/Output/XRV-VTD-V1.0/0> ;
    mkg:schema <https://schemas.mpai.community/XRV1/V1.0/AIMs/EnvironmentDescription.json> ;
    mkg:sourceAI true ;
    mkg:title "Environment Description V1.0" ;
    mkg:webPage <https://mpai.community/standards/mpai-xrv/ltp/v1-0/ai-modules/environment-description/> ;
    mkg:webSpec <https://mpai.community/standards/mpai-xrv/ltp/v1-0/ai-modules/environment-description/> .

