        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/flow/3>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/flow/4>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/flow/5>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/flow/6>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/flow/7>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/flow/8>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/flow/9> ;
    mkg:ofStandard standard:MMC ;
    mkg:port <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/OSD-BSO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/OSD-BTO-V1.5/1>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Input/string/0>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Output/OSD-BVO-V1.5/0>,
        <https://mpai.community/kg/aim/MMC-AMQ-V2.5/port/Output/PAF-PAV-V1.6/0> ;
    mkg:schema <https://schemas.mpai.community/MMC/V2.5/AIMs/AnswerToMultimodalQuestion.json> ;
    mkg:sourceAI true ;
    mkg:subAIM aim:MMC-ASR-V2.5,
        aim:MMC-TIQ-V2.5,
        aim:MMC-TTS-V2.5,
