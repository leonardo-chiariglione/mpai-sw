 {
  "@id": "https://mpai.community/kg/datatype/PGM-UCP-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-UCP-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between A-User Control (AUC) and Personality Alignment (PAL). It has two modes, told apart by Mode: Request (RQ), sent by AUC to PAL (previously PAL Directive), and Response (RS), sent by PAL to AUC (previously PAL Status). Personality Alignment is a reasoning AIM: it decides the stance of the A-User and says whether, and how far, it adopted the correction proposed by AUC according to its Weight. A-User Control directs the constraints and the evidence it may use, whether it is Basic or Composite. Every Request is answered by a Response."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
   {
    "@id": "https://schemas.mpai.community/PGM1/V1.0/data/AUCPAL.json"
   }
  ],
