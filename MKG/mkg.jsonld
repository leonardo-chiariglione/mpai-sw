 {
  "@id": "https://mpai.community/kg/aim/PGM-FRD-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-FRD-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Final Response Demultiplexing (PGM-FRD) AIM is a Sub-AIM of A-User Formation (PGM-AUF). It takes apart the Final Response produced by Basic Knowledge: the Text, which goes to Text-To-Speech and to Portable Avatar Multiplexing; the Communicative Functions, which go to Behaviour Planning; the Actions, which go with the text and go to Animation Object Generation; and the Process Actions, more remote from the text, which A-User Formation gives to A-User Control unchanged. It is driven by the AUC-AUF Request and reports with an AUC-AUF Response."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
