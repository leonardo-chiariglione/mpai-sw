  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between Basic Knowledge and User State Refinement through the Model Context Protocol. It has two modes, told apart by Mode: Request (RQ), sent by Basic Knowledge, that carries the deliberation feedback, and Response (RS), sent by User State Refinement, that returns the refined User State for the next deliberation cycle. The exchanges of one dialogue are told apart by TurnIndex within the DialogID."
   }
  ],
