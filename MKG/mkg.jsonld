 {
  "@id": "https://mpai.community/kg/aim/MMC-CPS-V2.5",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "MMC-CPS-V2.5"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Conversation with Personal Status: a conversation with a machine that takes the personal status of the person into account. The Multimodal Frontend Description gives what the microphone and the camera deliver as Speech, Face, Body and other Visual Objects and the Visual Scene Descriptors; Entity Body Description gives the Body Descriptors of the Body Object; Visual Object Identification gives the Instance ID of the Visual Object the person indicates from the Body Descriptors, the Visual Objects and the Visual Scene Descriptors; Automatic Speech Recognition gives the Recognised Text; Natural Language Understanding understands the Input Text and the Recognised Text with the Instance ID and gives the Text Descriptors and the Refined Text; Personal Status Extraction gives the Personal Status of the person from the Face, Body and Speech Objects and the Text Descriptors; Entity Dialogue Processing gives the Machine Text and the Machine Personal Status; Portable Avatar Multiplexing gives the Portable Avatar."
   }
  ],
