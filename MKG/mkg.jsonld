 {
  "@id": "https://mpai.community/kg/datatype/PGM-KPR-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-KPR-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between Basic Knowledge and Prompt Creation through the Model Context Protocol, during the dialogue that the PC Prompt opens. It has two modes, told apart by Mode: Request (RQ), sent by Basic Knowledge, that asks for additional context or a clarification, and Response (RS), sent by Prompt Creation, that returns a more complete or different representation of the understanding of the context. The exchanges of one dialogue are told apart by TurnIndex within the DialogID."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
