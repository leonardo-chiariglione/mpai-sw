 {
  "@id": "https://mpai.community/kg/datatype/MMC-APC-V2.5",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "MMC-APC-V2.5"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Application Context (MMC-APC) of an application served by JSON Interface (MMC-JSI): the standing description of the application. JSON Interface obtains it from the Access of its implementation (Settings CommandSchema, ResponseSchema and ApplicationContext), or receives it on its Application Context Port; this Data Type is the whole of it. CommandSchema and ResponseSchema are the addresses of the schemas of the commands and of the responses of the application; the other members are the structure that says what those two schemas do not. A path is a dotted path from the name of a command or response, through its properties, to the property or object it designates (for example UserCommandRQ.MovedObjects.Objects.ObjectID). Only Header is required: every other member is a help that an implementation of JSON Interface may use."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/MMC"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
   {
    "@id": "https://schemas.mpai.community/MMC/V2.5/data/ApplicationContext.json"
   }
  ],
  "https://mpai.community/kg/vocab#sourceAI": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://mpai.community/kg/vocab#title": [
   {
    "@value": "Application Context V2.5"
   }
  ],
  "https://mpai.community/kg/vocab#webPage": [
   {
    "@id": "https://mpai.community/standards/mpai-mmc/v2-5/data-types/application-context/"
   }
  ]
 },
