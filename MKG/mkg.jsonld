   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Visual Object Identification: produces the Identifier, based on a Taxonomy, of the Visual Object of a Visual Scene, described by its Basic Visual Scene Descriptors, that a Point of View crosses. The Point of View comes from the Body Descriptors of the Entity that indicates the object (Visual Direction Identification); Visual Object Extraction takes from the Visual Objects the one the Point of View crosses; Visual Instance Identification gives its Identifier."
   }
  ],
