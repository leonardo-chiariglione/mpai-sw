  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Speech Translation with Descriptors: translates a Speech Object into the language that the Language Selector names and gives the translated Speech Object in the voice of the input speech, and the translated Text Object. Automatic Speech Recognition recognises the speech; Entity Speech Description describes the voice; Text-to-Text Translation translates the text; Text-to-Speech with Descriptors speaks the translation with the voice described. There is no direct speech-to-speech translation."
   }
  ],
  "https://mpai.community/kg/vocab#flow": [
   {
    "@id": "https://mpai.community/kg/aim/MMC-STD-V2.5/flow/1"
   },
   {
