 {
  "@id": "https://mpai.community/kg/aim/OSD-BOS-V1.5",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "OSD-BOS-V1.5"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Basic Offline Map Scene Description: describes the acquired BasicOfflineMapObject as BasicOfflineMapSceneDescriptors. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in CAV-HCI. It neither raises an Alert nor takes a prior: EnvironmentSensingSubsystem.json wires neither to the offline map, a stored map having nothing to react to and nothing to gain from the previous cycle."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/OSD"
   }
  ],
