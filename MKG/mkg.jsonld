  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Sparse Plane Wave Decomposition (CAE-SPD) of CAE-6DF V1.0: Models a complex, multi-channel sound field as a small number of discrete, highly directional plane waves per time-frequency bin, effectively isolating the primary direct sound paths from the non-directional background room reverberation."
   }
  ],
