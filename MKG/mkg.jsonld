 {
  "@id": "https://mpai.community/kg/aim/NNW-PWI-V2.0",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "NNW-PWI-V2.0"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "/* Basic | Secure: Secure where the method uses a secret key (Security API) */"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Post-Training Watermark Insertion: inserts the payload in an already trained neural network model, without training it again. It gives the watermarked model, a new ML Model Object of the same format and Qualifier as the model it was given. Where a Locator is given, the payload is inserted where it says and by the method it names; the AIM does not give the Locator back. Where the payload does not fit there, or the format of the model is not one it supports, it gives no model and reports why."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
