  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Visual Scene Description (PGM-VSD) AIM receives a Visual Object and produces the Visual Scene Descriptors describing it. In the PGM-AUA context, the AIM operates under the control of a Visual CXT Request issued by A-User Control (through the CXT-AUS Interface) and reports a Visual CXT Response on completion. The AIM references the Input and Output Data Types by name; their structure is specified by the respective Data Type definitions."
   }
  ],
