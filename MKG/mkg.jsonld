 {
  "@id": "https://mpai.community/kg/aim/AIH-NNM-V1.1",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "AIH-NNM-V1.1"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/AIH/V1.1/Nnm/NnmAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/AIH/V1.1/Nnm/NnmAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "This AIM wraps a Neural Network Model and processes AIH Data with it: it takes AIH Data and gives the AIH Data resulting from the processing. The Neural Network Model learns as the AIM processes AIH Data. The AIM is what is exchanged: the Health Back End uploads it to the MPAI Store, the Health Front Ends download it, and a Health Front End returns it with the Neural Network Model trained; the AIM gives the Neural Network Model it holds for that. It may take a Neural Network Model to wrap or to update."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/AIH"
   }
  ],
