 {
  "@id": "https://mpai.community/kg/datatype/PGM-CFN-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-CFN-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/PGM/V1.0/Communicative.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/PGM/V1.0/Communicative.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "What the A-User means to do with its body while it utters the Text of a Final Response: for each function, towards whom or what, with which words, how markedly and, at Level 2, with which behaviour. Basic Knowledge gives the functions in the Final Response (Level 1 or 2); Final Response Demultiplexing gives them to Behaviour Planning, which gives them to Animation Object Generation with a behaviour and its times for every function. The Function and the Behaviour are taken from closed lists, and a Behaviour shall be one of those allowed for its Function."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
   {
    "@id": "https://schemas.mpai.community/PGM1/V1.0/data/CommunicativeFunctions.json"
   }
  ],
