   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Response and Scene Rendering: renders the machine's response - a Text, and the Personal Status that goes with it - as the Portable Avatar of the input Avatar Model, ready to play; whoever requested it places it in a scene and renders it (with Scene and Avatar Rendering). Personal Status De-multiplexing splits a Personal Status into the Speech, Face and Body Personal Statuses; Text-To-Speech makes the Machine Speech; Portable Avatar Formation makes the Portable Avatar. The Point of View goes through."
   }
  ],
