 {
  "@id": "https://mpai.community/kg/datatype/PGM-KDA-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-KDA-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between Basic Knowledge and Domain Access (Deliberative Domain Access) through the Dialogic Semantic Query Interface, implemented with the Model Context Protocol. It has two modes, told apart by Mode: Request (RQ), sent by Basic Knowledge, that asks for domain knowledge (grounding of terms, affordances, constraints, behavioural expectations), for the validation of the feasibility of Process Actions that Basic Knowledge is considering, or for the retention of semantic commitments; and Response (RS), sent by Domain Access. The exchanges of one dialogue are told apart by TurnIndex within the DialogID; Domain Access retains the commitments for the duration of the dialogue."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
