   },
   {
    "@id": "https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/6"
   },
   {
    "@id": "https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/7"
   },
   {
    "@id": "https://mpai.community/kg/aim/MMC-VCI-V2.5/flow/8"
   },
   {
