   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Videoconference Client Transmitter: on the participant side, the Multimodal Frontend Description gives what the microphone and the camera deliver as Speech, Face and Body Objects; Automatic Speech Recognition and Personal Status Extraction give the Recognised Text and the Personal Status; Entity Face Description and Entity Body Description give the Face and the Body Descriptors; Portable Avatar Multiplexing composes the Participant Portable Avatar for the Avatar Videoconference Server. The Speech Object and the Face Object are also given to the server."
   }
  ],
