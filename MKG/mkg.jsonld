  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Multimodal Conversation Avatar: the HCI Module for anonymous dialogue with a Portable Avatar (no identity, no Identity Reconciliation, no Personal Status). Automatic Speech Recognition recognises the human's speech into text, or the human types it; Entity Dialogue Processing produces the machine's response Text (the Summary of the conversation is internal to it); Text-to-Speech gives the response its Machine Speech, Generative Face Description the lip-synced Machine Face Descriptors, and Portable Avatar Multiplexing combines Speech, Text, Face Descriptors, Avatar Model and Machine ID into the Portable Avatar."
   }
  ],
