 {
  "@id": "https://mpai.community/kg/datatype/PGM-HCM-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-HCM-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type with which the human responsible for the A-User influences its behaviour, state or decision-making, and with which A-User Control reports the outcome. It has two modes, told apart by Mode: Request (RQ), the Human Command, an authenticated instruction, structured or expressed with audio, text or visual media, that may trigger the execution of an action, override logic, escalation or the reconfiguration of an AIM; and Response (RS), the Human Command Status, produced by A-User Control after processing a Human Command, that reports the outcome (accepted, rejected, escalated or ignored), the lifecycle transition, the AIMs affected and the override report. A Response carries the identifier of the Request it answers."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
