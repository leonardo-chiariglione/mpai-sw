   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/MMC/V2.5/CTS/CtsAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Column Text Selection. Receives the lines of a page as a Text Object (each line a Basic Text Object with its box, in the pixels of the page) and, when the person has pointed, the Point at the top of a column; produces the text of that column as a Basic Text Object: the lines under the point that overlap it horizontally, down to the column's end (a wide gap, a much taller line, or no line left), a word hyphenated across lines joined. With no Point, the first column under the headline."
   }
  ],
