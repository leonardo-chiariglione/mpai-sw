 {
  "@id": "https://mpai.community/kg/aim/PGM-ASR-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-ASR-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Automatic Speech Recognition (PGM-ASR) AIM extracts the text conveyed by an utterance and derives the paralinguistic features of the speech signal. The input speech may be accompanied by an auxiliary text, the identifier of the speaker, the Speech Overlap data type, and the time indicating the portion of the input speech that should be recognised. Operation is governed by the User CXT Request, which specifies scope, depth, and policy constraints. Processing outcome is reported via the User CXT Response. Domain knowledge and interaction history may be queried by issuing User Domain and User"
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
