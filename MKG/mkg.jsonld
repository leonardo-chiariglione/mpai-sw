 {
  "@id": "https://mpai.community/kg/datatype/PGM-UCS-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-UCS-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between A-User Control (AUC) and the Private Storage of the Module, through the Controller. It has two modes, told apart by Mode: Request (RQ), sent by AUC, which establishes for an A-User session the storage scopes, the retention and life cycle policy and the access rights that Private Storage enforces; and Response (RS), sent by Private Storage, which reports the outcome of the life cycle command, the operations served, the enforcement of the access rights and retention, and the integrity and capacity of the storage. Every Request is answered by a Response."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
   {
    "@id": "https://schemas.mpai.community/PGM1/V1.0/data/AUCAUS.json"
   }
  ],
  "https://mpai.community/kg/vocab#sourceAI": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
