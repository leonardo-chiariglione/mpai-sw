 {
  "@id": "https://mpai.community/kg/datatype/PGM-IHI-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-IHI-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between any AIM of the A-User and Private Storage, through the Controller, for the content of earlier captures and turns of the session. It has two modes, told apart by Mode: Request (RQ), that states what is to be read and what is to be written, and Response (RS), that returns the content read and the outcome of the writes. SourceAIM states which AIM or Sub-AIM sends the Request or receives the Response, and Subject which medium or User it relates to. All access is under the rules set by A-User Control."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
