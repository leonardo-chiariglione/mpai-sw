  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "This AIM assembles the per-modality Personal Statuses - Text, Speech, Face, and Body - into a single Entity Personal Status. It combines; it does not compute. Each modality input is optional, but at least one shall be present; the Entity Personal Status carries whichever modalities are supplied."
   }
