   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Live Theatrical Performance (XRV-LTP) AIM receives Venue-specific Specifications and data from the Real and Virtual live-performance Environment, the live performance Script, historical and current Participant data, and Venue-specific commands, data, and associations between Script and Venue. As the Live Theatrical Performance proceeds, it controls the audience experience according to the Script based on the Actions of the Performance (Performers and related objects), Operators, and Participants."
   }
  ],
  "https://mpai.community/kg/vocab#notAligned": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/XRV"
   }
  ],
