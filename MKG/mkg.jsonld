 {
  "@id": "https://mpai.community/kg/aim/CAE-AES-V2.5",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "CAE-AES-V2.5"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Add Emotion to Speech (CAE-AES) of CAE-USC V2.5: gives emotionless speech an emotion that is named. Speech Feature Analysis 2 (CAE-SFB) extracts the features of the emotionless speech, selected by the Mode Selector; Emotion Feature Production (CAE-EFP) produces from them, from the Emotion List and in the language selected, the neural speech features of the emotion; Neural Emotion Insertion (CAE-NEI) gives them to the emotionless speech, and gives the Speech with Emotion."
   }
  ],
  "https://mpai.community/kg/vocab#flow": [
   {
