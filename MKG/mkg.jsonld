   {
    "@value": "AIMs/MMC/V2.5/OCR/OcrAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "This AIM receives the image of a page as a Basic Visual Object and, optionally, a Point on it (OSD-PNT-V1.5), and produces a Text Object: the lines of text found on a band of the page about the Point (at the top of the page with no Point), in the full width of the page, in reading order, each a Basic Text Object with its box on the page and its confidence. The box of a line is the Space-Time of the line in the Text Object: SpatialAttitude1 is its top-left corner, SpatialAttitude2 its bottom-right corner, in the pixels of the image (X to the right, Y down). The confidence of a line is in its Data Exchange Metadata."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/MMC"
   }
  ],
