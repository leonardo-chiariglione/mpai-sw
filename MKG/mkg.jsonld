 {
  "@id": "https://mpai.community/kg/aim/PGM-PAL-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-PAL-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/PGM/V1.0/ContextAims.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/PGM/V1.0/ContextAims.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Personality Alignment (PGM-PAL) AIM decides the stance the A-User should adopt and produces the A-User State that the A-User Formation AIM renders. It is a reasoning AIM: knowing how the User feels and the context of the interaction, it judges what stance is appropriate for the A-User, which is not the same as mirroring the User. If the User laughs, the A-User laughing may be appropriate in a pub but improper in a church; the Personality Alignment AIM makes that judgement. To make it, the Personality Alignment AIM needs two things only: the User's internal state and the context. It receive"
   }
  ],
