  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The description of a Unit of the User Agent's Physical Layer: what it acquires from, or delivers to, the real world, and the Data Types of its Ports. A Unit is not an AIM: it has no Implementations, Resource Policies or AIM Licence, and no Controller is involved."
   }
  ],
