  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Multimodal Scene Integration and Description: takes the Avatar and the Scene conveyed by the Input Portable Avatar, places the Avatar in the Scene with an appropriate Spatial Attitude (a generic Scene if the Portable Avatar conveys none) and gives the Face, Body and other Visual Objects, the Visual Scene Descriptors, the Audio and Speech Objects and the Audio Scene Descriptors of the resulting Scene."
   }
  ],
