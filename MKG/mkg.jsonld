   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Speak Model with Emotion (CAE-SME) of CAE-USC V2.5: gives emotionless speech the emotion of a model utterance by its prosody. Speech Feature Analysis 1 (CAE-SFA) extracts the prosodic features of the model utterance, selected by the Mode Selector, and Prosodic Emotion Insertion (CAE-PEI) applies them to the emotionless speech, with the Emotion List, and gives the Speech with Emotion."
   }
  ],
