   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Answer to Multimodal Question: receives a Visual Object and a question - as a Speech Object or a Text Object - and returns the answer as a Portable Avatar, which utters it, and the Visual Object. Automatic Speech Recognition recognises the spoken question; Text and Image Query answers the question about the image; Text-To-Speech makes the Speech Object of the answer; Portable Avatar Multiplexing puts the answer, text and speech, in the Portable Avatar, which the User Agent renders."
   }
  ],
