 {
  "@id": "https://mpai.community/kg/datatype/PGM-UCK-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-UCK-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between A-User Control (AUC) and Basic Knowledge (BKN). It has two modes, told apart by Mode: Request (RQ), sent by AUC to BKN (previously BKN Directive), and Response (RS), sent by BKN to AUC (previously BKN Status). Basic Knowledge is a reasoning AIM and is not Composite: it decides its own conclusion, and says whether it adopted the correction proposed by AUC. AUC may ask it to propose Process Actions in addition to the Final Response; the Final Response and the Process Actions are sent on its output Ports and the Response only reports them. Every Request is answered by a Response."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
   {
    "@id": "https://schemas.mpai.community/PGM1/V1.0/data/AUCBKN.json"
   }
  ],
  "https://mpai.community/kg/vocab#sourceAI": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://mpai.community/kg/vocab#title": [
   {
    "@value": "AUC-BKN V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#uses": [
   {
    "@id": "https://mpai.community/kg/datatype/PGM-CFN-V1.0"
   },
   {
    "@id": "https://mpai.community/kg/datatype/OSD-STM-V1.5"
   },
   {
    "@id": "https://mpai.community/kg/datatype/PTF-DEM-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#webPage": [
   {
    "@id": "https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-bkn/"
   }
  ]
 },
