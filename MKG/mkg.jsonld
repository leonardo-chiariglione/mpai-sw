   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/OSD/V1.5/BVS/BvsAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/OSD/V1.5/BVS/BvsAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Basic Visual Scene Description: describes the acquired BasicVisualObject as BasicVisualSceneDescriptors. It raises an Alert when what it describes warrants one, without waiting for integration. Two of its inputs are optional, so that the same AIM serves applications that have something to connect to them and applications that do not: an application holding an ego Spatial Attitude receives descriptors already expressed in that frame, and one that maintains a running environment description returns it as a prior. Both are wired in EnvironmentSensingSubsystem.json and neither is wired in CAV-HCI."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/OSD"
   }
  ],
  "https://mpai.community/kg/vocab#port": [
   {
    "@id": "https://mpai.community/kg/aim/OSD-BVS-V1.5/port/Input/OSD-BVO-V1.5/0"
