 {
  "@id": "https://mpai.community/kg/aim/MMC-MTS-V2.5",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "MMC-MTS-V2.5"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Multimodal Translation Service: the HCI Module for spoken translation with a Portable Avatar. Automatic Speech Recognition recognises the human's speech into text; Text-to-Text Translation translates it into the language named by the Language Selector; Text-To-Speech makes the Speech Object of the translation; Portable Avatar Multiplexing puts the translation, text and speech, in the Portable Avatar, which the User Agent renders. The translated text is also exposed. Non-affective; no Personal Status is supplied. Acquisition and delivery are the User Agent, not sub-AIMs."
   }
  ],
