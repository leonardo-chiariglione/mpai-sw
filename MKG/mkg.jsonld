  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Short-Time Fourier Transform (CAE-SFT) of CAE-6DF V1.0: The SFT AIM takes Audio Objects represented in the time domain as input and outputs Audio Objects in the frequency domain. The SFT uses a Hann window of length N = 2048 with and overlap size of 7/8 N between blocks of data and performs an FFT."
   }
  ],
