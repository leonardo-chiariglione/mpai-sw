 {
  "@id": "https://mpai.community/kg/datatype/OSD-CSP-V1.5",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "OSD-CSP-V1.5"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "A space enclosed by walls: its shape a Simple Location - a combination of Right Parallelepipeds. The walls are the faces of the Right Parallelepipeds, named Floor, Ceiling, Front, Back, Left and Right as Right Parallelepiped names them; a face where two Right Parallelepipeds meet is an opening, not a wall. What the walls are made of - their Materials - is not part of the Closed Space: it belongs to the acoustics of the Scene, the Walls and the DefaultMaterial of its Acoustic Profile (CAE-ACP)."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/OSD"
