 {
  "@id": "https://mpai.community/kg/aim/PGM-BPL-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-BPL-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/PGM/V1.0/Communicative.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/PGM/V1.0/Communicative.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Behaviour Planning (PGM-BPL) AIM is a Sub-AIM of A-User Formation (PGM-AUF). It receives the Communicative Functions of the Final Response and, for each function that carries no Behaviour, chooses the Behaviour that realises it on the Persona of the A-User, from the closed list of its Function and among the Behaviours of the Avatar Model; for a function that carries a Behaviour it checks that the Persona can perform it. It times every Behaviour on the words of its Anchor, aligning the Text with the Machine Speech, and gives the Communicative Functions, each with its Behaviour and its times, to Animation Object Generation. It is driven by the AUC-AUF Request and reports, in its AUC-AUF Response, for each function, Realised, Modified or Not Realised with the reason."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
