  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Multimodal Question Answering (slide 16 of the MMC Reference Models): answers a question about a visual object, put as a Text Object or as speech, with a Portable Avatar. Visual Instance Identification (CVE-VII) gives the Instance Identifier of the object, Automatic Speech Recognition the text of a spoken question, Natural Language Understanding the Refined Text and the Text Descriptors Object (the former Meaning), Question Analysis the Intention, Answer to Question the Machine Text, and Portable Avatar Multiplexing the Portable Avatar, which needs the ID of the machine."
   }
  ],
