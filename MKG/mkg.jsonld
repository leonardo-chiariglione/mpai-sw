 {
  "@id": "https://mpai.community/kg/aim/MMC-AMC-V2.5",
  "@type": [
   "https://mpai.community/kg/vocab#AIM"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "MMC-AMC-V2.5"
   }
  ],
  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Affective Multimodal Conversation: speech-only affective dialogue. Automatic Speech Recognition recognises the speech; Natural Language Understanding produces the Text Descriptors, the (refined) NLU Text and the Text Personal Status; Personal Status Extraction reads the Speech Personal Status from the Speech Object and multiplexes it with the Text Personal Status into the entity's Personal Status; Entity Dialogue Processing produces the machine's response Text and Personal Status, aware of both the meaning and the feeling; Response and Scene Rendering renders the Portable Avatar. The Summary of the conversation is internal to Entity Dialogue Processing. Acquisition and delivery are the User Agent, not sub-AIMs."
   }
  ],
