 {
  "@id": "https://mpai.community/kg/datatype/PGM-FRS-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-FRS-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The deliberated content produced by Basic Knowledge: the text to be uttered, the Communicative Functions that go with the text (what the A-User means to do with its body, towards whom or what and with which words), the Actions that go with the text (for instance moving the Persona in the M-Instance) and the Process Actions that carry out the response, which may be more remote from the text. It is the only output of Basic Knowledge, apart from the AUC-BKN Response and the exchanges with its partners, and it is sent to A-User Formation."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
