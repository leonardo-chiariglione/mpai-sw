 {
  "@id": "https://mpai.community/kg/datatype/NNW-WLC-V2.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "NNW-WLC-V2.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Where a watermark sits in a neural network model, and by which method it was inserted. It is neither part of the model (AIP-MLO) nor of the Payload (NNW-PLD): an insertion AIM and an extraction AIM may take it, and neither gives it: it stays with the party that decides where the watermark is placed. An insertion AIM that is not given a Locator places the watermark where its own method puts it, and an extraction AIM that is not given one looks for it there. It never carries a secret key, only a reference to one."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/NNW"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
   {
    "@id": "https://schemas.mpai.community/NNW1/V2.0/data/Locator.json"
   }
  ],
  "https://mpai.community/kg/vocab#sourceAI": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://mpai.community/kg/vocab#title": [
   {
    "@value": "Locator V2.0"
   }
  ],
  "https://mpai.community/kg/vocab#uses": [
   {
    "@id": "https://mpai.community/kg/datatype/OSD-STM-V1.5"
   },
   {
    "@id": "https://mpai.community/kg/datatype/PTF-DEM-V1.0"
   }
  ]
 },
 {
  "@id": "https://mpai.community/kg/datatype/PGM-UCD-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-UCD-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between A-User Control (AUC) and Domain Access (DAC). It has two modes, told apart by Mode: Request (RQ), sent by AUC to DAC (previously DAC Directive), and Response (RS), sent by DAC to AUC (previously DAC Status). Domain Access provides domain semantics for capture-level grounding and for reasoning, without perception or reasoning of its own. A-User Control drives it at operation level and may ask it to validate the feasibility of an intended behaviour. A failure of an external source is reported so that AUC can decide. Every Request is answered by a Response."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
   {
    "@id": "https://schemas.mpai.community/PGM1/V1.0/data/AUCDAC.json"
   }
  ],
  "https://mpai.community/kg/vocab#sourceAI": [
   {
    "@type": "http://www.w3.org/2001/XMLSchema#boolean",
    "@value": true
   }
  ],
  "https://mpai.community/kg/vocab#title": [
   {
    "@value": "AUC-DAC V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#uses": [
   {
    "@id": "https://mpai.community/kg/datatype/OSD-STM-V1.5"
   },
   {
    "@id": "https://mpai.community/kg/datatype/PTF-DEM-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#webPage": [
   {
    "@id": "https://mpai.community/standards/mpai-pgm/aua/v1-0/data-types/auc-dac/"
   }
  ]
 },
