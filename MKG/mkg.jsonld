   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Portable Avatar Formation: forms the Portable Avatar of the machine from the Speech, the Text, the Face and the Body Personal Status and the Avatar Model. Generative Face Description and Generative Body Description make the Face and Body Descriptors from the Speech and the Text and the Personal Statuses; Portable Avatar Multiplexing puts the Model, the Speech and the Descriptors - and, where Response and Scene Rendering has them, the Avatar's Spatial Attitude and the Descriptors of the Audio-Visual Scene - into the Portable Avatar."
   }
  ],
