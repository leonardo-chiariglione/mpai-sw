   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Personal Status Extraction: extracts the Personal Status of an Entity from the four media - Text, Speech, Face, Body - or from their descriptors. Each medium is described by Entity Text / Speech / Face / Body Description and the descriptors are interpreted by PS-Text / PS-Speech / PS-Face / PS-Body Interpretation; descriptors that arrive as such go straight to the interpretation; Personal Status Multiplexing combines the Personal Statuses of the modalities that arrived. A Text Personal Status that arrives ready-made (TextPersonalStatus) goes straight to the multiplexing."
   }
  ],
