   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Newspaper Reader: receives the image of a newspaper page and, when the person has pointed at the top of a column, the Point; returns the text of that column as a Portable Avatar, which reads it. Optical Character Recognition finds the lines of a band of the page about the Point; Column Text Selection takes the text of the column; Text-To-Speech makes the Speech Object of the text; Portable Avatar Multiplexing puts the text and the speech in the Portable Avatar, which the User Agent renders."
   }
  ],
