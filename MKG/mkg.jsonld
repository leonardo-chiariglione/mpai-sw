  "https://mpai.community/kg/vocab#apiProfile": [
   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Audio Instance Identification (PGM-AII) AIM is a Sub-AIM of Audio Scene Enhancement (PGM-ASE). It identifies the Audio Objects of the scene and assigns them Audio Object Types, using classification models, domain knowledge, and Interaction History. It is the PGM-AUA counterpart of Audio Object Identification (CAE-AOI) of CAE-USC V2.5, which receives Audio Objects and their Audio Scene Geometry and produces the Audio Instance Identifiers. Each Sub-AIM of Audio Scene Enhancement independently generates a Audio CXT Response, a Audio Domain Request and a Audio Interaction History Request. Enha"
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
