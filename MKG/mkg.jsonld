   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Multimodal Frontend Description: from the Basic Audio, Visual and, if available, LiDAR Objects of the real world gives the Speech, Audio, Face, Body and other Visual Objects, typed, the aligned Audio and Visual Scene Descriptors. Basic Audio, LiDAR and Visual Scene Description give the Basic Scene Descriptors of each medium, Multimodal Alignment aligns them, Audio Scene Object Identification gives the Speech and the Audio Objects of the aligned Audio Scene, and Visual Scene Object Identification gives the Face, Body and other Visual Objects of the aligned Visual Scene."
   }
  ],
