   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Visual Object Identification by Body: identifies the Visual Object that the index finger of a Body Object indicates. It receives the Body Object, a generic Visual Object to be identified and the Basic Visual Scene Descriptors of the scene that includes them. Entity Body Description gives the Body Descriptors of the Body Object, Visual Direction Identification finds the Point of View of the index finger, Visual Object Extraction takes the Visual Object the Point of View crosses, and Visual Instance Identification gives its Identifier."
   }
  ],
