   {
    "@value": "Basic"
   }
  ],
  "https://mpai.community/kg/vocab#code": [
   {
    "@id": "https://github.com/leonardo-chiariglione/mpai-sw/blob/main/AIMs/OSD/V1.5/MSE/MseAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/OSD/V1.5/MSE/MseAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Multimodal Scene Editing: Scenes and Objects of at least two media - Audio, Visual, Speech, LiDAR, 3D Model, RADAR, Ultrasound, Offline Map - composed into a Multimodal Scene (a voice over music is an MSD of an ASD and an SSD, or of an AUO and an SPO). Each of its two Scene Ports takes a Scene of any medium, and each of its two Object Ports an Object of any medium, kept as it arrives. One Multimodal Scene is open at a time: the User Command places the Scenes and Objects, named as the User names them, in its common frame (AddedObjects), moves them, changes where they are, takes them out and sets where the Multimodal Scene is heard and seen from (UserPoV). The Scenes and Objects being edited are followed: a member that is the version last arrived on its Port is replaced by the new version. Every edit is a new version in Shared Storage. Outputs: the open Multimodal Scene - when its members are of at least two media - and the User Command, with its response (UserCommandRS) saying how each action was executed."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/OSD"
   }
  ],
