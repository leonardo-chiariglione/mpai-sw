 {
  "@id": "https://mpai.community/kg/datatype/PGM-UCU-V1.0",
  "@type": [
   "https://mpai.community/kg/vocab#DataType"
  ],
  "https://mpai.community/kg/vocab#acronym": [
   {
    "@value": "PGM-UCU-V1.0"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "The Data Type exchanged between A-User Control (AUC) and User State Refinement (USR). It has two modes, told apart by Mode: Request (RQ), sent by AUC to USR (previously USR Directive), and Response (RS), sent by USR to AUC (previously USR Status). User State Refinement is a reasoning AIM: it decides its own conclusion, and says whether it adopted the correction proposed by AUC. A-User Control directs the evidence it may use and the properties it produces, whether it is Basic or Composite. Every Request is answered by a Response."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/PGM"
   }
  ],
  "https://mpai.community/kg/vocab#schema": [
