   }
  ],
  "https://mpai.community/kg/vocab#codePath": [
   {
    "@value": "AIMs/MMC/V2.5/SOE/SoeAimProcessor.cs"
   }
  ],
  "https://mpai.community/kg/vocab#description": [
   {
    "@value": "Speech Object Editing. One Speech Object is open at a time: the Speech Object that the User Command gives (AcquiredObject), in full or by its name, is opened - from Shared Storage - or kept. The User Command changes where it is heard from (UserPoV) and its Speech Qualifier or Spatial Attitude (ChangedObjects), and has it translated (TranslatedObjects): the Speech and a Language Selector go to Text and Speech Translation, and the Translation, when it comes back, replaces the original under its identifier - so every Speech Scene holding it holds the translation, at its place. Outputs: the open Speech Object, to the Module and to Speech Scene Editing, and the User Command, with its response (UserCommandRS) saying how each action was executed (for a translation, when it is done)."
   }
  ],
  "https://mpai.community/kg/vocab#ofStandard": [
   {
    "@id": "https://mpai.community/kg/standard/MMC"
   }
  ],
