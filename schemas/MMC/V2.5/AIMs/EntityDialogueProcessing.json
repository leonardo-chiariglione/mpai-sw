    { "Name": "Meaning"              , "Direction": "Input",   "DataType": "MMC-MEA-V2.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "PersonalStatus"       , "Direction": "Input",   "DataType": "MMC-EPS-V2.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "InstanceID"           , "Direction": "Input",   "DataType": "OSD-IID-V1.5",  "Technology": "Software", "Protocol": "", "PortNumber": 1, "IsRemote": false },
    { "Name": "AVSceneGeometry"      , "Direction": "Input",   "DataType": "OSD-MSG-V1.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "SpeakerID"            , "Direction": "Input",   "DataType": "OSD-IID-V1.5",  "Technology": "Software", "Protocol": "", "PortNumber": 2, "IsRemote": false },
    { "Name": "FaceID"               , "Direction": "Input",   "DataType": "OSD-IID-V1.5",  "Technology": "Software", "Protocol": "", "PortNumber": 3, "IsRemote": false },
    { "Name": "MachineTextObject"    , "Direction": "Output",  "DataType": "OSD-TXO-V1.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "MachinePersonalStatus", "Direction": "Output",  "DataType": "MMC-EPS-V2.5",  "Technology": "Software", "Protocol": "", "IsRemote": false },
    { "Name": "EditedSummary"        , "Direction": "Output",  "DataType": "MMC-SUM-V2.5",  "Technology": "Software", "Protocol": "", "IsRemote": false }
  ],

