{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/MMC/V2.5/data/SpeechDescriptors.json",
  "title":                        "Speech Descriptors V2.5",
  "type":                         "object",
  "properties":                   {

    "Header":                     { "type": "string", "const": "MMC-SPD-V2.5" },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "SpeechDescriptorsID":        { "type": "string" },
    "SpeechDescriptorsTime":      { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "SpeechDescriptorsDuration":  { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "SpeechDescriptorsData":      { "type": "object", "properties": {
      "Pitch":                    { "type": "number" },
      "Intensity":                { "type": "number" },
      "Tempo":                    { "type": "number" },

      "PersonalStatus":           { "$ref": "https://schemas.mpai.community/MMC/V2.5/data/PersonalStatus.json" },

      "NNSpeechFeatures":         { "type": "array", "items": { "type": "number" } } } },

    "DataXMData":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":              { "type": "string", "maxLength": 2048 } } }
