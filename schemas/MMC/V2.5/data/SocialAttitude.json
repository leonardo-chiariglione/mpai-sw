            "outgoing/extroverted":                     { "type": "string", "enum": ["uninhibited/unreserved","sociable","approachable"] } } } } },

        "DEPENDENCE":                                   { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": {
