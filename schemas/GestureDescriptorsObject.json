{ "$schema":                        "https://json-schema.org/draft/2020-12/schema",
  "$id":                            "https://schemas.mpai.community/PAF/V1.6/data/GestureDescriptorsObject.json",
  "title":                          "Gesture Descriptors Object V1.6",
  "type":                           "object",
  "additionalProperties":           false,
  "required":                       [ "Header", "GestureDescriptorsObjectID", "GestureDescriptorsData" ],
  "properties":                     {

    "Header":                       { "type": "string", "const": "PAF-GDO-V1.6" },
    "MInstanceID":                  { "type": "string" },
    "UEnvironmentID":               { "type": "string" },
    "GestureDescriptorsID":         { "type": "string" },
    "GestureDescriptorsObjectTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "GestureDescriptorsData":       { "type": "array", "items": { "anyOf": [
                                    { "type": "object", "properties": {
      "DataLength":                 { "type": "integer" },
      "DataURI":                    { "type": "string", "format": "uri" } } },
                                    { "type": "object", "properties": {
      "Data":                       { "type": "string" } } },
                                    { "type": "object", "properties": {
      "DataID":                     { "type": "string" } } } ] } },

    "GestureDescriptorsQualifier":  { "$ref": "https://schemas.mpai.community/TFA/V1.5/data/GestureDescriptorsQualifier.json" },

    "DataXMData":                   { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":                { "type": "string", "maxLength": 2048 } } }
