{ "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "$comment":             "https://schemas.mpai.community/AIF/V3.0/data/AIMMetadata.json",
  "$id":                  "https://schemas.mpai.community/OSD/V1.5/AIMs/3DModelObjectDelivery.json",
  "title":                "3D Model Object Delivery V1.5",

  "Identifier":           {"ImplementerID": "/* String from IIDRA */", "ImplementationID": "/* String from Implementer */", "AIMName": "OSD-3OD-V1.5"},

  "APIProfile":           "Basic",

  "Description":          "3D Model Object Delivery: delivers a 3D Model Object (Basic 3D Model Object or 3D Model Object) to a device - a 3D renderer that displays it. The object stays a 3D Model Object to the device edge, where it is rendered (3D to 2D). Both ports accept OSD-B3O and OSD-3DO.",

  "ExternalPorts":        [{ "Name": "Input3DModel",  "Direction": "Input",  "DataType": ["OSD-B3O-V1.5", "OSD-3DO-V1.5"], "Technology": "Software", "Protocol": "", "IsRemote": false },
                           { "Name": "Output3DModel", "Direction": "Output", "DataType": ["OSD-B3O-V1.5", "OSD-3DO-V1.5"], "Technology": "Hardware", "Protocol": "", "IsRemote": false }],

  "SubAIMs":              [],
  "Topology":             [],

  "Implementations":      [{"ImplementationURI": "/* URI storing Implementation */",
                            "BinaryName":       "/* BinaryName */",
                            "Architecture":     "/* x86 | x86-64 | ARM | ARM64 | MIPS | RISC-V */",
                            "OperatingSystem":  "/* Windows | Linux | MacOS | Debian | Ubuntu | RedHat | Android | Zephyr | RTOS | Oniro | iOS */",
                            "Version":          "/* Version */",
                            "Source":           "/* AIMStorage | MPAIStore | AIMURL */",
                            "Destination":      "/* Destination URI */"}],

  "ResourcePolicies":     [{"Name": "Memory",    "Minimum": "/* GB */", "Maximum": "/* GB */", "Request": "/* GB */"},
                           {"Name": "CPU:Class", "Minimum": "/* Low | Medium | High */", "Maximum": "/* Low | Medium | High */", "Request": "/* Low | Medium | High */"}],

  "DataXMData":           { },
  "Documentation":        [{ "Type": "Tutorial", "URI": "https://mpai.community/standards/mpai-osd/v1-5/" }] }
