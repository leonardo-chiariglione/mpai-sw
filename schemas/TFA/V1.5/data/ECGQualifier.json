{ "$schema":                "https://json-schema.org/draft/2020-12/schema",
  "$id":                    "https://schemas.mpai.community/TFA/V1.5/data/ECGQualifier.json",
  "title":                  "ECG Qualifier V1.5",
  "description":            "Qualifier for ECG content specifying subtype, format, and optional attributes.",
  "type":                   "object",
  "required":               [ "Header", "ECGQualifierID", "SubTypes", "Formats" ],
  "additionalProperties":   false,
  "properties":             {

    "Header":               { "type": "string", "const": "TFA-ECQ-V1.5" },
    "MInstanceID":      { "type": "string" },
    "UEnvironmentID":   { "type": "string" },

    "ECGQualifierID":       { "type": "string", "description": "Unique identifier for this qualifier." },
    "ECGQualifierTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SubTypes":              { "type": "object", "additionalProperties": false, "properties": {

      "LeadConfiguration":  { "type": "string", "enum": [ "12-lead", "3-lead", "5-lead", "Holter", "Telemetry",
                                                          "Ambulatory", "StressTest", "Resting" ] } } },

    "Formats":               { "type": "object", "additionalProperties": false, "properties": {

      "ContentFormat":      { "$ref": "https://schemas.mpai.community/TFA/V1.5/formats/ECGContentFormats.json" } } },

    "Attributes":           { "type": "object", "additionalProperties": false, "properties": {

      "samplingRate":       { "type": "number", "minimum": 1 },
      "leadSet":            { "type": "string" },
      "gain":               { "type": "number", "minimum": 0 },

      "filterBand":         { "type": "object", "required": [ "low", "high" ], "additionalProperties": false, "properties": {
        "low":              { "type": "number", "minimum": 0 },
        "high":             { "type": "number", "minimum": 0 } } } } },

    "Findings":             { "type": "array", "description": "What the data show, each finding coded in a vocabulary of this domain: the labels a Neural Network Model learns from and is checked against. How sure the source of a finding is, and who it is, are in the AIH Data that carries the data.", "items": { "type": "object", "additionalProperties": false, "required": [ "FindingID", "Code", "CodingSystem" ], "properties": {
      "FindingID": { "type": "string" },
      "Code": { "type": "string", "description": "The finding, as the Coding System writes it." },
      "CodingSystem": { "type": "string", "enum": [ "SCP-ECG", "SNOMEDCT", "ICD10", "ICD11", "DatasetLabelSet" ] },
      "LabelSet": { "type": "string", "description": "The name of the label set, when the Coding System is DatasetLabelSet (a data set's own labels, e.g. NIH ChestX-ray14)." },
      "Where": { "type": "object", "additionalProperties": false, "description": "When in the recording (seconds from its start) and in which leads.", "properties": { "Start": { "type": "number", "minimum": 0 }, "End": { "type": "number", "minimum": 0 }, "Leads": { "type": "array", "items": { "type": "string" } } } } } } },

    "DataXMData":           { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":        { "type": "string", "maxLength": 2048 } } }
