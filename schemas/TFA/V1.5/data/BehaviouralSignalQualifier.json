{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/TFA/V1.5/data/BehaviouralSignalQualifier.json",
  "title":                        "Behavioural Signal Qualifier V1.5",
  "type":                         "object",
  "required":                     [ "Header", "BehaviouralSignalQualifierID", "SubTypes", "Formats" ],
  "additionalProperties":         false,
  "properties":                   {

    "Header":                     { "type": "string", "const": "TFA-BSQ-V1.5" },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "BehaviouralSignalQualifierID":   { "type": "string" },
    "BehaviouralSignalQualifierTime": { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SubTypes":                   { "type": "object", "additionalProperties": false, "required": [ "SubType" ], "properties": {
      "SubTypeGroup":             { "type": "string", "description": "The group the Sub-Type belongs to.", "enum": [ "Motor Behaviour", "Gesture Behaviour", "Facial Behaviour", "Interaction Behaviour", "Speech-Related Behaviour" ] },
      "SubType":                  { "type": "string", "description": "The one Sub-Type of the data.", "enum": [ "Gait", "Upper-limb movement", "Whole-body movement", "Fine motor actions", "Hand gestures", "Arm gestures",
                                    "Body gestures", "Facial action units", "Facial expressions", "Eye region movements (non-EOG)",
                                    "Touchscreen interactions", "Keyboard interactions", "Mouse interactions", "Controller interactions",
                                    "Speech activity (voice activity detection)", "Prosodic behaviour (pitch, intensity, rhythm)",
                                    "Articulatory movement traces (non-audio)" ] } } },

    "Formats":                    { "type": "object", "additionalProperties": false, "required": [ "Format" ], "properties": {
      "FormatGroup":              { "type": "string", "description": "The group the Format belongs to.", "enum": [ "Motor Behaviour Formats", "Gesture Behaviour Formats", "Facial Behaviour Formats", "InteractionBehaviourFmts",
                                    "SpeechRelatBehaviourFmts" ] },
      "Format":                   { "type": "string", "description": "The one Format of the data.", "enum": [ "CSV / TSV (motion time-series)", "JSON (motion event stream)", "BVH (Biovision Hierarchy)",
                                    "C3D (3D motion capture format)", "HDF5 (structured motion datasets)", "CSV / TSV", "JSON", "BVH", "C3D", "HDF5",
                                    "CSV / TSV (facial landmark time-series)", "JSON (facial action event stream)", "C3D (3D facial motion capture)",
                                    "BVH (hierarchical facial motion)", "CSV / TSV (interaction logs)", "JSON (event-based interaction logs)",
                                    "XML (interaction trace format)", "CSV / TSV (prosodic features)", "JSON (speech activity events)",
                                    "RTTM (Rich Transcription Time Marked - activity only)", "TextGrid (timing annotations)" ] } } },

    "GroupMap":                   { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
                                    "required": [ "SubTypeGroup", "FormatGroup" ], "properties": {
      "SubTypeGroup":             { "type": "string" },
      "FormatGroup":              { "type": "string" } } },
                                    "default": [
                                  { "SubTypeGroup": "Motor Behaviour",           "FormatGroup": "Motor Behaviour Formats" },
                                  { "SubTypeGroup": "Gesture Behaviour",         "FormatGroup": "Gesture Behaviour Formats" },
                                  { "SubTypeGroup": "Facial Behaviour",          "FormatGroup": "Facial Behaviour Formats" },
                                  { "SubTypeGroup": "Interaction Behaviour",     "FormatGroup": "Interaction Behaviour Formats" },
                                  { "SubTypeGroup": "Speech-Related Behaviour",  "FormatGroup": "Speech-Related Behaviour Formats" } ] },

    "Findings":                   { "type": "array", "description": "What the data show, each finding coded in a vocabulary of this domain: the labels a Neural Network Model learns from and is checked against. How sure the source of a finding is, and who it is, are in the AIH Data that carries the data.", "items": { "type": "object", "additionalProperties": false, "required": [ "FindingID", "Code", "CodingSystem" ], "properties": {
      "FindingID": { "type": "string" },
      "Code": { "type": "string", "description": "The finding, as the Coding System writes it." },
      "CodingSystem": { "type": "string", "enum": [ "SNOMEDCT", "HED", "DatasetLabelSet" ] },
      "LabelSet": { "type": "string", "description": "The name of the label set, when the Coding System is DatasetLabelSet (a data set's own labels, e.g. NIH ChestX-ray14)." },
      "Where": { "type": "object", "additionalProperties": false, "description": "When in the recording (seconds from its start).", "properties": { "Start": { "type": "number", "minimum": 0 }, "End": { "type": "number", "minimum": 0 } } } } } },

    "DataXMData":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":              { "type": "string", "maxLength": 2048 } } }
