{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/TFA/V1.5/data/OmicsQualifier.json",
  "title":                    "Omics Qualifier V1.5",
  "description":              "Omics Sub-Type groups, Format groups, and allowed pairings.",
  "type":                     "object",
  "required":                 [ "Header", "OmicsQualifierID", "SubTypes", "Formats" ],
  "additionalProperties":     false,
  "properties":               {

    "Header":                 { "type": "string", "const": "TFA-OCQ-V1.5" },
    "MInstanceID":            { "type": "string" },
    "UEnvironmentID":         { "type": "string" },
    "OmicsQualifierID":       { "type": "string" },
    "OmicsQualifierTime":     { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SubTypes":               { "type": "object", "additionalProperties": false, "required": [ "SubType" ], "properties": {
      "SubTypeGroup":         { "type": "string", "description": "The group the Sub-Type belongs to.", "enum": [ "DNA-Based Data", "RNA-Based Data", "Epigenomic Data", "Proteomics Data", "Metabolomics Data" ] },
      "SubType":              { "type": "string", "description": "The one Sub-Type of the data.", "enum": [ "Whole-genome variants", "Whole-exome variants", "Targeted panel variants", "Structural variants",
                                "Copy-number profiles", "Gene-expression matrix (bulk RNA-seq)", "Transcript-level quantification",
                                "Splicing / junction counts", "Methylation array profiles", "Bisulfite sequencing profiles",
                                "Protein abundance profiles", "Peptide quantification tables", "Metabolite abundance profiles" ] } } },

    "Formats":                { "type": "object", "additionalProperties": false, "required": [ "Format" ], "properties": {
      "FormatGroup":          { "type": "string", "description": "The group the Format belongs to.", "enum": [ "DNA-Based Formats", "RNA-Based Formats", "Epigenomic Formats", "Proteomics Formats", "Metabolomics Formats" ] },
      "Format":               { "type": "string", "description": "The one Format of the data.", "enum": [ "VCF", "BCF", "FASTQ (raw reads)", "BAM / CRAM (aligned reads)", "TSV/CSV (variant tables)", "BAM / CRAM",
                                "TSV/CSV (gene-expression matrices)", "HDF5 (assay containers)", "IDAT (array raw files)",
                                "TSV/CSV (processed methylation profiles)", "HDF5", "TSV/CSV (protein/peptide quantification)",
                                "TSV/CSV (metabolite abundance)" ] } } },

    "GroupMap":               { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false,
                                "required": [ "SubTypeGroup", "FormatGroup" ], "properties": {
      "SubTypeGroup":         { "type": "string" },
      "FormatGroup":          { "type": "string" } } },
                                "default": [
                              { "SubTypeGroup": "DNA-Based Data",        "FormatGroup": "DNA-Based Formats" },
                              { "SubTypeGroup": "RNA-Based Data",        "FormatGroup": "RNA-Based Formats" },
                              { "SubTypeGroup": "Epigenomic Data",       "FormatGroup": "Epigenomic Formats" },
                              { "SubTypeGroup": "Proteomics Data",       "FormatGroup": "Proteomics Formats" },
                              { "SubTypeGroup": "Metabolomics Data",     "FormatGroup": "Metabolomics Formats" } ] },

    "Findings":       { "type": "array", "description": "What the data show, each finding coded in a vocabulary of this domain: the labels a Neural Network Model learns from and is checked against. How sure the source of a finding is, and who it is, are in the AIH Data that carries the data.", "items": { "type": "object", "additionalProperties": false, "required": [ "FindingID", "Code", "CodingSystem" ], "properties": {
      "FindingID": { "type": "string" },
      "Code": { "type": "string", "description": "The finding, as the Coding System writes it." },
      "CodingSystem": { "type": "string", "enum": [ "HGVS", "HPO", "ClinVar", "SNOMEDCT", "DatasetLabelSet" ] },
      "LabelSet": { "type": "string", "description": "The name of the label set, when the Coding System is DatasetLabelSet (a data set's own labels, e.g. NIH ChestX-ray14)." },
      "Where": { "type": "object", "additionalProperties": false, "description": "Where in the genome or in the assay: the reference assembly, the chromosome and the positions, or the gene, protein or metabolite.", "properties": { "Assembly": { "type": "string" }, "Chromosome": { "type": "string" }, "Start": { "type": "integer", "minimum": 1 }, "End": { "type": "integer", "minimum": 1 }, "Feature": { "type": "string" } } } } } },

    "DataXMData":     { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":  { "type": "string", "maxLength": 2048 } } }
