{ "$id":                  "https://schemas.mpai.community/TFA/V1.5/data/EHRQualifier.json",
  "$schema":              "https://json-schema.org/draft/2020-12/schema",
  "title":                "EHR Qualifier V1.5",
  "description":          "Qualifier for EHR content indicating subtypes, format, and implementation-defined attributes.",
  "type":                 "object",
  "required":             [ "Header", "EHRQualifierID", "SubTypes", "Formats" ],
  "additionalProperties": false,
  "properties":           {

    "Header":             { "type": "string", "const": "TFA-EHQ-V1.5" },
    "MInstanceID":    { "type": "string" },
    "UEnvironmentID": { "type": "string" },

    "EHRQualifierID":     { "type": "string",
                          "description": "Identifier of this EHRQualifier instance (implementation-defined format)." },
    "EHRQualifierTime":   { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "SubTypes":            { "type": "object", "additionalProperties": false, "properties": {
      "Categories":       { "type": "array", "description": "EHR content subtype(s).", "items": { "type": "string" },
                            "minItems": 1, "uniqueItems": true } } },

    "Formats":             { "type": "object", "additionalProperties": false, "properties": {
      "ContentFormat":    { "$ref": "https://schemas.mpai.community/TFA/V1.5/formats/EHRContentFormats.json" } } },

    "Attributes":         { "type": "object", "additionalProperties": true,
                            "description": "Attributes that further qualify the EHR content." },

    "Findings":           { "type": "array", "description": "What the data show, each finding coded in a vocabulary of this domain: the labels a Neural Network Model learns from and is checked against. How sure the source of a finding is, and who it is, are in the AIH Data that carries the data.", "items": { "type": "object", "additionalProperties": false, "required": [ "FindingID", "Code", "CodingSystem" ], "properties": {
      "FindingID": { "type": "string" },
      "Code": { "type": "string", "description": "The finding, as the Coding System writes it." },
      "CodingSystem": { "type": "string", "enum": [ "ICD9", "ICD10", "ICD11", "SNOMEDCT", "LOINC", "ATC", "RxNorm", "LocalEHR", "DatasetLabelSet" ] },
      "LabelSet": { "type": "string", "description": "The name of the label set, when the Coding System is DatasetLabelSet (a data set's own labels, e.g. NIH ChestX-ray14)." },
      "Where": { "type": "object", "additionalProperties": false, "description": "Which entry of the record.", "properties": { "RecordEntry": { "type": "string" } } } } } },

    "DataXMData":         { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":      { "type": "string", "description": "Free-text descriptive metadata.", "maxLength": 2048 } } }
