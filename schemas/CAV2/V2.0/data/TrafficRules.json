{ "$schema":                      "https://json-schema.org/draft/2020-12/schema",
  "$id":                          "https://schemas.mpai.community/CAV2/V2.0/data/TrafficRules.json",
  "title":                        "Traffic Rules V2.0",
  "description":                  "The traffic rules that apply in a U-Environment: the rules of the road of Chapter II of the Convention on Road Traffic (Vienna, 1968), the parameters the Convention leaves to the Contracting Party where the CAV drives, and the road signs and signals (Convention on Road Signs and Signals, Vienna, 1968) with what they require.",
  "type":                         "object",
  "additionalProperties":         false,
  "required":                     [ "Header", "TrafficRulesID", "Sources", "Jurisdiction", "Parameters", "Rules" ],
  "properties":                   {

    "Header":                     { "type": "string", "const": "CAV-TRR-V2.0", "description": "Traffic Rules Header - Standard CAV-TRR-Vx.y." },
    "MInstanceID":                { "type": "string" },
    "UEnvironmentID":             { "type": "string" },
    "TrafficRulesID":             { "type": "string" },
    "TrafficRulesTime":           { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/SimpleTime.json" },

    "Sources":                    { "description": "The instruments the rules and signs are taken from, with the text used and the amendments included or not.",
                                    "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Source" } },

    "Jurisdiction":               { "description": "The Contracting Party (or the generic party of one traffic side) whose rules these are.",
                                    "type": "object", "additionalProperties": false, "required": [ "Code", "Name" ], "properties": {
      "Code":                     { "type": "string", "description": "ISO 3166-1 alpha-2 code, or RHT / LHT for a generic party keeping to the right / left." },
      "Name":                     { "type": "string" },
      "ConventionParty":          { "type": "boolean" },
      "BasedOn":                  { "type": "string", "description": "The Code of the profile this one completes." },
      "DomesticLaw":              { "type": "string" } } },

    "Parameters":                 { "description": "The values the rules use, by name: those the Convention fixes and those it leaves to domestic legislation.",
                                    "type": "object", "additionalProperties": { "$ref": "#/$defs/Parameter" }, "required": [ "TrafficSide", "UnsignedIntersectionPriority" ], "properties": {
      "TrafficSide":              { "$ref": "#/$defs/Parameter", "properties": { "Value": { "enum": [ "Right", "Left" ] } } },
      "UnsignedIntersectionPriority": { "$ref": "#/$defs/Parameter", "properties": { "Value": { "enum": [ "FromRight", "FromLeft", "NoGeneralRule" ] } } } } },

    "Rules":                      { "description": "The rules of the road, one per paragraph (or group of paragraphs) of the Convention.",
                                    "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Rule" } },

    "Signs":                      { "description": "The road signs and signals, and what each requires.",
                                    "type": "array", "items": { "$ref": "#/$defs/Sign" } },

    "DataXMData":                 { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json",
                                    "description": "MPAI-PTF Data Exchange Metadata providing provenance, authorisation, legal, security, and confidence information associated with this Traffic Rules instance in a trusted data exchange context." },
    "DescrMetadata":              { "type": "string", "maxLength": 2048, "description": "Human-readable descriptive metadata of the Traffic Rules instance (plain text, max 2048 characters)." } },

  "$defs":                        {

    "Source":                     { "type": "object", "additionalProperties": false, "required": [ "Instrument", "Text" ], "properties": {
      "Instrument":               { "type": "string" },
      "Done":                     { "type": "string" },
      "Chapter":                  { "type": "string" },
      "Text":                     { "type": "string", "description": "Where the text used comes from." },
      "Categories":               { "type": "object", "additionalProperties": { "type": "string" } },
      "Amendments":               { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": [ "Name", "Included" ], "properties": {
        "Name":                   { "type": "string" },
        "InForce":                { "type": "string", "format": "date" },
        "Text":                   { "type": "string" },
        "Included":               { "type": "boolean" },
        "Note":                   { "type": "string" } } } } } },

    "Parameter":                  { "type": "object", "additionalProperties": false, "required": [ "Value", "Source" ], "properties": {
      "Value":                    { "description": "A number, a word, a boolean, an object of values by class (e.g. speed limits by road class), or null when not set." },
      "Unit":                     { "type": "string" },
      "Source":                   { "enum": [ "Convention", "Domestic", "Unset" ] },
      "Reference":                { "type": "string" },
      "Verified":                 { "type": "boolean", "description": "False: the value was not checked against the text of the law." } } },

    "Rule":                       { "type": "object", "additionalProperties": false, "required": [ "RuleID", "Article", "Title", "Status", "Modality", "AppliesTo", "Behaviour", "Automation", "Text" ], "properties": {
      "RuleID":                   { "type": "string", "pattern": "^VC68-[0-9]+(bis)?(-[0-9a-z]+)?$" },
      "Article":                  { "oneOf": [ { "type": "integer", "minimum": 5, "maximum": 34 }, { "type": "string", "pattern": "^[0-9]+bis$" } ] },
      "Paragraph":                { "type": "string" },
      "Title":                    { "type": "string" },
      "Status":                   { "enum": [ "Binding", "Recommended", "DomesticOption" ], "description": "Binding: 'shall'; Recommended: 'it is recommended that domestic legislation'; DomesticOption: Contracting Parties may." },
      "Modality":                 { "enum": [ "Must", "MustNot", "May" ] },
      "AppliesTo":                { "type": "array", "minItems": 1, "items": { "enum": [ "AllRoadUsers", "Driver", "Vehicle", "HeavyVehicle", "Pedestrian", "Cyclist", "MotorCyclist", "AnimalDriver", "Passenger", "Jurisdiction" ] } },
      "Context":                  { "type": "array", "items": { "type": "string" }, "description": "Where or when the rule applies (Intersection, PedestrianCrossing, Overtaking, Motorway...)." },
      "Behaviour":                { "type": "string", "description": "What the rule asks, as a name the driving software acts on or checks." },
      "Parameters":               { "type": "array", "items": { "type": "string" }, "description": "Names of the Parameters the rule uses." },
      "Automation":               { "enum": [ "Driving", "Vehicle", "Operator", "Expectation" ], "description": "Driving: done by the dynamic control of the vehicle; Vehicle: by its equipment (indicators, lights, doors); Operator: by whoever operates the vehicle; Expectation: a rule of other road users that the CAV may expect them to follow." },
      "Text":                     { "type": "string", "description": "The text of the Convention (or its gist)." },
      "SatisfiedBy":              { "type": "string", "description": "The RuleID of a rule under which this one is deemed satisfied." },
      "Amendment":                { "type": "string" } } },

    "Sign":                       { "type": "object", "additionalProperties": false, "required": [ "SignID", "Name", "Category" ], "properties": {
      "SignID":                   { "type": "string" },
      "Name":                     { "type": "string" },
      "Category":                 { "enum": [ "A", "B", "C", "D", "E", "F", "G", "H", "Lights", "Markings", "Works", "LevelCrossing" ] },
      "Group":                    { "type": "string" },
      "Effect":                   { "type": "object", "additionalProperties": false, "required": [ "Behaviour" ], "properties": {
        "Behaviour":              { "type": "string" },
        "Rule":                   { "type": "string", "description": "The RuleID the sign applies." },
        "Value":                  { "type": [ "number", "string" ] },
        "Unit":                   { "type": "string" },
        "Side":                   { "enum": [ "Left", "Right" ] },
        "AppliesToCategory":      { "type": "string" },
        "Zonal":                  { "type": "boolean" } } } } } } }
