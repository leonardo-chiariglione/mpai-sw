{ "$schema":                  "https://json-schema.org/draft/2020-12/schema",
  "$id":                      "https://schemas.mpai.community/AIH1/V1.1/data/AIHData.json",
  "title":                    "AIH Data V1.1",
  "type":                     "object",
  "additionalProperties":     false,
  "required":                 [ "Header", "UserID", "AIHDataID", "AIHData" ],
  "properties":               {

    "Header":                 { "type": "string", "const": "AIH-AHD-V1.1" },
    "MInstance":              { "type": "string", "description": "Unique identifier for the metaverse instance" },
    "UEnvironment":           { "type": "string", "description": "Unique identifier for the universe environment" },
    "UserID":                 { "type": "string", "description": "Unique identifier of End User" },
    "AIHDataID":              { "type": "string", "description": "Unique identifier of AIHData" },
    "AIHDataTime":            { "$ref": "https://schemas.mpai.community/OSD/V1.5/data/Time.json" },

    "AIHData":                { "type": "object", "additionalProperties": false, "required": [ "HealthData", "ModelLicence" ], "properties": {
        "HealthData":         { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/HealthData.json" },
        "FindingTrust":       { "type": "array", "description": "For each Finding of the Qualifier of the Health Data, who set it and how sure that source is.", "items": {
                                "type": "object", "additionalProperties": false, "required": [ "FindingID", "Source", "Confidence" ], "properties": {
          "FindingID":        { "type": "string", "description": "The FindingID of the Finding in the Qualifier of the Health Data." },
          "Source":           { "type": "string", "enum": [ "Clinician", "Report", "Model", "Patient", "Device", "Other" ],
                                "description": "Who set the Finding: a clinician reading the data; extracted from a report; a Neural Network Model; the patient; the device that acquired the data." },
          "SourceID":         { "type": "string", "description": "Which clinician, report, model or device, where it can be said." },
          "Confidence":       { "type": "number", "minimum": 0, "maximum": 1, "description": "How sure the Source is that the Finding is present, from 0 to 1." } } } },
        "ModelLicence":       { "oneOf": [
                              { "type": "string" },
                              { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/ModelLicence.json" } ] },
        "SmartContractID":    { "type": "string" },
        "ARAData":            { "$ref": "https://schemas.mpai.community/AIH1/V1.1/data/ARAData.json" },
        "DeIDAndAnonym":      { "type": "string", "enum": [ "De-Identified", "Anonymised", "De-Identified and Anonymised" ] },
        "ParentAIHDataID":    { "type": "string" } } },

    "DataXMData":             { "$ref": "https://schemas.mpai.community/PTF/V1.0/data/DataExchangeMetadata.json" },
    "DescrMetadata":          { "type": "string", "maxLength": 2048 } } }
